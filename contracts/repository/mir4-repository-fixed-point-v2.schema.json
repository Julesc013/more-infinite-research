{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "programme_id", "state", "unknown_policy", "physical_cutover", "current_package_source_remains_authoritative", "migration_authority", "migration_sequence", "root_markers", "classification_order", "visible_roots", "external_roots", "move_gate", "remaining_move"],
  "properties": {
    "schema": {"const": 2},
    "kind": {"const": "MIR4RepositoryFixedPointV2"},
    "programme_id": {"type": "string", "minLength": 1},
    "state": {"const": "MIR42-COMPOSABLE-SOURCE-LAYOUT"},
    "unknown_policy": {"const": "block-deletion-and-release"},
    "physical_cutover": {"const": true},
    "current_package_source_remains_authoritative": {"const": false},
    "migration_authority": {"type": "string", "minLength": 1},
    "migration_sequence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["migration_id", "authority", "receipt", "state"], "properties": {"migration_id": {"type": "string", "minLength": 1}, "authority": {"type": "string", "minLength": 1}, "receipt": {"type": "string", "minLength": 1}, "state": {"type": "string", "minLength": 1}}}},
    "root_markers": {"type": "string", "minLength": 1},
    "classification_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "visible_roots": {"type": "array", "minItems": 1},
    "external_roots": {"type": "array"},
    "move_gate": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "remaining_move": {"type": "object", "additionalProperties": false, "required": ["classification", "reason", "rollback"], "properties": {"classification": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "rollback": {"type": "string", "minLength": 1}}}
  }
}
