{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.more-infinite-research.invalid/repository/mir4-m41-current-product-bridge-retirement-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "recorded_at", "status", "predecessor", "authority", "fixed_point", "package_source", "execution_context", "characterization", "evolved_bindings", "current_authorities", "proofs", "package_visible_delta", "transition_gate", "record_sha256"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4M41CurrentProductBridgeRetirementReceiptV1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {"const": "M41-CURRENT-PRODUCT-BRIDGES-RETIRED-PRIVATE-QUALIFICATION-PENDING"},
    "predecessor": {"$ref": "#/$defs/binding"},
    "authority": {"$ref": "#/$defs/binding"},
    "fixed_point": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "state", "physical_cutover", "legacy_root_current_authority"],
      "properties": {"path": {"const": ".mir/control/repository-fixed-point.json"}, "sha256": {"$ref": "#/$defs/sha256"}, "state": {"const": "MIR41-CURRENT-PRODUCT-BRIDGES-RETIRED"}, "physical_cutover": {"const": true}, "legacy_root_current_authority": {"const": false}}
    },
    "package_source": {
      "type": "object", "additionalProperties": false,
      "required": ["predecessor_sha256", "current_sha256", "authority_record_sha256", "writer", "legacy_root_state", "silent_fallback_blocked"],
      "properties": {"predecessor_sha256": {"$ref": "#/$defs/sha256"}, "current_sha256": {"$ref": "#/$defs/sha256"}, "authority_record_sha256": {"$ref": "#/$defs/sha256"}, "writer": {"const": "tools/mir/application/package/TargetMaterializer.ps1"}, "legacy_root_state": {"const": "retired-historical-read-only"}, "silent_fallback_blocked": {"const": true}}
    },
    "execution_context": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "record_sha256", "historical_m4c01_current_authority", "release_authority"],
      "properties": {"path": {"const": "spec/execution/mir4-4.1-development-context-v1.json"}, "record_sha256": {"$ref": "#/$defs/sha256"}, "historical_m4c01_current_authority": {"const": false}, "release_authority": {"const": false}}
    },
    "characterization": {
      "type": "object", "additionalProperties": false,
      "required": ["bridge_expiry_sha256", "declared", "retired", "retained_historical", "required_zero"],
      "properties": {"bridge_expiry_sha256": {"$ref": "#/$defs/sha256"}, "declared": {"const": 49}, "retired": {"const": 1}, "retained_historical": {"const": 48}, "required_zero": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true}}
    },
    "evolved_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evolvedBinding"}},
    "current_authorities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/currentAuthority"}},
    "proofs": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "package_visible_delta": {"type": "array", "maxItems": 0},
    "transition_gate": {"type": "object", "additionalProperties": false, "required": ["bridge_retirement", "private_qualification", "version_allocation", "tagging", "signing", "sealing", "publication"], "properties": {"bridge_retirement": {"const": true}, "private_qualification": {"const": false}, "version_allocation": {"const": false}, "tagging": {"const": false}, "signing": {"const": false}, "sealing": {"const": false}, "publication": {"const": false}}},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "record_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "record_sha256": {"$ref": "#/$defs/sha256"}}},
    "evolvedBinding": {"type": "object", "additionalProperties": false, "required": ["path", "previous_sha256", "current_sha256", "hash_mode", "scope", "package_visible", "release_authority"], "properties": {"path": {"type": "string", "minLength": 1}, "previous_sha256": {"$ref": "#/$defs/sha256"}, "current_sha256": {"$ref": "#/$defs/sha256"}, "hash_mode": {"const": "canonical-text-v1"}, "scope": {"const": "current-product-bridge-retirement"}, "package_visible": {"const": false}, "release_authority": {"const": false}}},
    "currentAuthority": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "hash_mode", "role"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "hash_mode": {"const": "canonical-text-v1"}, "role": {"type": "string", "minLength": 8}}}
  }
}
