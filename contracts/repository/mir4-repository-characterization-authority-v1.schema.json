{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.invalid/contracts/repository/mir4-repository-characterization-authority-v1.schema.json",
  "type": "object",
  "required": ["schema","kind","migration_id","state","fixed_point_authority","scope","writers","path_map","compatibility_entrypoints","report_files","rollback","sunset","package_source_authority_unchanged","package_source_sha256","root_readme_sha256","release_transition_authority"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4RepositoryCharacterizationAuthorityV1"},
    "migration_id": {"const": "M41-05A-M42-00A-REPOSITORY-CHARACTERIZATION-V1"},
    "state": {"type":"string","minLength":1},
    "fixed_point_authority": {"const":".mir/control/repository-fixed-point.json"},
    "scope": {"type":"string","minLength":1},
    "writers": {"type":"array","minItems":1,"maxItems":1,"items":{"type":"object","required":["fact_family","path","command"]}},
    "path_map": {"type":"array","minItems":1,"items":{"type":"object","required":["family","current_path","final_path","state","package_visible"]}},
    "compatibility_entrypoints": {"type":"array","items":{"type":"object","required":["path","role","writable"]}},
    "report_files": {"type":"array","minItems":8,"uniqueItems":true,"items":{"type":"string"}},
    "rollback": {"type":"object","required":["mode","command","preserves"]},
    "sunset": {"type":"object","required":["state","required_gates"]},
    "package_source_authority_unchanged": {"const":true},
    "package_source_sha256": {"type":"string","pattern":"^[A-F0-9]{64}$"},
    "root_readme_sha256": {"type":"string","pattern":"^[A-F0-9]{64}$"},
    "release_transition_authority": {"type":"object","additionalProperties":{"const":false}}
  },
  "additionalProperties": false
}
