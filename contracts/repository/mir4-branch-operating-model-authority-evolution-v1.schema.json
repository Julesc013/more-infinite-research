  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4BranchOperatingModelAuthorityEvolutionV1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "programme_id": {"const": "M41-06-BRANCH-OPERATING-MODEL"},
    "change_id": {"const": "MIR4-BRANCH-OPERATING-MODEL-2026-08-31"},
    "predecessor_receipt": {
      "type": "object",
