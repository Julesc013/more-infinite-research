{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.more-infinite-research.invalid/repository/mir4-branch-operating-model-authority-evolution-v1.schema.json",
  "title": "MIR4BranchOperatingModelAuthorityEvolutionV1",
  "type": "object",
