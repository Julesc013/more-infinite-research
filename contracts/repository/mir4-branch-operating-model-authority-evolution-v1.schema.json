    "remote_ruleset_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "hash_mode", "captured_at", "authoritative_for_remote_current_state"],
      "properties": {
        "path": {"const": "releases/governance/mir4-ruleset-snapshot-2026-08-31.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "hash_mode": {"const": "canonical-text-v1"},
        "captured_at": {"const": "2026-08-31T20:17:00+10:00"},
        "authoritative_for_remote_current_state": {"const": false}
      }
    },
    "player_package_source_sha256": {"const": "8D59F97AC6A42917A22E160E492ED94854D3D377C57D22C3FE27AE6A9C77A336"},
    "package_visible_delta": {"const": []},
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_latest_stable", "dev_next_release_integration", "release_4_0_maintenance", "pull_requests_required", "linear_history_required", "ordinary_bypass_actor_count", "package_source_unchanged", "gameplay_difference_authorized"],
      "properties": {
        "main_latest_stable": {"const": true},
        "dev_next_release_integration": {"const": true},
        "release_4_0_maintenance": {"const": true},
        "pull_requests_required": {"const": true},
        "linear_history_required": {"const": true},
        "ordinary_bypass_actor_count": {"const": 0},
        "package_source_unchanged": {"const": true},
        "gameplay_difference_authorized": {"const": false}
      }
    },
    "transition_gate": {"$ref": "#/$defs/falseTransitions"},
    "status": {"const": "BRANCH-OPERATING-MODEL-APPLIED-NO-RELEASE-TRANSITION"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "evolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "previous_sha256", "current_sha256", "reason", "scope", "package_visible", "release_authority"],
      "properties": {
        "path": {"enum": ["AGENTS.md", "CONTRIBUTING.md", "docs/maintainer/mir4-release-operations.md"]},
        "previous_sha256": {"$ref": "#/$defs/sha256"},
        "current_sha256": {"$ref": "#/$defs/sha256"},
