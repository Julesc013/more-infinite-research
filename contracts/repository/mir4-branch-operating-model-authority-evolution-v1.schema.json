      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "releases/migrations/MIR4-Post-Release-Automation-Authority-CutoverV1.json"},
        "sha256": {"const": "40B660FED308DB5A947D4CCF126AC3A4A2B32A8F0182CEF52003A6950F911C3F"}
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "tree"],
      "properties": {
        "branch": {"const": "main"},
        "commit": {"const": "831daa2552f7f3c4820f7fcad24653da15995b7b"},
        "tree": {"const": "250c9846299782a711862895fe97803bcfb5b816"}
      }
    },
    "evolved_bindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
