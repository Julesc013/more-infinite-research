{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "migration_id", "state", "scope", "predecessor", "writers", "required_invariants", "rollback", "transition_gate"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4ComposableSourceLayoutAuthorityV1"},
    "migration_id": {"const": "MIR4-COMPOSABLE-SOURCE-LAYOUT-V1"},
    "state": {"const": "authorized-development-migration"},
    "scope": {"type": "string", "minLength": 1},
    "predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "commit", "package_source_fingerprint_sha256", "manifest", "manifest_record_sha256"],
      "properties": {
        "branch": {"const": "dev"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_source_fingerprint_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "manifest": {"const": "src/mod/package-source.json"},
        "manifest_record_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "writers": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["fact_family", "path"], "properties": {"fact_family": {"const": "composable-source-layout"}, "path": {"const": "tools/commands/mir4/Update-MIR4ComposableSourceLayoutAuthority.ps1"}}}
    },
    "required_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "string", "minLength": 1},
    "transition_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["development_merge", "main_promotion", "version_allocation", "tagging", "signing", "sealing", "publication"],
      "properties": {"development_merge": {"const": true}, "main_promotion": {"const": false}, "version_allocation": {"const": false}, "tagging": {"const": false}, "signing": {"const": false}, "sealing": {"const": false}, "publication": {"const": false}}
    }
  }
}
