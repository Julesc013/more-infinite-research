{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.more-infinite-research.invalid/repository/mir4-factorio-one-source-convergence-authority-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "migration_id", "state", "predecessor", "proof", "required_invariants", "rollback", "transition_gate"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4FactorioOneSourceConvergenceAuthorityV1"},
    "migration_id": {"const": "MIR4-FACTORIO-ONE-SOURCE-CONVERGENCE-V1"},
    "state": {"const": "authorized-development-source-convergence"},
    "predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["layout_receipt", "source_layout_migration_id"],
      "properties": {
        "layout_receipt": {"const": "assurance/repository/composable-source-layout-receipt-v1.json"},
        "source_layout_migration_id": {"const": "MIR4-COMPOSABLE-SOURCE-LAYOUT-V1"}
      }
    },
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "schema", "test", "baseline_revision"],
      "properties": {
        "implementation": {"const": "tools/mir/application/package/FactorioOneSourceConvergence.ps1"},
        "schema": {"const": "spec/schemas/mir4-factorio-one-source-convergence-proof-v1.schema.json"},
        "test": {"const": "tests/mir4/Test-MIR4FactorioOneSourceConvergenceM4202.ps1"},
        "baseline_revision": {"const": "297aa5cc902da96847165a4f9caa1048608839fb"}
      }
    },
    "required_invariants": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rollback": {"type": "string", "minLength": 1},
    "transition_gate": {"$ref": "#/$defs/gates"}
  },
  "$defs": {
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["development_merge", "private_build", "qualification", "technical_seal", "main_promotion", "version_allocation", "tagging", "signing", "sealing", "publication"],
      "properties": {
        "development_merge": {"const": true}, "private_build": {"const": false}, "qualification": {"const": false}, "technical_seal": {"const": false}, "main_promotion": {"const": false}, "version_allocation": {"const": false}, "tagging": {"const": false}, "signing": {"const": false}, "sealing": {"const": false}, "publication": {"const": false}
      }
    }
  }
}
