{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MIR4 test proof catalogue v1",
  "type": "object",
  "required": ["schema", "kind", "state", "registry", "executable_authority_root", "compatibility_root", "test_count", "tests", "summary", "transition_gate", "digest"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4TestProofCatalogueV1"},
    "state": {"const": "M42-01-CANONICAL"},
    "executable_authority_root": {"const": "tests"},
    "compatibility_root": {"const": "validation/tests"},
    "test_count": {"type": "integer", "minimum": 1},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "proposition", "cohort", "command", "canonical_implementation", "target_scope", "freshness", "evaluator_abi", "result_schema", "exit_behavior", "requires_factorio", "inputs"]}},
    "summary": {"type": "object", "required": ["cohorts", "compatibility_selected", "duplicate_test_ids"]},
    "transition_gate": {"type": "object", "required": ["version_allocation", "tagging", "signing", "sealing", "publication"]},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
