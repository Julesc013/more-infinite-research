{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.more-infinite-research.invalid/release/mir4-release-narrative-result-v1.schema.json",
  "title": "MIR4ReleaseNarrativeResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "plan_id", "renderer_abi", "plan", "accepted_changes", "outputs", "checks", "package_source_sha256", "package_visible_delta", "transition_gate", "result_digest"],
  "properties": {
    "schema": {"const": 1}, "kind": {"const": "MIR4ReleaseNarrativeResultV1"},
    "plan_id": {"type": "string"}, "renderer_abi": {"const": "mir4-release-narratives/1"},
    "plan": {"$ref": "#/$defs/input"},
    "accepted_changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "outputs": {"type": "array", "minItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["surface", "target", "path", "sha256", "bytes"], "properties": {
      "surface": {"enum": ["source-changelog", "factorio-changelog", "github-release", "mod-portal", "technical-release", "manifest-change-inventory"]},
      "target": {"type": ["string", "null"], "enum": [null, "F210", "F200", "F110", "F100"]},
      "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*\\\\).+$"},
      "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}
    }}},
    "checks": {"type": "object", "additionalProperties": false, "required": ["authority", "determinism", "target_filtering", "public_copy", "factorio_format", "package_non_interference", "unknown_dispositions"], "properties": {
      "authority": {"const": "passed"}, "determinism": {"const": "passed"}, "target_filtering": {"const": "passed"}, "public_copy": {"const": "passed"}, "factorio_format": {"const": "passed"}, "package_non_interference": {"const": "passed"}, "unknown_dispositions": {"const": 0}
    }},
    "package_source_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "package_visible_delta": {"const": []},
    "transition_gate": {"type": "object", "additionalProperties": false, "required": ["merge", "tagging", "signing", "sealing", "version_allocation", "publication"], "properties": {"merge": {"const": false}, "tagging": {"const": false}, "signing": {"const": false}, "sealing": {"const": false}, "version_allocation": {"const": false}, "publication": {"const": false}}},
    "result_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {"input": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}}
}
