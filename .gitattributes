# Post-terminal closure records bind the historical emergency JSON checkout
# bytes. Preserve their sealed CRLF identities while keeping the 2.5.10
# release record and continuation generator canonical LF on every runner.
.mir/releases/emergency/*.json text eol=crlf
.mir/releases/records/2.5.10.json text eol=lf
tools/commands/release/New-MIR3Factorio20PostTerminalHotfixBaselineContinuation.ps1 text eol=lf

# The experimental MIR 4 SDK compares generated bytes exactly. Keep its
# generated reference, schemas, and language bindings invariant under the
# maintainer's core.autocrlf setting.
docs/reference/generated/mir4-experimental-api-v0.md text eol=lf
spec/schemas/experimental/*.json text eol=lf
sdk/experimental/mir4/json-schema/*.json text eol=lf
sdk/experimental/mir4/lua/*.lua text eol=lf
sdk/experimental/mir4/powershell/*.psm1 text eol=lf
