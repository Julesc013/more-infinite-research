  "decision_dispositions": {
    "accepted_for_bootstrap_implementation": [
      {
        "id": "MIR4-FPR-BOOTSTRAP-FIXED-POINT",
        "decision": "MIR 4.0 establishes the permanent product-line seams and succession fixed point rather than claiming the complete future platform.",
        "source_names": ["MIR4_4.0.0_RELEASE_CONTRACT_FINAL.json", "MIR4_ULTIMATE_FINAL_MASTER_SPEC_2026-08-16.md"],
        "disposition": "accepted-bootstrap-implementation"
      },
      {
        "id": "MIR4-FPR-TARGET-SET",
        "decision": "Factorio 2.1 and 2.0 are mandatory bootstrap targets; Factorio 1.1 and 1.0 are conditional same-source targets that cannot weaken or delay the mandatory pair.",
        "source_names": ["MIR4_4.0.0_RELEASE_CONTRACT_FINAL.json", "MIR4_4.0_ACCEPTANCE_MATRIX_FINAL.json"],
        "disposition": "accepted-bootstrap-implementation"
      },
      {
        "id": "MIR4-FPR-DIRECT-TARGET-CODES",
        "decision": "Distribution identities use the direct Factorio-line target codes 210, 200, 110, and 100; provisional R0 portal identifiers remain historical evidence only.",
        "source_names": ["MIR4_SOURCE_RECONCILIATION_FINAL.md", "MIR4_ULTIMATE_FINAL_MASTER_SPEC_2026-08-16.md"],
        "disposition": "accepted-bootstrap-implementation"
      },
      {
        "id": "MIR4-FPR-ONE-SOURCE",
        "decision": "One canonical semantic and package-source authority materializes independently qualified target packages without manual target backports.",
        "source_names": ["MIR4_CONSTITUTION_FINAL.md", "MIR4_REPOSITORY_ARCHITECTURE_FINAL.md", "MIR4_4.0.0_RELEASE_CONTRACT_FINAL.json"],
        "disposition": "accepted-bootstrap-implementation"
      },
      {
        "id": "MIR4-FPR-MIR3-SUCCESSION",
        "decision": "The bootstrap evolves the mature terminal MIR 3 compiler authorities behind a bounded private adapter rather than replacing them in a clean-room rewrite.",
        "source_names": ["MIR4_REPOSITORY_ARCHITECTURE_FINAL.md", "M4-003_OFFLINE_EMERGENCY_LANE_FINAL_SPEC.md"],
        "disposition": "accepted-bootstrap-implementation"
      },
      {
        "id": "MIR4-FPR-REPOSITORY-TIMING",
        "decision": "The modular-monolith destination and transition graph are frozen now; general physical owner-by-owner repository migration follows the 4.0 bootstrap unless required for proof.",
        "source_names": ["MIR4_REPOSITORY_ARCHITECTURE_FINAL.md", "MIR4_4.0.0_RELEASE_CONTRACT_FINAL.json"],
        "disposition": "accepted-bootstrap-implementation"
      },
      {
        "id": "MIR4-FPR-CALENDAR-NOT-VERSION",
        "decision": "Calendar train identifiers organize work but never preallocate source versions or manufacture no-op releases.",
        "source_names": ["MIR4_AGENTIC_EXECUTION_PLAN_2026-08-16_TO_2026-08-22_FINAL.json", "MIR4_ULTIMATE_FINAL_MASTER_SPEC_2026-08-16.md"],
