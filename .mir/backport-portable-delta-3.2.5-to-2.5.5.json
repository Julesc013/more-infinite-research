  },
  "target": {
    "version": "2.5.5",
    "candidate_id": "2.5-P12",
    "factorio": "2.0",
    "predecessor": "2.5.0",
    "package_source_commit": "689940f436b004cf4e5981f1944ddb04eaa17367",
