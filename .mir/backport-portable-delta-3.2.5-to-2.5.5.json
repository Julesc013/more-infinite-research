  },
  "rules": {
    "wholesale_merge_forbidden": true,
    "target_specific_evidence_required": true,
    "factorio_2_1_runtime_evidence_reusable": false,
    "unclassified_path_forbidden": true,
    "unclassified_semantic_forbidden": true
  },
  "changes": [
    {
      "id": "unified-research-cost-model",
      "disposition": "shared-with-target-adapter",
      "path_patterns": [
        "prototypes/mir/domain/research_cost/*.lua",
        "prototypes/mir/domain/native_owner/cost_model.lua",
        "prototypes/mir/planner/base_continuations.lua",
        "prototypes/mir/planner/costs.lua",
        "prototypes/mir/settings/*.lua",
        "prototypes/streams/productivity.lua"
      ],
      "claim": "Fixed, linear, exponential and hybrid costs use the C32 model with Factorio 2.0 realization."
    },
    {
      "id": "bounded-support-log-adapter",
      "disposition": "shared-with-target-adapter",
      "path_patterns": [
        "prototypes/mir/domain/compiler/public_artifact_budget.lua",
        "prototypes/mir/emit/research_cost_compatibility_adapter.lua",
        "prototypes/mir/pipeline/compiler_orchestrator.lua",
        "prototypes/mir/report/public_compiler_artifacts.lua"
      ],
      "claim": "The bounded privacy-safe research-cost support proposition is emitted to the Factorio log."
    },
    {
      "id": "unsupported-mod-data-output",
      "disposition": "compiled-out",
      "path_patterns": ["prototypes/mir/emit/mod_data.lua"],
      "claim": "MIR emits no mod-data prototype on the 2.0 target."
    },
    {
      "id": "productivity-family-adoption",
      "disposition": "compiled-out",
      "path_patterns": [
        "prototypes/mir/emit/transactions/productivity_family_adoption.lua",
        "prototypes/mir/planner/native_owner_binding.lua",
        "prototypes/mir/planner/stream_compiler.lua",
        "prototypes/mir/runtime/productivity_family_adoption.lua"
      ],
      "claim": "Modern native-owner adoption is omitted; existing Factorio 2.0 owners are preserved."
    },
    {
      "id": "factorio-2.0-target-profile",
      "disposition": "target-native-equivalent",
      "path_patterns": [
        ".mir/targets.json",
        "prototypes/mir/platform/factorio/target_profiles.lua"
      ],
      "claim": "One generated profile selects Factorio 2.0 prototype shapes and supported emitters."
    },
    {
      "id": "localized-cost-surface",
      "disposition": "shared-unchanged",
      "path_patterns": ["locale/*/more-infinite-research.cfg"],
      "claim": "The C32 cost-setting locale surface is retained on every shipped locale."
    },
    {
      "id": "target-release-surface",
      "disposition": "shared-with-target-adapter",
      "path_patterns": ["README.md", "changelog.txt", "info.json"],
      "claim": "Version, dependency floor, release notes and target limitations identify MIR 2.5.5 for Factorio 2.0."
    }
  ],
  "omissions": [
    "space-age-only-features",
    "mir-mod-data-output",
    "modern-productivity-family-adoption",
    "factorio-2.1-only-effects",
    "factorio-2.1-runtime-evidence"
  ]
