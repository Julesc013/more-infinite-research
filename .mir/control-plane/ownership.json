{
  "schema": 1,
  "authority": "mir-control-plane-v5-ownership",
  "unknown_policy": "select-all-and-fail-governance",
  "owners": [
    {"pattern": "docs/**", "module": "documentation", "writes": ["docs.source"]},
    {"pattern": "todo.md", "module": "control-plane-views", "writes": ["docs.generated"]},
    {"pattern": ".mir/docs.yml", "module": "documentation-governance", "writes": ["docs.source"]},
    {"pattern": ".mir/modules.yml", "module": "architecture-governance", "writes": ["architecture.boundaries"]},
    {"pattern": ".mir/compiler-schema-authority.json", "module": "compiler-schema-governance", "writes": ["compiler.contract", "architecture.boundaries"]},
    {"pattern": ".mir/targets.json", "module": "target-profile-governance", "writes": ["architecture.boundaries", "product.compiler", "scenario.catalog"]},
    {"pattern": ".mir/streams.yml", "module": "stream-governance", "writes": ["product.compiler", "product.settings", "scenario.catalog"]},
    {"pattern": ".mir/settings.yml", "module": "settings-governance", "writes": ["product.settings", "product.balance"]},
    {"pattern": ".mir/native-owner-cost-models.json", "module": "native-owner-balance-governance", "writes": ["product.balance", "product.settings"]},
    {"pattern": ".mir/compatibility.yml", "module": "compatibility-governance", "writes": ["product.compiler", "scenario.catalog"]},
    {"pattern": ".mir/fixtures.yml", "module": "fixture-governance", "writes": ["scenario.catalog"]},
    {"pattern": ".mir/convergence.yml", "module": "release-authority", "writes": ["release.authority", "release.presentation"]},
    {"pattern": ".mir/locales/**", "module": "locale-governance", "writes": ["product.locale"]},
    {"pattern": ".mir/module-dependencies.json", "module": "architecture-governance", "writes": ["architecture.boundaries"]},
    {"pattern": ".mir/releases/**", "module": "release-authority", "writes": ["release.authority"]},
    {"pattern": ".mir/candidate-closures/**", "module": "release-authority", "writes": ["release.authority"]},
    {"pattern": ".mir/release-transitions/**", "module": "release-authority", "writes": ["release.authority"]},
    {"pattern": ".mir/backports/**", "module": "backport-authority", "writes": ["release.authority", "transition.upgrade"]},
    {"pattern": ".mir/backport-*.json", "module": "backport-authority", "writes": ["release.authority", "transition.upgrade"]},
    {"pattern": ".mir/evidence/**", "module": "governed-evidence", "writes": ["assurance.evidence"]},
    {"pattern": ".mir/generated/**", "module": "control-plane-views", "writes": ["release.presentation"]},
    {"pattern": ".mir/changes/**", "module": "control-plane-records", "writes": ["assurance.control-plane"]},
    {"pattern": ".mir/incidents/**", "module": "control-plane-records", "writes": ["assurance.control-plane"]},
    {"pattern": ".mir/tasks/**", "module": "control-plane-records", "writes": ["assurance.catalog"]},
    {"pattern": ".mir/control-plane/**", "module": "control-plane-kernel", "writes": ["assurance.control-plane"]},
    {"pattern": ".mir/performance-campaigns/**", "module": "control-plane-kernel", "writes": ["assurance.control-plane", "performance.gameplay"]},
    {"pattern": "scripts/MIRControlPlane/**", "module": "control-plane-kernel", "writes": ["assurance.control-plane"]},
    {"pattern": "scripts/Invoke-MIRControlPlane.ps1", "module": "control-plane-facade", "writes": ["assurance.control-plane"]},
    {"pattern": "scripts/Invoke-MIRControlPlaneWork.ps1", "module": "control-plane-work-facade", "writes": ["assurance.control-plane"]},
    {"pattern": "scripts/New-MIRVerificationContext.ps1", "module": "verification-context-facade", "writes": ["assurance.control-plane"]},
    {"pattern": "scripts/Test-MIRControlPlane.ps1", "module": "control-plane-tests", "writes": ["assurance.static"]},
    {"pattern": "verification/schema/**", "module": "assurance-schemas", "writes": ["assurance.schemas", "assurance.control-plane"]},
    {"pattern": "validation/tests.yml", "module": "test-catalog", "writes": ["assurance.catalog"]},
    {"pattern": "validation/domains.yml", "module": "test-catalog", "writes": ["assurance.catalog"]},
    {"pattern": "validation/trust.json", "module": "assurance-trust-policy", "writes": ["assurance.control-plane", "ci.workflow"]},
    {"pattern": "validation/generated/**", "module": "scenario-composition", "writes": ["scenario.catalog"]},
    {"pattern": "fixtures/**", "module": "fixtures", "writes": ["scenario.catalog"]},
    {"pattern": "scripts/Invoke-MIRAssurance.ps1", "module": "assurance-harness", "writes": ["assurance.harness", "product.balance"]},
    {"pattern": "scripts/validation/**", "module": "validation-harness", "writes": ["assurance.harness"]},
    {"pattern": "scripts/Invoke-MIRCompatAudit.ps1", "module": "validation-harness", "writes": ["assurance.harness"]},
    {"pattern": "scripts/Invoke-MIRValidation.ps1", "module": "validation-harness", "writes": ["assurance.harness"]},
    {"pattern": "scripts/New-MIRFactorioLineTestAdapter.ps1", "module": "validation-harness", "writes": ["assurance.harness", "scenario.catalog"]},
    {"pattern": "scripts/Materialize-MIRBackport.ps1", "module": "backport-materializer", "writes": ["assurance.harness", "product.package", "transition.upgrade"]},
    {"pattern": "scripts/Test-MIR*.ps1", "module": "static-tests", "writes": ["assurance.static"]},
    {"pattern": "scripts/Update-MIR*.ps1", "module": "generated-authority-tools", "writes": ["assurance.static", "docs.generated"]},
    {"pattern": ".github/workflows/**", "module": "ci", "writes": ["ci.workflow"]},
    {"pattern": "prototypes/**", "module": "compiler", "writes": ["product.compiler", "architecture.boundaries"]},
    {"pattern": "data*.lua", "module": "compiler-entrypoints", "writes": ["product.compiler"]},
    {"pattern": "control.lua", "module": "runtime", "writes": ["product.runtime"]},
    {"pattern": "migrations/**", "module": "runtime-migrations", "writes": ["product.runtime"]},
    {"pattern": "settings*.lua", "module": "settings", "writes": ["product.settings"]},
    {"pattern": "locale/**", "module": "locale", "writes": ["product.locale"]},
    {"pattern": "info.json", "module": "metadata", "writes": ["product.metadata"]},
    {"pattern": "README.md", "module": "package-text", "writes": ["docs.source", "product.package"]},
    {"pattern": "changelog.txt", "module": "package-text", "writes": ["product.package"]},
    {"pattern": "LICENSE", "module": "package-text", "writes": ["product.package"]},
    {"pattern": "thumbnail.png", "module": "package-assets", "writes": ["product.package"]},
    {"pattern": "dist/*.zip", "module": "release-archives", "writes": ["product.package", "release.authority"]},
    {"pattern": ".mir/branches.yml", "module": "branch-policy", "writes": ["release.authority"]},
    {"pattern": ".mir/release-wave.yml", "module": "release-wave", "writes": ["release.presentation"]},
    {"pattern": ".mir/releases.json", "module": "legacy-release-view", "writes": ["release.presentation"]},
    {"pattern": ".mir/distributions.json", "module": "distribution-view", "writes": ["release.presentation"]}
  ]
}
