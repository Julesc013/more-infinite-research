{
  "schema": 1,
  "default_target": "2.1",
  "verification": {
    "tests": "validation/tests.yml",
    "domains": "validation/domains.yml",
    "profiles": "validation/profiles",
    "trust": "validation/trust.json",
    "plan": "build/results/assurance/verification-plan.json",
    "evidence": "build/results/assurance/evidence",
    "aggregate_gate": "MIR / verification-gate"
  },
  "worker_import": {
    "max_artifacts": 512,
    "max_entries_per_artifact": 10000,
    "max_expanded_bytes_per_artifact": 1073741824,
    "max_file_bytes": 536870912
  },
  "profiles": {
    "edit": ["static.architecture", "static.compiler"],
    "fast": ["tooling.self-test", "static.architecture", "static.compiler", "static.settings", "static.balance", "static.museum", "static.release-history", "static.package"],
    "auto": [],
    "locale": ["static.locales", "runtime.exact-zip"],
    "balance": ["static.balance", "runtime.affected"],
    "museum-exact": ["static.museum", "runtime.museum-exact"],
    "mir4-bootstrap": ["static.mir4-r0-identity", "static.mir4-r0-bootstrap", "static.mir4-public-feedback-intake", "static.mir4-maximum-level-sol03", "static.mir4-production-route-sol04", "static.mir4-research-cost-v2-sol05", "static.mir4-k2-science-sol06", "static.mir4-compatibility-campaign-sol07", "static.mir4-affected-proof-sol08", "static.mir4-m4c01-closeout-sol09", "static.mir4-final-programme-reconciliation", "static.mir3-dot9-portal-visibility", "static.mir4-bootstrap-target-readiness", "static.mir4-local-playtest-shadow", "static.mir4-bootstrap-materialization", "static.mir4-offline-custody", "static.mir4-experimental-api-sdk", "static.mir4-target-compiler-w02", "static.mir4-semantic-compiler-w03", "static.mir4-runtime-continuity-w04", "static.mir4-module-ecosystem-w05", "static.mir4-processir-synthesis-w06", "static.mir4-inspector-compatibility-w07", "static.mir4-assurance-scale-w08", "static.mir4-historical-succession-w09", "static.mir4-whole-platform", "static.mir4-full-platform-closeout", "static.mir4-release-readiness-reconciliation", "static.mir4-release-phase-engine", "static.mir4-release-adapters-t03", "static.mir4-pre-freeze-hardening", "static.mir4-platform-preview", "static.mir4-hybrid-platform-authority"],
    "refactor-equivalence": ["static.compiler", "static.package", "runtime.exact-zip"],
    "hotfix": ["static.full", "runtime.affected", "runtime.exact-zip"],
    "targeted": ["static.full", "runtime.affected", "runtime.exact-zip"],
    "development-breadth": ["docs.check", "tooling.self-test", "static.architecture", "static.compiler", "static.settings", "static.locales", "static.balance", "static.museum", "static.release-history", "static.package", "static.full", "performance.static", "runtime.exact-zip", "runtime.full", "runtime.upgrade", "runtime.ecosystem", "release.approved-delta"],
    "full": ["docs.check", "tooling.self-test", "static.architecture", "static.compiler", "static.settings", "static.locales", "static.balance", "static.museum", "static.release-history", "static.package", "static.full", "performance.static", "runtime.exact-zip", "runtime.full", "runtime.upgrade", "runtime.ecosystem", "release.approved-delta", "runtime.performance-regression", "manual.release-review"],
    "backport": ["docs.check", "tooling.self-test", "static.architecture", "static.compiler", "static.settings", "static.locales", "static.balance", "static.museum", "static.release-history", "static.package", "static.full", "performance.static", "runtime.exact-zip", "runtime.full", "runtime.upgrade", "runtime.ecosystem", "runtime.performance-regression", "manual.release-review"],
    "promotion-check": ["seal.verify"]
  },
  "classes": [
    {
      "id": "mir4-bootstrap",
      "patterns": ["^\\.gitattributes$", "^mir\\.(?:toml|lock)$", "^\\.mir/targets\\.json$", "^\\.mir/releases/waves/mir4-r0/", "^\\.mir/performance-campaigns/4\\.0\\.", "^\\.mir/evidence/mir4-r0/", "^\\.mir/evidence/terminal-publication/2026-08-16/mod-portal/MIR3-Dot9-ModPortal-(?:CustodyObservation|VisibilityRecheck)V1\\.json$", "^dist/more-infinite-research_(?:3\\.2\\.(?:9|11)|2\\.5\\.(?:9|11)|1\\.9\\.9|1\\.8\\.9)\\.zip$", "^tools/lib/mir4/", "^tools/lib/assurance/Evidence\\.ps1$", "^tools/lib/validation/(?:MIR4DistributionIdentity|PackageIdentity)\\.ps1$", "^tools/commands/mir4/", "^tools/commands/package/Build-MIRPackage\\.ps1$", "^tools/commands/release/(?:Invoke-MIR4BootstrapCapsule|New-MIR4(?:Bootstrap(?:RootSet|LocalCandidate)|HistoricalPrivateCandidate|M4C01PlayerCandidateSet)|Test-MIR4R0Bootstrap)\\.ps1$", "^spec/(?:api/mir4-v[01]|platform/mir4-preview-v0)/", "^spec/schemas/(?:experimental|preview)/", "^spec/schemas/mir4-", "^spec/schemas/mir3-dot9-mod-portal-visibility-recheck\\.schema\\.json$", "^sdk/(?:experimental|preview)/mir4/", "^fixtures/mir4-(?:api-v0|mep-v[01]|process-ir-v[01]|inspector-compatibility-v1|assurance-scale-v1|historical-succession-v1)/", "^fixtures/assert-upgrade-(?:3-2-11|2-5-11)-to-4-0-", "^validation/tests/mir4/", "^validation/tests/release/(?:Test-MIR4|Test-MIR3Dot9ModPortalVisibilityRecheck)", "^docs/architecture/(?:current-architecture-matrix|mir4-|decisions/000[1-5]-mir)", "^docs/(?:reference/mir4-mep-v0|maintainer/mir4-(?:m4c01-runbook|w09-manual-playtest|full-platform-closeout))\\.md$", "^docs/reference/generated/mir4-(?:experimental-api-v0|api-sdk-v1|platform-component-matrix)\\.md$"],
      "tests": ["static.mir4-r0-identity", "static.mir4-r0-bootstrap", "static.mir4-public-feedback-intake", "static.mir4-maximum-level-sol03", "static.mir4-production-route-sol04", "static.mir4-research-cost-v2-sol05", "static.mir4-k2-science-sol06", "static.mir4-compatibility-campaign-sol07", "static.mir4-affected-proof-sol08", "static.mir4-m4c01-closeout-sol09", "static.mir4-final-programme-reconciliation", "static.mir3-dot9-portal-visibility", "static.mir4-bootstrap-target-readiness", "static.mir4-local-playtest-shadow", "static.mir4-bootstrap-materialization", "static.mir4-offline-custody", "static.mir4-experimental-api-sdk", "static.mir4-target-compiler-w02", "static.mir4-semantic-compiler-w03", "static.mir4-runtime-continuity-w04", "static.mir4-module-ecosystem-w05", "static.mir4-processir-synthesis-w06", "static.mir4-inspector-compatibility-w07", "static.mir4-assurance-scale-w08", "static.mir4-historical-succession-w09", "static.mir4-whole-platform", "static.mir4-full-platform-closeout", "static.mir4-release-readiness-reconciliation", "static.mir4-release-phase-engine", "static.mir4-release-adapters-t03", "static.mir4-pre-freeze-hardening", "static.mir4-platform-preview", "static.mir4-hybrid-platform-authority"]
    },
    {
      "id": "runtime-or-migration",
      "patterns": ["^control\\.lua$", "^migrations/", "^prototypes/mir/domain/research_cost/", "^prototypes/mir/runtime/", "^prototypes/mir/stage/control\\.lua$", "^validation/tests/runtime/Test-MIRUpgrade(?:Matrix)?\\.ps1$"],
      "tests": ["static.full", "runtime.full", "runtime.upgrade"]
    },
    {
      "id": "settings",
      "patterns": ["^settings", "^prototypes/mir/settings/", "^\\.mir/settings\\.yml$"],
      "tests": ["static.settings", "static.locales", "static.compiler", "runtime.affected", "runtime.upgrade", "runtime.exact-zip"]
    },
    {
      "id": "compiler-data-stage",
      "patterns": ["^data", "^prototypes/", "^\\.mir/(modules|streams|compatibility|capabilities|compiler-contract-coverage)\\.yml$", "^\\.mir/(compiler-schema-authority|module-dependencies|public-artifact-budgets|research-cost-contract-3\\.2\\.5|rule-synthesis|sanitation-budgets|technology-(?:effect-targets|governance|hard-gates|lifecycle|quality-profiles|review-corpus|review-snapshots))\\.json$"],
      "tests": ["static.compiler", "static.architecture", "static.package", "runtime.affected", "runtime.exact-zip"]
    },
    {
      "id": "balance",
      "patterns": ["^prototypes/mir/planner/costs\\.lua$", "^prototypes/streams/", "^prototypes/mir/domain/native_owner/", "^prototypes/mir/planner/native_owner_binding\\.lua$", "^prototypes/mir/emit/transactions/productivity_family_adoption\\.lua$", "^\\.mir/native-owner-cost-models\\.json$", "^\\.mir/performance-budgets\\.json$"],
      "tests": ["static.balance", "static.compiler", "runtime.affected", "runtime.exact-zip"]
    },
    {
      "id": "locale",
      "patterns": ["^locale/", "^\\.mir/locales/", "^tools/lib/localization/", "^scripts/(Test|Update)-MIRLocales\\.ps1$"],
      "tests": ["static.locales", "static.package", "runtime.exact-zip"]
    },
    {
      "id": "metadata-dependencies",
      "patterns": ["^info\\.json$"],
      "tests": ["static.package", "runtime.full", "runtime.upgrade", "runtime.exact-zip"]
    },
    {
      "id": "packaged-non-runtime",
      "patterns": ["^(README\\.md|changelog\\.txt|thumbnail\\.png|LICENSE)$"],
      "tests": ["static.package", "runtime.exact-zip"]
    },
    {
      "id": "assurance-tooling",
      "patterns": ["^\\.gitattributes$", "^scripts/Invoke-MIRAssurance\\.ps1$", "^tools/(?:mir\\.ps1|commands/(?:compatibility|control|package|release|targets|workspace)/|lib/(?:assurance|cli|compatibility|control)/|maintenance/)", "^spec/schemas/", "^validation/tests/(?:tooling/Test-MIR(?:Assurance|Layout|VerificationSchemas)|release/Test-MIR(?:GitHubAdministration|Release(?:Authority|WorkReconciliation)|Terminal(?:Governance|ShadowProjection)))\\.ps1$", "^validation/tests\\.yml$", "^\\.mir/(assurance|test-impact)\\.(json|yml)$", "^\\.mir/control/(?:aliases|paths)\\.yml$", "^\\.mir/control-plane/(?:approved-delta-policies|control-plane|ownership)\\.json$", "^\\.mir/lifecycle/tasks/", "^\\.mir/views/", "^\\.github/workflows/(?:validate|assurance-(?:targeted|scheduled))\\.yml$"],
      "tests": ["tooling.self-test", "static.full"]
    },
    {
      "id": "test-harness",
      "patterns": ["^scripts/(?!Invoke-MIRAssurance\\.ps1$)", "^fixtures/", "^validation/(?!tests\\.yml$)(?!tests/(?:tooling/Test-MIR(?:Assurance|Layout|VerificationSchemas)|release/Test-MIR(?:GitHubAdministration|Release(?:Authority|WorkReconciliation)|Terminal(?:Governance|ShadowProjection)))\\.ps1$)", "^verification/", "^tools/mir_verify/", "^\\.mir/(fixtures|test-catalog|targets|performance)", "^\\.mir/(combination-campaigns|compatibility-capsules|interaction-delta-policies|mod-interaction-(?:graph|policy))\\.json$", "^\\.github/workflows/(?!validate\\.yml$)(?!assurance-(?:targeted|scheduled)\\.yml$)", "^\\.gitignore$"],
      "tests": ["tooling.self-test", "static.full", "runtime.affected"]
    },
    {
      "id": "ecosystem-profile",
      "patterns": ["^fixtures/run-profiles/", "^validation/scenarios/local-(?:2\\.0|2\\.1)\\.json$"],
      "tests": ["static.full", "runtime.ecosystem"]
    },
    {
      "id": "release-governance",
      "patterns": ["^\\.mir/(branches|distributions|releases)\\.(json|yml)$", "^\\.mir/(?:lifecycle/(?:changes|incidents)|releases/(?:governance|records|reconciliations|freezes|transitions|waves|terminal))/", "^\\.mir/control-plane/package-locks\\.json$", "^\\.mir/(portable-return|release-wave)\\.yml$"],
      "tests": ["docs.check", "tooling.self-test", "static.release-history", "static.full", "static.package"]
    },
    {
      "id": "museum-tooling",
      "patterns": ["^\\.mir/(canonical-lower-features|museum-targets)\\.json$", "^fixtures/museum/", "^tools/commands/museum/(Build-MIRMuseumTarget|New-MIRMuseum)", "^validation/tests/runtime/Test-MIRMuseum", "^tools/lib/museum/"],
      "tests": ["static.museum"]
    },
    {
      "id": "repository-docs",
      "patterns": ["^docs/", "^spec/architecture/", "^\\.mir/(branches|convergence|docs)\\.yml$", "^CONTRIBUTING\\.md$", "^todo\\.md$", "^AGENTS\\.md$"],
      "tests": ["docs.check"]
    },
    {
      "id": "release-evidence",
      "patterns": ["^\\.mir/(evidence|target-lines|releases/(deltas|sources))/", "^dist/"],
      "tests": ["tooling.self-test", "static.release-history", "static.full", "static.package"]
    }
  ],
  "unknown_policy": {
    "tests": ["static.full", "runtime.full", "runtime.upgrade", "runtime.ecosystem"],
    "reason": "Unclassified inputs conservatively invalidate the full target gate."
  },
  "fingerprints": {
    "package_source": true,
    "package_content": true,
    "test_catalog": true,
    "validation_harness": true,
    "trust_policy": true,
    "target_profile": true,
    "settings": true,
    "factorio_binary": true,
    "fixture_inputs": true
  }
}
