  "disposition_groups": [
    {
      "name": "registered-readable-hidden-values",
      "disposition": "retain",
      "original_expectation": "Registered startup settings remain readable even when hidden; missing settings or nil values fail. The final fixture tests four retained automatic controls, named ordinary research settings where registered, and six native continuation groups. Hidden is not deletion and false/zero is not missing.",
      "implementation": [
        "source/research/settings.lua",
        "source/research/historical_settings.lua"
      ],
      "controls": [
        "tests/test_generator.py::test_full_published_setting_output_matches_oracle_with_explicit_growth_safety_cap",
        "tests/test_settings_profile.py::test_registered_settings_are_the_single_active_profile_authority",
        "tests/test_settings_profile.py::test_raw_json_import_bypasses_compressed_decode_and_preserves_empty_zero_false"
      ],
      "current_evidence": "The two unchanged published4.7.3 Lua fixtures pass on current Base and SpaceAge F210 host worlds; false hidden-auto-lab and zero native-worker base cost remain exact. Four wrong-hidden/nil-value controls fail the original assertions. This is host evidence, not an engine result."
    },
    {
      "name": "profile-and-target-visibility",
      "disposition": "consolidate",
      "original_expectation": "Experimental automatic-family tuning stays hidden; named official SpaceAge settings are hidden without the DLC and visible with it. Supported hidden settings remain registered. The selected earlier2.0 variants omit the two unavailable cargo-effect families rather than fabricating them. Final published4.2/4.7 policy keeps breeding tuning visible and enabled by default, superseding its earlier DLC-conditional hiding; capture-robot and nutrients defaults remain enabled independently of current generation availability.",
      "implementation": [
        "source/research/historical_settings.lua",
        "source/research/settings.lua",
        "source/compatibility/modern_catalogue.lua",
        "source/platform/target.lua"
      ],
      "controls": [
        "tests/test_generator.py::test_full_published_setting_output_matches_oracle_with_explicit_growth_safety_cap",
        "tests/test_modern_targets.py::test_f200_keeps_875_settings_and_supported_nondefault_values",
        "tests/test_historical_direct.py::test_historical_settings_keep_exact_names_defaults_and_time_sentinel"
      ],
      "current_evidence": "The current complete three-profile published-setting oracle matches all actual declaration fields, with only its separately reviewed planner-target retirement/growth bound. The new original-fixture probe executes two F210 profiles only; earlier2.0 and historical-target fixture bodies are source dispositions, not newly executed/native passes."
    },
    {
      "name": "effective-values-profile-transport-and-legacy-settings-api",
      "disposition": "consolidate",
      "original_expectation": "Imported values are validated effective overrides; false/zero are not replaced by truthy defaults and startup values are not mutated. Deterministic full/compact MIRSET1 exports exclude their import setting, keep bounded validation and write only requested local script output. Preserve the existing settings interface and commands within their documented scope.",
      "implementation": [
        "source/research/settings.lua",
        "source/research/settings_profile.lua",
        "source/runtime/settings_profile.lua",
        "source/runtime/bootstrap.lua"
      ],
      "controls": [
        "tests/test_settings_profile.py::test_import_precedence_uses_profile_validation_before_consumer_normalization",
        "tests/test_settings_profile.py::test_codec_has_canonical_identity_and_strict_compact_option",
        "tests/test_settings_profile.py::test_all_registered_effect_defaults_export_in_full_and_disappear_in_compact",
        "tests/test_settings_commands.py",
        "tests/test_bootstrap.py"
      ],
      "current_evidence": "Reuse the existing settings-profile-roundtrip intent record and controls rather than count the same obligation twice. The legacy more-infinite-research-settings bridge remains in bootstrap; it is not retired because the MIR5 API is unified. Actual UI import/export files, independent-client targeting and changed current native API boundaries remain separately open."
    },
    {
      "name": "authored-presentation-defaults-and-prototype-limits",
      "disposition": "consolidate",
      "original_expectation": "Default enablement and attention/risk presentation are distinct. Keep stable setting IDs, useful grouping/order/tooltips and explicit startup-only limits: engine-default by default, separate energy/pollution controls, opt-in power floor, no fake divider settings and no forced hidden values.",
      "implementation": [
        "source/research/historical_settings.lua",
        "source/research/settings.lua",
        "source/overrides/prototype_limits.lua",
        "README.md"
      ],
      "controls": [
        "tests/test_generator.py::test_full_published_setting_output_matches_oracle_with_explicit_growth_safety_cap",
        "tests/test_prototype_limits.py",
        "tests/test_settings_profile.py::test_settings_descriptors_remain_stable_after_caller_mutation_and_parse_closure"
      ],
      "current_evidence": "Complete serialized-setting comparison retains captured order/localized names/descriptions/defaults, not merely declaration counts. This does not prove rendered attention markers, localization, native settings input or all nondefault gameplay effects; preserve those checks in the existing settings/Library queue."
    },
    {
      "name": "base-only-no-spaceage-generation",
      "disposition": "retain",
      "original_expectation": "The final readability fixture also refuses named SpaceAge-only technologies on Base-only inputs. Setting visibility/default enablement alone does not authorize construction of those technologies.",
      "implementation": [
        "source/compatibility/modern_catalogue.lua",
        "source/data-final-fixes.lua"
      ],
      "controls": [
        "tests/test_generator.py",
        "tests/test_modern_targets.py"
      ],
      "current_evidence": "The unchanged published data-final fixture observes the actual emitted current rows installed into a host-only raw-table publication projection; it passes the Base absence assertion. No whole native catalogue, arbitrary provider or physical-output verdict follows."
    },
    {
      "name": "retired-exact-helper-and-generated-document-lint",
      "disposition": "obsolete-implementation-only",
      "original_expectation": "The wrapper names old compiler/schema/descriptor/stage-builder/CurrentTargetPackage helpers and generated documentation markers. Their implementation addresses and generated-estate markers are not player behavior. Preserve policy purity, input custody, default-value immutability and authored useful documentation behind those checks.",
      "implementation": [
        "source/research/settings.lua",
        "tools/package.py",
        "tools/release.py",
        "docs/development.md"
      ],
      "controls": [
        "tests/test_pack.py",
        "tools/check_repository.py"
      ],
      "current_evidence": "MIR5 uses the canonical source/target package and existing strict controls. Do not restore the MIR4 compiler, .mir schema/target snapshots, generated docs, or obsolete wrapper to satisfy source-text snippets. Imported helper implementation bodies and original native receipt custody are outside this selected19-body review, not implicitly dispositioned."
