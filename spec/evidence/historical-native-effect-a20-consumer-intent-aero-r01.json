      "original_basis": "Final assert-weapon-speed-safety external_owner branch and original native_effect_coverage.resolve_direct_effect_ownership; not current output.",
      "current_implementation": [
        "source/research/modern.lua: direct construction plus apply_weapon_speed_overlap only removes categories from a constructed MIR continuation",
        "source/data-final-fixes.lua: existing competing provider adapter is F200 and named recipe-productivity providers",
        "source/compatibility/modern_catalogue.lua: finite authored family selection"
      ],
      "current_controls": [
        "tests/test_generator.py::GeneratorTests::test_weapon_speed_overlap_requires_an_enabled_positive_direct_replacement",
