      "owner": "Aero independent source/expectation correction; Black Glass qualified profile/state/native execution"
    },
    {
      "id": "weapon-overlap-needs-real-positive-replacement",
      "independent_expectation": "Off preserves categories. Other modes remove a generic continuation category only for an actual enabled positive replacement; always alone is not authority. Existing finite5/6 cannon effects remain. Mixed Tesla/electric coverage is decided per identity, preserving an unowned useful category.",
      "current_controls": [
        "tests/test_generator.py::GeneratorTests::test_weapon_speed_overlap_requires_an_enabled_positive_direct_replacement",
        "tests/test_generator.py::GeneratorTests::test_data_final_full_published_technology_output_matches_oracle"
      ],
      "disposition": "consolidate-covered-bounded-mode-controls-retain-mixed-foreign-consumer-checks",
      "limits": "Default captured-row and positive MIR-output controls do not prove foreign-owner suppression, finite5/6 mutation safety or partly covered foreign mixed categories.",
      "remaining_executable_check": "Add independent finite-predecessor and mixed foreign Tesla/electric controls at applicable authored integration boundaries; no candidate-derived oracle."
    },
    {
      "id": "numbered-name-is-not-mir-custody",
      "independent_expectation": "A preexisting weapon-shooting-speed-99 is foreign despite its numbered name. MIR cleanup cannot strip its positive categories. Original fixture removes this synthetic counterexample before final engine validation, so its presence never demonstrates a valid native final prototype graph.",
      "current_implementation": [
        "source/research/modern.lua: overlap edits only submitted constructed7/9 rows",
        "source/runtime/catalogue.lua: explicit shared-tail creator history"
      ],
      "current_controls": [
        "tests/test_continuation_ownership.py::ContinuationOwnershipTests::test_foreign_creator_remains_external_after_later_modifications"
      ],
      "disposition": "retain-custody-invariant-consolidate-creator-boundary-with-exact-counterexample-unported",
      "remaining_executable_check": "Port named-counterexample mutation protection into a host-only submitted-output/raw-foreign split. Native coverage uses a genuinely upstream-valid provider identity, not synthetic99 left after an infinite tail."
