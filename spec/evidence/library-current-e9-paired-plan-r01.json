      ],
      "actions": [
        "first_open",
        "search",
        "refresh",
        "reopen"
      ],
      "unit": "milliseconds",
      "definition": "One native LuaProfiler surrounds two actual public Browser.open calls (one English,one German) per action on each peer. This is native GUI-construction Lua time,not end-to-end input or frame latency.",
      "reader": "tools/read_library_profiles.py",
      "logs": "Explicit six per-process stdout logs:initial/restart for server/client-en/client-de. Require all four distinct actions exactly once per role."
    },
    "save_ready": {
      "phases": [
        "initial",
        "restart"
      ],
      "role": "server",
      "unit": "seconds",
      "definition": "Native engine log elapsed seconds at its one ready marker on the first post-load runtime event for the exact prepared seed or closed restart save. This includes engine startup/load to readiness,not menu response or client join time.",
      "marker": "MIR5_LIBRARY_PAIRED_BROWSER",
      "required_stage": "ready"
    },
    "process_memory": {
      "phases": [
        "initial",
        "restart"
      ],
      "roles": [
        "server",
        "client-en",
        "client-de"
      ],
      "metrics": [
        "working_set_bytes",
        "private_bytes"
      ],
      "reduction": "Per-session maximum observed value separately for every phase/role/metric.",
      "target_interval_milliseconds": 250,
      "required_status": "complete-observation",
      "limits": "Observed maxima are not instantaneous OS-proven peaks or retained-memory/leak verdicts."
    }
  },
  "rules": {
    "control": "For each endpoint compare the two identical-published control sessions:abs(A-B)<=max(0.10*mean(A,B),absolute_floor). Any failed/missing control invalidates comparison acceptance;retain all observations.",
    "comparison": "For each endpoint separately compare medians of the four predeclared scored sessions per arm:candidate<=published+max(0.10*published,absolute_floor). Report paired block differences and min/max;no bootstrap,equivalence or universal-speed claim.",
    "absolute_floors": {
      "library_milliseconds": 5.0,
      "save_ready_seconds": 0.25,
      "process_memory_bytes": 67108864
    },
    "floor_reason": "Five milliseconds for two Browser calls is a practical GUI-construction budget below one 60Hz frame;quarter-second load and64MiB memory floors avoid treating insignificant native variation as gameplay regression. These are frozen before the new observations.",
    "extensions": 0,
    "exclusions": "The two warmups and two A/A controls are retained and never pooled into the eight scored sessions. No selective retries or later threshold changes."
  },
  "resources": {
    "session_expected_peak_memory_mib": 8192,
    "preparation_peak_memory_mib": 4096,
    "existing_resource_governor": true,
    "exclusive_direct_library": true
  },
  "custody": {
    "player_packages": "Immutable;verify hashes before/after.",
    "source_and_saved_worlds": "Preserve preparation/restart/final archives and all raw observations;never overwrite originals.",
    "controls": "Snapshot original own MIR/fixture archives and all direct-library controls;restore exact bytes under exclusive ownership.",
    "dependencies": "No third-party archive copies,links,extractions or metadata changes.",
    "evidence": "Hash and decode all eight PNGs per session;visually inspect representative EN/DE published/current first-open/reopen frames after timing."
  },
  "quiet_conditions": [
    "One owned native session at a time;no other Factorio jobs.",
    "Prepare own fixture archives and run host/build controls before the timed block.",
    "No local builds,host suites,inference or unrelated heavy work during the complete12-session block.",
    "Keep graphics,observer,engine,Defaults and existing per-client config template behavior unchanged."
  ],
  "limits": [
    "Base F200/2.0.77 only;not F210/Space Age/modpack acceptance.",
    "Fresh fixture worlds use the existing creation path;native random map generation may contribute whole-process variation. GUI/native-state workload and preserved technology names are fixed;no claim of identical whole-world bytes.",
    "Browser requires MIR;there is no valid no-MIR Browser comparator. This measures direct published/current behavior,not MIR-added overhead.",
    "Two real English/German clients and a cold host restart are required each session. No new lab completions or physical production are claimed.",
    "No long-session/churn/retained-memory or general release verdict follows. Those remain independent release obligations."
  ]
