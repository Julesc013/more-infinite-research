  "groups": [
    {
      "id": "research-event-validity-and-routing",
      "disposition": "port-recovered-guard",
      "independent_expectation": "All sixteen active historical bodies reject missing/invalid research before feature dispatch. Named technology filters and later generic cap callbacks retain valid finished/reversed/queued routing; cancellation arrays are a separate modern API shape.",
      "implementation": [
        "source/runtime/bootstrap.lua"
      ],
      "controls": [
        "tests/test_bootstrap.py::test_missing_or_invalid_research_does_not_enter_runtime_consumers",
        "tests/test_bootstrap.py::test_queued_research_guard_preserves_valid_library_and_discovery_dispatch",
        "tests/test_bootstrap.py::test_control_composes_lifecycle_library_api_legacy_interface_and_command",
        "tests/test_bootstrap.py::test_only_pending_private_work_binds_completion_and_cancellation"
      ],
      "actual_change": "The new tripwire first fails on research.name access in the unguarded completion callback. Extended controls also expose started/queued routing. Restore missing/invalid guards for finished/reversed/started/queued before any consumer. The queued wrapper keeps the existing Library and optional DiscoveryTree paths and subscription condition. Cancellation handling is unchanged.",
      "remaining": "Native engine/client invocation of these invalid-handle cases is unverified; no community crash or engine cause is attributed. Root reviews consumed-input applicability and affected final-candidate lifecycle checks."
    },
    {
      "id": "force-and-effect-lifecycle",
      "disposition": "consolidate-existing-named-owners",
      "independent_expectation": "Later historical orchestration adds force creation, force merge and then force reset alongside effects reset and planted-seed handling. Each active feature must retain its required events independently of unrelated caps or closed Library views.",
      "implementation": [
        "source/runtime/bootstrap.lua",
        "source/runtime/lifecycle.lua",
        "source/runtime/scripted_effects.lua",
        "source/runtime/native_credits.lua"
      ],
      "controls": [
        "tests/test_bootstrap.py::test_unlimited_scripted_effects_register_and_route_force_lifecycle_events",
        "tests/test_bootstrap.py::test_native_credit_lifecycle_survives_provider_absence_without_research_callbacks",
        "tests/test_scripted_effects_lifecycle.py"
      ],
      "remaining": "Registration intent does not qualify the imported feature bodies or native force/reset/merge semantics. Existing paid-state components retain original identities; next weapon/Galore transitions and stable applicability remain open."
    },
    {
      "id": "parse-load-and-target-subsets",
      "disposition": "retain-lifetime-and-capabilities-retire-dispatcher-layout",
      "independent_expectation": "Modules are imported while control parses; later adapters register repair/Library and reconnect only their local work on load. Positive target requirements and a disabled Factorio1 shim restrict unavailable functionality; the exact requires_features table or disabled error string is not a new public API.",
      "implementation": [
        "source/runtime/bootstrap.lua",
        "source/runtime/scripted_effects.lua",
        "source/adapters/reduced/control.lua",
        "source/platform/target.lua"
      ],
      "controls": [
        "tests/test_bootstrap.py::test_bootstrap_has_no_late_module_loading_or_unconditional_tick_dispatch",
