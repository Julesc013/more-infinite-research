{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.more-infinite-research.invalid/package/mir4-composable-package-source-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "materializer_abi", "source_state", "predecessor_record_sha256", "source_roots", "bindings", "invariants", "record_sha256"],
  "properties": {
    "schema": {"const": 2},
    "kind": {"const": "MIR4ComposablePackageSourceV2"},
    "materializer_abi": {"const": "mir4-target-materializer/1"},
    "source_state": {"const": "canonical-composable-package-source"},
    "predecessor_record_sha256": {"$ref": "#/$defs/sha256"},
    "source_roots": {"const": ["source"]},
    "bindings": {"type": "array", "minItems": 359, "maxItems": 359, "items": {"$ref": "#/$defs/binding"}},
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["single_editable_source_root", "one_binding_per_target_output", "shared_source_bytes_deduplicated", "historical_archives_not_production_inputs", "package_cutover_complete"],
      "properties": {
        "single_editable_source_root": {"const": true},
        "one_binding_per_target_output": {"const": true},
        "shared_source_bytes_deduplicated": {"const": true},
        "historical_archives_not_production_inputs": {"const": true},
        "package_cutover_complete": {"const": true}
      }
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "target_scope", "output_path", "semantic_class", "source_path", "predecessor_source_path", "transform", "source_bytes", "source_sha256", "output_bytes", "output_sha256"],
      "properties": {
        "layer": {"enum": ["shared", "capability", "compatibility", "adapter", "presentation"]},
        "target_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["f210", "f200", "f110", "f100"]}},
        "output_path": {"type": "string", "minLength": 1},
        "semantic_class": {"enum": ["common-semantic-source", "common-asset-locale", "generated-metadata", "generated-lifecycle-entrypoint", "target-overlay", "target-replacement", "target-compatibility-shim", "migration", "package-documentation"]},
        "source_path": {"type": "string", "pattern": "^source/.+"},
        "predecessor_source_path": {"type": "string", "pattern": "^(?:src/mod/|targets/f(?:210|200|110|100)/(?:files|generation)/).+"},
        "transform": {"enum": ["copy-exact-bytes", "decode-base64-v1", "exact-template-v1"]},
        "source_bytes": {"type": "integer", "minimum": 0},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "output_bytes": {"type": "integer", "minimum": 0},
        "output_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
