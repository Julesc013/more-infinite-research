{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/more-infinite-research/schemas/mir4/control/release-compatibility-canaries-t13-v1.schema.json",
  "title": "MIR 4 T13 release compatibility canary authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "work_package", "programme_id", "maturity", "canonicalization", "exact_processir_authority", "diagnostic_registry", "required_capture_count", "required_canary_count", "lifecycle", "target_upgrades", "common_expiry_triggers", "canaries", "release_qualification_input", "semantic_authority", "player_mutation_authorized", "prototype_write_authorized", "automatic_synthesis_authorized", "public_support_claim_authorized", "source_freeze_authorized", "signing_or_sealing_authorized", "promotion_authorized", "publication_authorized", "tooling", "package_visible"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4ReleaseCompatibilityCanariesT13V1"},
    "work_package": {"const": "T13"},
    "programme_id": {"const": "M4C10-WHOLE-4X-IN-4.0"},
    "maturity": {"const": "pre-freeze-release-canary"},
    "canonicalization": {"const": "mir-canonical-json/1"},
    "exact_processir_authority": {"const": ".mir/releases/waves/mir4-r0/MIR4-Exact-ProcessIR-T12V1.json"},
    "diagnostic_registry": {"const": "spec/api/mir4-v1/diagnostics.json"},
    "required_capture_count": {"const": 11},
    "required_canary_count": {"const": 8},
    "lifecycle": {"type": "object"},
    "target_upgrades": {"type": "object", "required": ["f210", "f200"]},
    "common_expiry_triggers": {"type": "array", "minItems": 5, "uniqueItems": true},
    "canaries": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "required": ["id", "name", "capture_ids", "subjects", "compatibility_authorities", "support_statement", "limitations"]}},
    "release_qualification_input": {"const": true},
    "semantic_authority": {"const": false},
    "player_mutation_authorized": {"const": false},
    "prototype_write_authorized": {"const": false},
    "automatic_synthesis_authorized": {"const": false},
    "public_support_claim_authorized": {"const": false},
    "source_freeze_authorized": {"const": false},
    "signing_or_sealing_authorized": {"const": false},
    "promotion_authorized": {"const": false},
    "publication_authorized": {"const": false},
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applications", "commands", "migration_authority", "compatibility_entrypoints", "reference_mode", "package_visible", "release_transition_authority"],
      "properties": {
        "applications": {"const": ["tools/mir/application/inspection/CompatibilityCanary.ps1"]},
        "commands": {"const": ["tools/mir/cli/Export-MIR4CompatibilityCanaryRecords.ps1"]},
        "migration_authority": {"const": "governance/repository/migrations/inspector-compatibility-tooling-v1.json"},
        "compatibility_entrypoints": {"const": ["tools/lib/mir4/CompatibilityCanary.ps1", "tools/commands/mir4/Export-MIR4CompatibilityCanaryRecords.ps1"]},
        "reference_mode": {"const": "read-only-exact-historical-evidence"},
        "package_visible": {"const": false},
        "release_transition_authority": {"const": false}
      }
    },
    "package_visible": {"const": false}
  }
}
