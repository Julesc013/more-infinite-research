{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-protected-main-qualification-v1.schema.json",
  "title": "MIR 4.2 protected-main qualification binding V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "status", "candidate", "materializer", "package_presentation", "authority", "expected_targets", "targets", "release_authority", "publication_authority", "record_sha256"],
  "properties": {
    "schema": {"const": 1}, "kind": {"const": "MIR42ProtectedMainQualificationBindingV3"}, "status": {"const": "independently-qualified"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "materializer": {"type": "object", "additionalProperties": false, "required": ["path", "git_blob"], "properties": {"path": {"const": "tools/mir/application/package/TargetMaterializer.ps1"}, "git_blob": {"$ref": "#/$defs/git"}}},
    "package_presentation": {"$ref": "#/$defs/packagePresentation"},
    "authority": {"$ref": "#/$defs/authority"},
    "expected_targets": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "allOf": [{"contains": {"const": "F200"}}, {"contains": {"const": "F210"}}]},
    "targets": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/target"}},
    "release_authority": {"const": false}, "publication_authority": {"const": false}, "record_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["ref", "commit", "tree"], "properties": {"ref": {"type": "string", "pattern": "^refs/heads/candidate/"}, "commit": {"$ref": "#/$defs/git"}, "tree": {"$ref": "#/$defs/git"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "git_blob", "record_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "git_blob": {"$ref": "#/$defs/git"}, "record_sha256": {"$ref": "#/$defs/sha"}}},
    "packagePresentation": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "git_blob", "record_sha256", "package_source_fingerprint_sha256", "source_manifest", "package_authority"], "properties": {"path": {"const": "spec/distribution/mir4-current-package-presentation-v6.json"}, "kind": {"const": "MIR4CurrentPackagePresentationV6"}, "git_blob": {"$ref": "#/$defs/git"}, "record_sha256": {"$ref": "#/$defs/sha"}, "package_source_fingerprint_sha256": {"$ref": "#/$defs/sha"}, "source_manifest": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"path": {"const": "source/package-source.json"}, "kind": {"const": "MIR4ComposablePackageSourceV2"}}}]}, "package_authority": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"path": {"const": "targets/package-authority.json"}, "kind": {"const": "MIR4CanonicalPackageAuthorityV2"}}}]}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["kind", "issuer_id", "trust_policy", "producer"], "properties": {"kind": {"const": "MIR4GovernedIndependentQualificationAuthorityV1"}, "issuer_id": {"type": "string", "minLength": 1}, "trust_policy": {"const": "validation/trust.json"}, "producer": {"type": "object", "additionalProperties": false, "required": ["repository", "workflow", "run_id", "run_attempt", "job", "actor", "commit", "ref", "event", "environment", "runner_identity", "trust_class", "verifier_sha256", "policy_sha256"], "properties": {"repository": {"const": "Julesc013/more-infinite-research"}, "workflow": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "run_attempt": {"type": "string", "minLength": 1}, "job": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "commit": {"$ref": "#/$defs/git"}, "ref": {"type": "string", "minLength": 1}, "event": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}, "runner_identity": {"type": "string", "minLength": 1}, "trust_class": {"type": "string", "minLength": 1}, "verifier_sha256": {"$ref": "#/$defs/sha"}, "policy_sha256": {"$ref": "#/$defs/sha"}}}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["target", "distribution_version", "relative_path", "archive_sha256", "content_sha256", "bytes", "entry_count", "root", "factorio_version", "worker_receipt", "independent_receipt"], "properties": {"target": {"enum": ["F200", "F210"]}, "distribution_version": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "minLength": 1}, "archive_sha256": {"$ref": "#/$defs/sha"}, "content_sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 1}, "entry_count": {"type": "integer", "minimum": 1}, "root": {"type": "string", "minLength": 1}, "factorio_version": {"enum": ["2.0", "2.1"]}, "worker_receipt": {"type": "object"}, "independent_receipt": {"type": "object"}}}
  }
}
