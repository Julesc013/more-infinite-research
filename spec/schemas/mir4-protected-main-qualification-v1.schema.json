{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-protected-main-qualification-v1.schema.json",
  "title": "MIR 4.2 protected-main qualification binding V4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "status", "candidate", "materializer", "package_presentation", "expected_targets", "targets", "release_authority", "publication_authority", "record_sha256"],
  "properties": {
    "schema": {"const": 1}, "kind": {"const": "MIR42ProtectedMainQualificationBindingV4"}, "status": {"const": "independently-qualified"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "materializer": {"type": "object", "additionalProperties": false, "required": ["path", "git_blob"], "properties": {"path": {"const": "tools/mir/application/package/TargetMaterializer.ps1"}, "git_blob": {"$ref": "#/$defs/git"}}},
    "package_presentation": {"$ref": "#/$defs/packagePresentation"},
    "expected_targets": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "allOf": [{"contains": {"const": "F200"}}, {"contains": {"const": "F210"}}]},
    "targets": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/target"}},
    "release_authority": {"const": false}, "publication_authority": {"const": false}, "record_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["ref", "commit", "tree"], "properties": {"ref": {"type": "string", "pattern": "^refs/heads/candidate/"}, "commit": {"$ref": "#/$defs/git"}, "tree": {"$ref": "#/$defs/git"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "git_blob", "record_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "git_blob": {"$ref": "#/$defs/git"}, "record_sha256": {"$ref": "#/$defs/sha"}}},
    "packagePresentation": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "git_blob", "record_sha256", "package_source_fingerprint_sha256", "source_manifest", "package_authority"], "properties": {"path": {"const": "spec/distribution/mir4-current-package-presentation-v7.json"}, "kind": {"const": "MIR4CurrentPackagePresentationV7"}, "git_blob": {"$ref": "#/$defs/git"}, "record_sha256": {"$ref": "#/$defs/sha"}, "package_source_fingerprint_sha256": {"$ref": "#/$defs/sha"}, "source_manifest": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"path": {"const": "source/package-source.json"}, "kind": {"const": "MIR4ComposablePackageSourceV3"}}}]}, "package_authority": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"path": {"const": "targets/package-authority.json"}, "kind": {"const": "MIR4CanonicalPackageAuthorityV2"}}}]}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["kind", "issuer_id", "trust_policy", "producer"], "properties": {"kind": {"const": "MIR4GovernedTargetQualificationAuthorityV2"}, "issuer_id": {"type": "string", "minLength": 1}, "trust_policy": {"const": "validation/trust.json"}, "producer": {"type": "object", "additionalProperties": false, "required": ["repository", "workflow", "run_id", "run_attempt", "job", "actor", "workflow_commit", "workflow_ref", "source_commit", "source_tree", "target", "factorio_version", "event", "environment", "runner_identity", "trust_class", "verifier_sha256", "policy_sha256"], "properties": {"repository": {"const": "Julesc013/more-infinite-research"}, "workflow": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "run_attempt": {"type": "string", "minLength": 1}, "job": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "workflow_commit": {"$ref": "#/$defs/git"}, "workflow_ref": {"type": "string", "minLength": 1}, "source_commit": {"$ref": "#/$defs/git"}, "source_tree": {"$ref": "#/$defs/git"}, "target": {"enum": ["F200", "F210"]}, "factorio_version": {"enum": ["2.0", "2.1"]}, "event": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}, "runner_identity": {"type": "string", "minLength": 1}, "trust_class": {"type": "string", "minLength": 1}, "verifier_sha256": {"$ref": "#/$defs/sha"}, "policy_sha256": {"$ref": "#/$defs/sha"}}}}},
    "contextProof": {"type": "object", "additionalProperties": false, "required": ["id", "release", "candidate_id", "plan_id", "manifest_sha256", "candidate_descriptor_sha256", "environment_locks_sha256"], "properties": {"id": {"$ref": "#/$defs/sha"}, "release": {"type": "string", "minLength": 1}, "candidate_id": {"type": "string", "minLength": 1}, "plan_id": {"$ref": "#/$defs/sha"}, "manifest_sha256": {"$ref": "#/$defs/sha"}, "candidate_descriptor_sha256": {"$ref": "#/$defs/sha"}, "environment_locks_sha256": {"$ref": "#/$defs/sha"}}},
    "packageProof": {"type": "object", "additionalProperties": false, "required": ["archive_sha256", "content_sha256", "bytes", "entry_count", "source_sha256"], "properties": {"archive_sha256": {"$ref": "#/$defs/sha"}, "content_sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 1}, "entry_count": {"type": "integer", "minimum": 1}, "source_sha256": {"$ref": "#/$defs/sha"}}},
    "engineProof": {"type": "object", "additionalProperties": false, "required": ["version", "installation_sha256", "binary_sha256", "binary_bytes", "official_data_sha256", "official_data_file_count"], "properties": {"version": {"type": "string", "minLength": 1}, "installation_sha256": {"$ref": "#/$defs/sha"}, "binary_sha256": {"$ref": "#/$defs/sha"}, "binary_bytes": {"type": "integer", "minimum": 1}, "official_data_sha256": {"$ref": "#/$defs/sha"}, "official_data_file_count": {"type": "integer", "minimum": 1}}},
    "evidenceProof": {"type": "object", "additionalProperties": false, "required": ["qualification_manifest_sha256", "aggregate_result_sha256", "worker_import_sha256", "seal_result_sha256", "promotion_result_sha256", "seal_object_sha256", "seal_task_object_sha256", "promotion_task_object_sha256"], "properties": {"qualification_manifest_sha256": {"$ref": "#/$defs/sha"}, "aggregate_result_sha256": {"$ref": "#/$defs/sha"}, "worker_import_sha256": {"$ref": "#/$defs/sha"}, "seal_result_sha256": {"$ref": "#/$defs/sha"}, "promotion_result_sha256": {"$ref": "#/$defs/sha"}, "seal_object_sha256": {"$ref": "#/$defs/sha"}, "seal_task_object_sha256": {"$ref": "#/$defs/sha"}, "promotion_task_object_sha256": {"$ref": "#/$defs/sha"}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["context", "package", "engine", "evidence"], "properties": {"context": {"$ref": "#/$defs/contextProof"}, "package": {"$ref": "#/$defs/packageProof"}, "engine": {"$ref": "#/$defs/engineProof"}, "evidence": {"$ref": "#/$defs/evidenceProof"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["target", "distribution_version", "relative_path", "archive_sha256", "content_sha256", "bytes", "entry_count", "root", "factorio_version", "authority", "proof"], "properties": {"target": {"enum": ["F200", "F210"]}, "distribution_version": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "minLength": 1}, "archive_sha256": {"$ref": "#/$defs/sha"}, "content_sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 1}, "entry_count": {"type": "integer", "minimum": 1}, "root": {"type": "string", "minLength": 1}, "factorio_version": {"enum": ["2.0", "2.1"]}, "authority": {"$ref": "#/$defs/authority"}, "proof": {"$ref": "#/$defs/proof"}}}
  }
}
