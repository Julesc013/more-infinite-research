{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.invalid/mir4-compatibility-factory-plan-v1.schema.json",
  "title": "MIR 4 Compatibility Factory Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "programme_id", "source_identity", "maturity", "support_bundle_digest", "subject_ledger_digest", "target", "pipeline", "priority", "subject_inventory_count", "plans", "portability_preview", "explanation", "zip_contract", "passed", "package_visible", "public_release_proof", "player_mutation_authorized", "digest"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4CompatibilityFactoryPlanV1"},
    "programme_id": {"const": "M4C02-09-24H"},
    "source_identity": {"type": ["object", "null"]},
    "maturity": {"const": "developer-preview"},
    "support_bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject_ledger_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target": {"pattern": "^f[0-9]{3}$"},
    "pipeline": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string"}},
    "priority": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string"}},
    "subject_inventory_count": {"type": "integer", "minimum": 1, "maximum": 10},
    "plans": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "object", "required": ["subject_id", "selected_choice", "choice_path", "terminal_disposition", "target", "provider_identity_digest", "claim_eligible", "automatic_mutation", "executable_operations", "evidence_state"]}},
    "portability_preview": {"type": "object", "required": ["target", "all_subjects_target_bound", "cross_target_transfer_authorized"]},
    "explanation": {"type": "object", "required": ["mode", "arbitrary_code_generation", "automatic_player_mutation", "public_claim", "notes"]},
    "zip_contract": {"type": "object", "required": ["allowlist", "forbidden_extensions", "executable_content"]},
    "passed": {"const": true},
    "package_visible": {"const": false},
    "public_release_proof": {"const": false},
    "player_mutation_authorized": {"const": false},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
