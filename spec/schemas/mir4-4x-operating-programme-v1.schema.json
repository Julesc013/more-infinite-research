{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/more-infinite-research/schemas/mir4-4x-operating-programme-v1.schema.json",
  "title": "MIR 4.x operating programme V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "status",
    "recorded_at",
    "objective",
    "permanent_invariants",
    "work_packages",
    "package_fixed_point",
    "outcome_trains",
    "engine_channels",
    "wip_limits"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "MIR4XOperatingProgrammeV1"
    },
    "status": {
      "const": "active"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "objective": {
      "type": "string",
      "minLength": 40
    },
    "permanent_invariants": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "work_packages": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outcome",
          "completion_boundary",
          "depends_on",
          "state"
        ],
        "properties": {
          "id": {
            "pattern": "^M(40|41|42|43|44|45|46)-[0-9]{2}$"
          },
          "outcome": {
            "type": "string",
            "minLength": 8
          },
          "completion_boundary": {
            "pattern": "^4\\.(?:0\\.x|[1-9][0-9]*\\.0|[1-9][0-9]*\\.0\\+)$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "state": {
            "enum": [
              "complete",
              "active",
              "queued",
              "blocked-dependency"
            ]
          }
        }
      }
    },
    "package_fixed_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_package",
        "phase",
        "target_results",
        "aggregate",
        "next_target",
        "package_cutover",
        "cutover_receipt"
      ],
      "properties": {
        "work_package": {
          "const": "M42-00"
        },
        "phase": {
          "enum": [
            "M41-F2D",
            "M41-F2E"
          ]
        },
        "target_results": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "state",
              "receipt"
            ],
            "properties": {
              "target": {
                "enum": [
                  "f210",
                  "f200",
                  "f110",
                  "f100"
                ]
              },
              "state": {
                "enum": [
                  "complete",
                  "pending"
                ]
              },
              "receipt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "aggregate": {
          "enum": [
            "pending",
            "complete"
          ]
        },
        "next_target": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "f210",
            "f200",
            "f110",
            "f100",
            null
          ]
        },
        "package_cutover": {
          "enum": [
            "blocked",
            "ready",
            "complete"
          ]
        },
        "cutover_receipt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "outcome_trains": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object"
      }
    },
    "engine_channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "authority",
          "selector",
          "state",
          "recurring_obligation"
        ],
        "properties": {
          "target": {
            "const": "f210"
          },
          "authority": {
            "const": "spec/engines/mir4-factorio-2.1-experimental-channel-v1.json"
          },
          "selector": {
            "const": "latest-installed-official-2.1-experimental"
          },
          "state": {
            "const": "active-until-first-official-2.1-stable"
          },
          "recurring_obligation": {
            "type": "string",
            "minLength": 40
          }
        }
      }
    },
    "wip_limits": {
      "type": "object"
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_manifest",
        "plan_document",
        "release_baseline",
        "request_ledger",
        "component_destinations",
        "historical_inventory",
        "completion_states",
        "noncompletion_states",
        "preparation_objectives_hours",
        "objectives_measured",
        "heavy_engine_concurrency",
        "tasks"
      ],
      "properties": {
        "input_manifest": {
          "type": "string",
          "minLength": 1
        },
        "plan_document": {
          "type": "string",
          "minLength": 1
        },
        "release_baseline": {
          "type": "object"
        },
        "request_ledger": {
          "type": "string",
          "minLength": 1
        },
        "component_destinations": {
          "type": "string",
          "minLength": 1
        },
        "historical_inventory": {
          "type": "string",
          "minLength": 1
        },
        "completion_states": {
          "type": "array"
        },
        "noncompletion_states": {
          "type": "array"
        },
        "preparation_objectives_hours": {
          "type": "object"
        },
        "objectives_measured": {
          "type": "boolean"
        },
        "heavy_engine_concurrency": {
          "type": "integer"
        },
        "tasks": {
          "type": "array",
          "minItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "programme_mapping",
              "depends_on",
              "owner_domain",
              "requests",
              "acceptance",
              "state",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^A[0-9]{2}$"
              },
              "title": {
                "type": "string",
                "minLength": 8
              },
              "programme_mapping": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "depends_on": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "owner_domain": {
                "type": "string",
                "minLength": 1
              },
              "requests": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "UI-01",
                    "UI-02",
                    "UI-03",
                    "UI-04",
                    "PROG-01",
                    "PIPE-01",
                    "FLUID-01",
                    "FLUID-02",
                    "NATIVE-01",
                    "WEAPON-01",
                    "VEH-01",
                    "VEH-02",
                    "FUEL-01",
                    "ROCKET-01",
                    "ROCKET-02",
                    "SPACE-01",
                    "QUAL-01",
                    "QUAL-02",
                    "URAN-01",
                    "STACK-01",
                    "STACK-02",
                    "HEALTH-01",
                    "HEALTH-02",
                    "REPAIR-01",
                    "REPAIR-02",
                    "LOG-01",
                    "SLOW-01",
                    "CRAFT-01",
                    "TREE-01",
                    "MACHINE-01",
                    "MACHINE-02",
                    "MACHINE-03",
                    "MODE-01",
                    "MODE-02",
                    "PACK-01",
                    "DEV-01",
                    "K2-01",
                    "K2-02",
                    "K2-03",
                    "K2-04",
                    "K2-05",
                    "K2-06",
                    "K2-07",
                    "BA-01",
                    "BA-02",
                    "BA-03",
                    "BA-04",
                    "BA-05",
                    "BA-06",
                    "BA-07",
                    "BA-08",
                    "BA-09",
                    "BA-10",
                    "BA-11",
                    "BA-12",
                    "BA-13",
                    "BA-14",
                    "BA-15",
                    "BA-16",
                    "ECO-AAI",
                    "ECO-BZ",
                    "ECO-PY",
                    "ECO-SE",
                    "ECO-IR3",
                    "ECO-IR4",
                    "ECO-PLANETS"
                  ]
                }
              },
              "acceptance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "state": {
                "enum": [
                  "queued",
                  "active",
                  "blocked",
                  "complete"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
