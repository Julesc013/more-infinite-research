{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/more-infinite-research/schemas/mir4-4x-operating-programme-v1.schema.json",
  "title": "MIR 4.x operating programme V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "status", "recorded_at", "objective", "permanent_invariants", "work_packages", "package_fixed_point", "outcome_trains", "engine_channels", "wip_limits"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4XOperatingProgrammeV1"},
    "status": {"const": "active"},
    "recorded_at": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "objective": {"type": "string", "minLength": 40},
    "permanent_invariants": {"type": "array", "minItems": 6, "items": {"type": "string"}, "uniqueItems": true},
    "work_packages": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "completion_boundary", "depends_on", "state"],
        "properties": {
          "id": {"pattern": "^M(40|41|42|43|44|45|46)-[0-9]{2}$"},
          "outcome": {"type": "string", "minLength": 8},
          "completion_boundary": {"pattern": "^4\\.(?:0\\.x|[1-9][0-9]*\\.0|[1-9][0-9]*\\.0\\+)$"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "state": {"enum": ["complete", "active", "queued", "blocked-dependency"]}
        }
      }
    },
    "package_fixed_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_package", "phase", "target_results", "aggregate", "next_target", "package_cutover"],
      "properties": {
        "work_package": {"const": "M42-00"},
        "phase": {"const": "M41-F2D"},
        "target_results": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "state", "receipt"],
            "properties": {
              "target": {"enum": ["f210", "f200", "f110", "f100"]},
              "state": {"enum": ["complete", "pending"]},
              "receipt": {"type": ["string", "null"]}
            }
          }
        },
        "aggregate": {"enum": ["pending", "complete"]},
        "next_target": {"type": ["string", "null"], "enum": ["f210", "f200", "f110", "f100", null]},
        "package_cutover": {"enum": ["blocked", "ready", "complete"]}
      }
    },
    "outcome_trains": {"type": "array", "minItems": 5, "items": {"type": "object"}},
    "engine_channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "authority", "selector", "state", "recurring_obligation"],
        "properties": {
          "target": {"const": "f210"},
          "authority": {"const": "spec/engines/mir4-factorio-2.1-experimental-channel-v1.json"},
          "selector": {"const": "latest-installed-official-2.1-experimental"},
          "state": {"const": "active-until-first-official-2.1-stable"},
          "recurring_obligation": {"type": "string", "minLength": 40}
        }
      }
    },
    "wip_limits": {"type": "object"}
  }
}
