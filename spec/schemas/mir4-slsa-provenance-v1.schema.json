{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-slsa-provenance-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": {"pattern": "^mir4-[a-z0-9-]+$"},
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": {
              "sha256": {"pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "predicateType": {"const": "https://slsa.dev/provenance/v1"},
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildDefinition", "runDetails"],
      "properties": {
        "buildDefinition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["buildType", "externalParameters", "internalParameters", "resolvedDependencies"],
          "properties": {
            "buildType": {"format": "uri"},
            "externalParameters": {
              "type": "object",
              "required": ["programme_id", "turn", "state", "component_ids"],
              "properties": {
                "programme_id": {"const": "M4C02-09-24H"},
                "turn": {"const": "T15"},
                "state": {"const": "pre-freeze-supply-chain-preparation"},
                "component_ids": {"type": "array", "minItems": 1}
              }
            },
            "internalParameters": {
              "type": "object",
              "required": ["network", "source_date_epoch", "archive_order", "archive_timestamp", "working_tree_clean"],
              "properties": {
                "network": {"const": "disabled"},
                "source_date_epoch": {"type": "integer", "minimum": 1},
                "archive_order": {"const": "ordinal-path"},
                "archive_timestamp": {"const": "1980-01-01T00:00:00Z"},
                "working_tree_clean": {"type": "boolean"}
              }
            },
            "resolvedDependencies": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "required": ["uri", "digest"],
                "properties": {
                  "uri": {"type": "string", "minLength": 1},
                  "digest": {"type": "object", "minProperties": 1}
                }
              }
            }
          }
        },
        "runDetails": {
          "type": "object",
          "additionalProperties": false,
          "required": ["builder", "metadata", "byproducts"],
          "properties": {
            "builder": {
              "type": "object",
              "required": ["id", "builderDependencies", "version"],
              "properties": {
                "id": {"format": "uri"},
                "builderDependencies": {"type": "array", "minItems": 1},
                "version": {"type": "object", "minProperties": 1}
              }
            },
            "metadata": {
              "type": "object",
              "required": ["invocationId", "startedOn", "finishedOn"],
              "properties": {
                "invocationId": {"type": "string", "minLength": 1},
                "startedOn": {"format": "date-time"},
                "finishedOn": {"format": "date-time"}
              }
            },
            "byproducts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "digest"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "digest": {"type": "object", "minProperties": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
