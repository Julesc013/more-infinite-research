{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.invalid/schemas/mir4-compilation-run-v1.schema.json",
  "title": "MIR 4 Compilation Run V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind","schema","programme_id","target","versions","adapter","maturity","contract_set","platform_profile","environment_lock","target_provider","module_extension_closure","feature_manifest","setting_spec","normalized_facts","graphs","process_ir","policy","claims","resolutions","plans","operations","runtime_state","proof_obligations","bounded_public_projections","merge_law_catalogue","input_digests","stages","result","authoritative_output","mutation_capability","runtime_state_mutation_capability","public_support_claim","diagnostics","digest"],
  "properties": {
    "kind": {"const":"MIR4CompilationRunV1"},
    "schema": {"const":1},
    "programme_id": {"const":"M4C02-09-24H"},
    "target": {"type":"object"},
    "versions": {"type":"object"},
    "adapter": {"const":"LegacyCompilerHostAdapterV1"},
    "maturity": {"const":"shadow"},
    "contract_set": {"type":"object"},
    "platform_profile": {"type":"object"},
    "environment_lock": {"type":"object"},
    "target_provider": {"type":"object"},
    "module_extension_closure": {"type":"object"},
    "feature_manifest": {"type":"object"},
    "setting_spec": {"type":"object"},
    "normalized_facts": {"type":"object"},
    "graphs": {"type":"object"},
    "process_ir": {"type":"object"},
    "policy": {"type":"object"},
    "claims": {"type":"object"},
    "resolutions": {"type":"object"},
    "plans": {"type":"array","minItems":7,"maxItems":7},
    "operations": {"type":"object"},
    "runtime_state": {"type":"object"},
    "proof_obligations": {"type":"array","minItems":6},
    "bounded_public_projections": {"type":"object"},
    "merge_law_catalogue": {"type":"object"},
    "input_digests": {"type":"array","minItems":1},
    "stages": {"type":"array","minItems":7},
    "result": {"enum":["shadow-reference-aggregate-complete","blocked-missing-predecessor-snapshot"]},
    "authoritative_output": {"const":false},
    "mutation_capability": {"const":false},
    "runtime_state_mutation_capability": {"const":false},
    "public_support_claim": {"const":false},
    "diagnostics": {"type":["array","null"]},
    "digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
