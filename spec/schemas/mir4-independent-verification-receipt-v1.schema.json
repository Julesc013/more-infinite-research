{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-independent-verification-receipt-v1.schema.json",
  "title": "MIR 4 independently produced verification receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "producer_id", "independent", "source_commit", "source_tree", "release_plan_digest", "target", "distribution_version", "package_sha256", "engine_sha256", "evidence_sha256", "status", "release_identity", "publication_authorized", "record_sha256"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4IndependentVerificationReceiptV1"},
    "producer_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "independent": {"const": true},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_plan_digest": {"$ref": "#/$defs/sha256"},
    "target": {"enum": ["F210", "F200"]},
    "distribution_version": {"enum": ["4.0.21000", "4.0.20000"]},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "engine_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "passed"},
    "release_identity": {"const": false},
    "publication_authorized": {"const": false},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}
}
