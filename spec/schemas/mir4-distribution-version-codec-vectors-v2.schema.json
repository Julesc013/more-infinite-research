{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.example/schemas/mir4-distribution-version-codec-vectors-v2.schema.json",
  "x-mir-canonical-path": "spec/schemas/mir4-distribution-version-codec-vectors-v2.schema.json",
  "title": "MIR 4 distribution version codec conformance vectors V2",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "status",
    "authority_id",
    "target_registry",
    "version_authority",
    "public_patch_suite",
    "expected_public_target_count",
    "expected_valid_vector_count",
    "expected_invalid_vector_count",
    "valid_vectors",
    "invalid_vectors"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "kind": {
      "const": "MIR4-Distribution-Version-Codec-VectorsV2"
    },
    "status": {
      "const": "accepted-pre-publication-current"
    },
    "authority_id": {
      "const": "MIR4-distribution-version-codec-vectors-v2"
    },
    "target_registry": {
      "const": ".mir/releases/waves/mir4-r0/MIR4-Target-RegistryV2.json"
    },
    "version_authority": {
      "const": ".mir/releases/waves/mir4-r0/MIR4-Versioning-and-Distribution-Identity-ADRv2.json"
    },
    "public_patch_suite": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "00",
          "01",
          "08",
          "09",
          "99"
        ]
      }
    },
    "expected_public_target_count": {
      "const": 17
    },
    "expected_valid_vector_count": {
      "const": 86
    },
    "expected_invalid_vector_count": {
      "const": 8
    },
    "valid_vectors": {
      "type": "array",
      "minItems": 86,
      "maxItems": 86,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "scope",
          "target_id",
          "distribution_target_code",
          "source_minor",
          "source_patch",
          "source_patch_text",
          "source_version",
          "source_tag",
          "encoded_component",
          "encoded_component_text",
          "distribution_version",
          "distribution_tag"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "public-target",
              "internal-boundary"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "distribution_target_code": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "source_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "source_patch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "source_patch_text": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "source_version": {
            "type": "string",
            "pattern": "^4\\.(?:0|[1-9][0-9]{0,4})\\.(?:0|[1-9][0-9]?)$"
          },
          "source_tag": {
            "type": "string",
            "pattern": "^v4\\.(?:0|[1-9][0-9]{0,4})\\.(?:0|[1-9][0-9]?)$"
          },
          "encoded_component": {
            "type": "integer",
            "minimum": 100,
            "maximum": 65499
          },
          "encoded_component_text": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "distribution_version": {
            "type": "string",
            "pattern": "^4\\.(?:0|[1-9][0-9]{0,4})\\.[0-9]{5}$"
          },
          "distribution_tag": {
            "type": "string",
            "pattern": "^dist/f[0-9]{3}/v4\\.(?:0|[1-9][0-9]{0,4})\\.[0-9]{5}$"
          }
        },
        "additionalProperties": false
      }
    },
    "invalid_vectors": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "operation",
          "distribution_target_code",
          "source_patch",
          "encoded_component_text",
          "target_id",
          "expected_error"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "encode",
              "decode",
              "resolve-historical"
            ]
          },
          "distribution_target_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_patch": {
            "type": [
              "integer",
              "null"
            ]
          },
          "encoded_component_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_error": {
            "type": "string",
            "pattern": "^mir4-[a-z-]+$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
