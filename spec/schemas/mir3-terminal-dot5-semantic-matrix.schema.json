{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Julesc013/more-infinite-research/spec/schemas/mir3-terminal-dot5-semantic-matrix.schema.json",
  "title": "MIR 3 immutable .5 cross-target semantic matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "status", "generated_by", "release_order", "releases", "matrices", "unresolved_findings", "completion", "record_sha256"],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "MIR3Dot5SemanticMatrixV1" },
    "status": { "const": "calibration-incomplete-realized-probes-pending" },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "const": "scripts/Export-MIRTerminalBaselineMatrix.ps1" },
        "version": { "const": "1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "release_order": {
      "type": "array",
      "prefixItems": [
        { "const": "3.2.5" }, { "const": "2.5.5" }, { "const": "1.9.5" },
        { "const": "1.8.5" }, { "const": "1.7.5" }, { "const": "1.6.5" },
        { "const": "1.5.5" }, { "const": "1.4.5" }, { "const": "1.3.5" }
      ],
      "minItems": 9,
      "maxItems": 9
    },
    "releases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/release" }
    },
    "matrices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "technologies", "settings", "migrations", "compatibility_claims"],
      "properties": {
        "features": { "$ref": "#/$defs/matrix" },
        "technologies": { "$ref": "#/$defs/matrix" },
        "settings": { "$ref": "#/$defs/matrix" },
        "migrations": { "$ref": "#/$defs/matrix" },
        "compatibility_claims": { "$ref": "#/$defs/matrix" }
      }
    },
    "unresolved_findings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_nine_static_inventories_present", "all_nine_realized_engine_inventories_complete", "contradictions_classified", "queue_completion_permitted"],
      "properties": {
        "all_nine_static_inventories_present": { "const": true },
        "all_nine_realized_engine_inventories_complete": { "const": false },
        "contradictions_classified": { "const": false },
        "queue_completion_permitted": { "const": false }
      }
    },
    "record_sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of canonical UTF-8 LF JSON with record_sha256 omitted." }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inventoryCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "technologies", "settings", "migrations", "compatibility_claims"],
      "properties": {
        "features": { "type": "integer", "minimum": 0 },
        "technologies": { "type": "integer", "minimum": 1 },
        "settings": { "type": "integer", "minimum": 1 },
        "migrations": { "type": "integer", "minimum": 0 },
        "compatibility_claims": { "type": "integer", "minimum": 0 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "target", "archive_sha256", "content_sha256", "baseline_root_sha256", "manifest_record_sha256", "completion_state", "inventory_counts"],
      "properties": {
        "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.5$" },
        "target": { "type": "string", "minLength": 1 },
        "archive_sha256": { "$ref": "#/$defs/sha256" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "baseline_root_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_record_sha256": { "$ref": "#/$defs/sha256" },
        "completion_state": { "const": "calibration-incomplete" },
        "inventory_counts": { "$ref": "#/$defs/inventoryCounts" }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason", "static_fallback_source"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "static_fallback_source": {}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "target", "state", "origin", "target_disposition", "mir4_transition_rule", "source_evidence", "omissions"],
      "properties": {
        "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.5$" },
        "target": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 },
        "target_disposition": { "type": "string", "minLength": 1 },
        "mir4_transition_rule": { "type": "string", "minLength": 1 },
        "source_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "omissions": { "type": "array", "items": { "$ref": "#/$defs/omission" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "cells"],
      "properties": {
        "stable_id": { "type": "string", "minLength": 1 },
        "cells": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/cell" } }
      }
    },
    "matrix": { "type": "array", "items": { "$ref": "#/$defs/row" } }
  },
  "x-mir-canonical-path": "spec/schemas/mir3-terminal-dot5-semantic-matrix.schema.json"
}
