{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/more-infinite-research/schemas/mir4-proof-applicability-v1.schema.json",
  "title": "MIR 4 proof applicability V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "status", "default_policy", "propositions"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4ProofApplicabilityV1"},
    "status": {"const": "accepted"},
    "default_policy": {"const": "undeclared-context-is-inapplicable"},
    "propositions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "valid_events", "trust_classes", "ref_topologies", "credential_classes", "environment_classes", "evidence_modes", "production_authority"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "valid_events": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "trust_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "ref_topologies": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "credential_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "environment_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "evidence_modes": {"type": "array", "minItems": 1, "items": {"enum": ["simulation", "realization"]}, "uniqueItems": true},
          "production_authority": {"type": "boolean"}
        }
      }
    }
  }
}
