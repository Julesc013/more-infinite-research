{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-release-independent-verification-result-v1.schema.json",
  "title": "MIR 4 independent-verification phase result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "phase", "phase_result_kind", "operation", "status", "idempotency_key", "artifact_root", "production_mutation_performed", "release_transition_performed", "targets", "independent_receipts_adopted", "artifacts", "checks"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4ReleasePhaseAdapterResultV1"},
    "phase": {"const": "independent-verification"},
    "phase_result_kind": {"const": "MIR4IndependentVerificationPhaseResultV1"},
    "operation": {"enum": ["DryRun", "Execute", "Verify", "Compensate"]},
    "status": {"const": "passed"},
    "idempotency_key": {"$ref": "#/$defs/sha256"},
    "artifact_root": {"type": "string", "pattern": "^build/mir4/release-phase-engine/"},
    "production_mutation_performed": {"const": false},
    "release_transition_performed": {"const": false},
    "targets": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "distribution_version", "state", "package_sha256", "engine_sha256", "evidence_sha256", "receipt", "independent", "release_identity", "publication_authorized"],
        "properties": {
          "target": {"enum": ["F210", "F200"]},
          "distribution_version": {"enum": ["4.0.21000", "4.0.20000"]},
          "state": {"enum": ["planned-independent-import", "independently-verified-private"]},
          "package_sha256": {"$ref": "#/$defs/sha256"},
          "engine_sha256": {"$ref": "#/$defs/sha256"},
          "evidence_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
          "receipt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
          "independent": {"const": true},
          "release_identity": {"const": false},
          "publication_authorized": {"const": false}
        }
      }
    },
    "independent_receipts_adopted": {"type": "integer", "minimum": 0, "maximum": 2},
    "artifacts": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "checks": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}}
    }
  }
}
