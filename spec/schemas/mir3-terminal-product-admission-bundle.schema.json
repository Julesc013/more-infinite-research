{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.example/schemas/mir3-terminal-product-admission-bundle.schema.json",
  "x-mir-canonical-path": "spec/schemas/mir3-terminal-product-admission-bundle.schema.json",
  "title": "MIR 3 terminal product admission bundle",
  "type": "object",
  "required": ["schema", "kind", "status", "admitted_at", "scope", "input_authorities", "accepted_findings", "rejected_or_deferred", "all_nine_dispositions", "claim_changes_required", "documentation_obligations", "ordinary_intake", "boundaries", "next_required_state"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR3TerminalProductAdmissionBundleV1"},
    "status": {"const": "accepted-implementation-admitted-source-unfrozen"},
    "admitted_at": {"type": "string", "format": "date-time"},
    "scope": {"const": "smallest-defensible-mir3-dot9-product-set"},
    "input_authorities": {"type":"object","minProperties":10,"additionalProperties":{"type":"string","minLength":1}},
    "accepted_findings": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type":"object","required":["id","title","implementation_contract","affected_targets","stable_id_and_migration_impact","required_regressions","fixed_point_scope"],"properties":{"id":{"enum":["MIR3-TERM-0027","MIR3-TERM-0028"]},"title":{"type":"string","minLength":1},"implementation_contract":{"enum":["K2SciencePhasePolicyV1","SciencePackProductionRoutePolicyV1"]},"affected_targets":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["3.2.9","2.5.9"]}},"exact_envelope":{"type":"object"},"required_properties":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"generic_invariant":{"type":"string","minLength":1},"route_fields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"selection_order":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"stable_id_and_migration_impact":{"type":"string","minLength":1},"required_regressions":{"type":"array","minItems":7,"uniqueItems":true,"items":{"type":"string","minLength":1}},"fixed_point_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["3.2.9","2.5.9"]}}},"additionalProperties":false}
    },
    "rejected_or_deferred": {"type":"array","minItems":6,"items":{"type":"object","required":["id","disposition","reason"],"properties":{"id":{"type":"string","minLength":1},"disposition":{"enum":["not-reproduced","upstream-blocked","support-claim-narrowed","rejected-with-reason","mir4-deferred"]},"reason":{"type":"string","minLength":1}},"additionalProperties":false}},
    "all_nine_dispositions": {"type":"array","minItems":9,"maxItems":9,"items":{"type":"object","required":["release","findings","projection"],"properties":{"release":{"enum":["3.2.9","2.5.9","1.9.9","1.8.9","1.7.9","1.6.9","1.5.9","1.4.9","1.3.9"]},"findings":{"type":"array","uniqueItems":true,"items":{"enum":["MIR3-TERM-0027","MIR3-TERM-0028"]}},"projection":{"type":"string","minLength":1}},"additionalProperties":false}},
    "claim_changes_required": {"type":"array","minItems":3,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "documentation_obligations": {"type":"array","minItems":6,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "ordinary_intake": {"type":"object","required":["closed","late_release_blocking_p0_or_p1","late_nonblocking"],"properties":{"closed":{"const":true},"late_release_blocking_p0_or_p1":{"const":"reopen-only-explicitly-affected-targets-with-reproduced-finding"},"late_nonblocking":{"const":"MIR4-intake"}},"additionalProperties":false},
    "boundaries": {"type":"object","required":["implementation_admitted","source_frozen","candidate_assigned","dot5_package_mutation_permitted","assurance_reopened","mir4_package_visible_implementation_permitted","tagging_or_publication_permitted"],"properties":{"implementation_admitted":{"const":true},"source_frozen":{"const":false},"candidate_assigned":{"const":false},"dot5_package_mutation_permitted":{"const":false},"assurance_reopened":{"const":false},"mir4_package_visible_implementation_permitted":{"const":false},"tagging_or_publication_permitted":{"const":false}},"additionalProperties":false},
    "next_required_state": {"const": "PRODUCT_IMPLEMENTATION_COMPLETE"}
  },
  "additionalProperties": false
}
