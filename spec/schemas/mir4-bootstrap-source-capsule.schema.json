{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-bootstrap-source-capsule.schema.json",
  "title": "MIR 4 bootstrap source capsule V2 detached envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "status", "canonicalization", "public_output_authorized", "lane", "target_key", "factorio_line", "distribution_version", "source", "predecessor", "package_membership", "closure", "bootstrap_runner", "capsule", "record_sha256"],
  "properties": {
    "schema": { "const": 2 },
    "kind": { "const": "MIR4BootstrapSourceCapsuleV2" },
    "status": { "const": "local-unpublished-input" },
    "canonicalization": { "const": "MIR4BootstrapCanonicalJsonV1" },
    "public_output_authorized": { "const": false },
    "lane": { "enum": ["emergency", "local-playtest-shadow"] },
    "target_key": { "enum": ["f210", "f200", "f110", "f100"] },
    "factorio_line": { "enum": ["2.1", "2.0", "1.1", "1.0"] },
    "distribution_version": { "enum": ["4.0.21000", "4.0.20000", "4.0.11000", "4.0.10000"] },
    "source": { "$ref": "#/$defs/source" },
    "predecessor": { "$ref": "#/$defs/predecessor" },
    "correction_authority": { "$ref": "#/$defs/correctionAuthority" },
    "local_lane_authority": { "$ref": "#/$defs/laneAuthority" },
    "package_membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "authority_sha256", "capsule_tool", "capsule_tool_sha256", "shipped_sidecars", "evidence_inside_package"],
      "properties": {
        "authority": { "const": "tools/lib/validation/PackageIdentity.ps1#Get-MIRPackageSourceRoots" },
        "authority_sha256": { "$ref": "#/$defs/sha256" },
        "capsule_tool": { "const": "tools/lib/mir4/BootstrapMaterialization.ps1#New-MIR4BootstrapSourceCapsule" },
        "capsule_tool_sha256": { "$ref": "#/$defs/sha256" },
        "shipped_sidecars": { "const": [] },
        "evidence_inside_package": { "const": false }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal_manifest_record_sha256", "payload_root_sha256", "capsule_content_root_sha256", "authority_closure_root_sha256", "git_source_proof_record_sha256", "toolchain_lock_record_sha256", "canonical_builder_sha256", "reconstruction_runner_sha256"],
      "properties": {
        "internal_manifest_record_sha256": { "$ref": "#/$defs/sha256" },
        "payload_root_sha256": { "$ref": "#/$defs/sha256" },
        "capsule_content_root_sha256": { "$ref": "#/$defs/sha256" },
        "authority_closure_root_sha256": { "$ref": "#/$defs/sha256" },
        "git_source_proof_record_sha256": { "$ref": "#/$defs/sha256" },
        "toolchain_lock_record_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_builder_sha256": { "$ref": "#/$defs/sha256" },
        "reconstruction_runner_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bootstrap_runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capsule_path", "detached_path", "sha256", "bytes"],
      "properties": {
        "capsule_path": { "const": "tools/commands/release/Invoke-MIR4BootstrapCapsule.ps1" },
        "detached_path": { "const": "Invoke-MIR4BootstrapCapsule.ps1" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "capsule": { "$ref": "#/$defs/artifact" },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "lane": { "const": "emergency" } }, "required": ["lane"] }, "then": { "not": { "required": ["local_lane_authority"] }, "properties": { "target_key": { "const": "f210" }, "factorio_line": { "const": "2.1" }, "distribution_version": { "const": "4.0.21000" } } } },
    { "if": { "properties": { "lane": { "const": "local-playtest-shadow" } }, "required": ["lane"] }, "then": { "required": ["local_lane_authority"], "not": { "required": ["correction_authority"] }, "properties": { "target_key": { "enum": ["f200", "f110", "f100"] } } } },
    { "if": { "properties": { "target_key": { "const": "f200" } }, "required": ["target_key"] }, "then": { "properties": { "factorio_line": { "const": "2.0" }, "distribution_version": { "const": "4.0.20000" } } } },
    { "if": { "properties": { "target_key": { "const": "f110" } }, "required": ["target_key"] }, "then": { "properties": { "factorio_line": { "const": "1.1" }, "distribution_version": { "const": "4.0.11000" } } } },
    { "if": { "properties": { "target_key": { "const": "f100" } }, "required": ["target_key"] }, "then": { "properties": { "factorio_line": { "const": "1.0" }, "distribution_version": { "const": "4.0.10000" } } } }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "gitSha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_commit", "source_tree", "common_source_commit"],
      "properties": {
        "candidate_commit": { "$ref": "#/$defs/gitSha1" },
        "source_tree": { "$ref": "#/$defs/gitSha1" },
        "common_source_commit": { "$ref": "#/$defs/gitSha1" }
      }
    },
    "correctionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "finding", "record_sha256"],
      "properties": {
        "path": { "const": ".mir/releases/waves/mir4-r0/MIR4-Approved-Bootstrap-Correction-CompositeV2.json" },
        "kind": { "const": "MIR4ApprovedBootstrapCorrectionDeltaV2" },
        "finding": { "const": "MIR3-TERM-0032+MIR3-TERM-0033" },
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "laneAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "authority_family", "record_sha256"],
      "properties": {
        "path": { "const": ".mir/releases/waves/mir4-r0/MIR4-Private-Lane-AuthorizationV3.json" },
        "kind": { "const": "MIR4PrivateLaneAuthorizationV3" },
        "authority_family": { "const": "MIRLocalArtifactLaneAuthorizationV1" },
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "archive_path", "archive_sha256", "content_sha256", "bytes", "entry_count", "baseline_manifest", "baseline_record_sha256", "normalized_snapshot", "snapshot_record_sha256"],
      "properties": {
        "release": { "enum": ["3.2.11", "2.5.11", "1.9.9", "1.8.9"] },
        "archive_path": { "pattern": "^dist/more-infinite-research_(3\\.2\\.11|2\\.5\\.11|1\\.9\\.9|1\\.8\\.9)\\.zip$" },
        "archive_sha256": { "$ref": "#/$defs/sha256" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "entry_count": { "type": "integer", "minimum": 1 },
        "baseline_manifest": { "type": "string" },
        "baseline_record_sha256": { "$ref": "#/$defs/sha256" },
        "normalized_snapshot": { "type": "string" },
        "snapshot_record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "archive_sha256", "content_sha256", "bytes", "entry_count"],
      "properties": {
        "path": { "const": "source-capsule.zip" },
        "archive_sha256": { "$ref": "#/$defs/sha256" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "entry_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
