{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.more-infinite-research.invalid/package/mir4-package-source-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "materializer_abi", "source_state", "baseline_record_sha256", "source_roots", "bindings", "invariants", "record_sha256"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4PackageSourceManifestV1"},
    "materializer_abi": {"const": "mir4-target-materializer/1"},
    "source_state": {"const": "canonical-editable-package-source"},
    "baseline_record_sha256": {"const": "A9CFA8C4F8E799BD1B543EB8F2EC7DACF136730A098CC71D8206A9F83AB6AB8A"},
    "source_roots": {"const": ["src/mod/common", "src/mod/families", "src/mod/generation", "targets/<target>/files", "targets/<target>/generation"]},
    "bindings": {"type": "array", "minItems": 429, "maxItems": 429, "items": {"$ref": "#/$defs/binding"}},
    "invariants": {"type": "object", "additionalProperties": false, "required": ["one_binding_per_layer_path", "historical_archives_not_production_inputs", "no_target_full_source_copy", "package_cutover_complete"], "properties": {"one_binding_per_layer_path": {"const": true}, "historical_archives_not_production_inputs": {"const": true}, "no_target_full_source_copy": {"const": true}, "package_cutover_complete": {"const": true}}},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["layer", "target_scope", "output_path", "semantic_class", "source_path", "transform", "source_bytes", "source_sha256", "output_bytes", "output_sha256"], "properties": {"layer": {"pattern": "^(?:common|families[.](?:modern|legacy)|targets[.]f(?:210|200|110|100))$"}, "target_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["f210", "f200", "f110", "f100"]}}, "output_path": {"type": "string", "minLength": 1}, "semantic_class": {"enum": ["common-semantic-source", "common-asset-locale", "generated-metadata", "generated-lifecycle-entrypoint", "target-overlay", "target-replacement", "target-compatibility-shim", "migration", "package-documentation"]}, "source_path": {"pattern": "^(?:src/mod/|targets/f(?:210|200|110|100)/(?:files|generation)/).+"}, "transform": {"enum": ["copy-exact-bytes", "decode-base64-v1", "exact-template-v1"]}, "source_bytes": {"type": "integer", "minimum": 0}, "source_sha256": {"$ref": "#/$defs/sha256"}, "output_bytes": {"type": "integer", "minimum": 0}, "output_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
