{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.invalid/mir4-synthesis-maturity-matrix-v1.schema.json",
  "title": "MIR 4 synthesis maturity matrix V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "programme_id", "source_identity", "authority", "maturity", "constructors", "terminal_dispositions", "terminal_disposition_source_note", "modes", "candidates", "advanced_ecosystems", "automatic_player_mutation", "package_visible", "public_release_proof", "player_mutation_authorized", "digest"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4SynthesisMaturityMatrixV1"},
    "programme_id": {"const": "M4C02-09-24H"},
    "source_identity": {"type": "object", "required": ["commit", "tree", "programme_id"]},
    "authority": {"type": "string"},
    "maturity": {"const": "developer-preview"},
    "constructors": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true},
    "terminal_dispositions": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true},
    "terminal_disposition_source_note": {"type": "string", "minLength": 1},
    "modes": {"type": "array", "minItems": 3, "maxItems": 3},
    "candidates": {"type": "array", "minItems": 12, "items": {"type": "object", "required": ["id", "constructor", "mode", "assessment", "disposition", "certainty", "mutation_authorized", "certificate_gate"]}},
    "advanced_ecosystems": {"type": "array", "minItems": 4, "maxItems": 4},
    "automatic_player_mutation": {"const": false},
    "package_visible": {"const": false},
    "public_release_proof": {"const": false},
    "player_mutation_authorized": {"const": false},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
