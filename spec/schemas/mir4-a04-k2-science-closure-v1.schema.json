{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir4-a04-k2-science-closure-v1.schema.json",
  "title": "MIR4 A04 K2 science reload closure V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "recorded_at", "task", "status", "runtime_proof", "candidate", "engine", "mod_closure", "source_authorities", "lineage", "controlled_witness", "patch_eligibility", "compatibility_audit_evolution", "authority_flags", "non_claims", "record_sha256"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4A04K2ScienceClosureV1"},
    "recorded_at": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T"},
    "task": {"const": "A04"},
    "status": {"const": "passed"},
    "runtime_proof": {"$ref": "#/$defs/recordBinding"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "engine": {"$ref": "#/$defs/engine"},
    "mod_closure": {"$ref": "#/$defs/modClosure"},
    "source_authorities": {"$ref": "#/$defs/sourceAuthorities"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "controlled_witness": {"$ref": "#/$defs/controlledWitness"},
    "patch_eligibility": {"$ref": "#/$defs/patchEligibility"},
    "compatibility_audit_evolution": {"$ref": "#/$defs/evolution"},
    "authority_flags": {"$ref": "#/$defs/authorityFlags"},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "record_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "sourceArtifact": {"type": "object", "additionalProperties": false, "required": ["path", "canonical_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "canonical_sha256": {"$ref": "#/$defs/sha"}}},
    "rawBinding": {"type": "object", "additionalProperties": false, "required": ["path", "raw_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "raw_sha256": {"$ref": "#/$defs/sha"}}},
    "recordBinding": {"type": "object", "additionalProperties": false, "required": ["path", "raw_sha256", "record_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "raw_sha256": {"$ref": "#/$defs/sha"}, "record_sha256": {"$ref": "#/$defs/sha"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["archive_sha256", "content_sha256", "bytes", "entries", "source_commit", "source_tree"], "properties": {"archive_sha256": {"$ref": "#/$defs/sha"}, "content_sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 1}, "entries": {"type": "integer", "minimum": 1}, "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}},
    "engine": {"type": "object", "additionalProperties": false, "required": ["line", "version", "executable_sha256"], "properties": {"line": {"const": "2.1"}, "version": {"const": "2.1.17.87315"}, "executable_sha256": {"$ref": "#/$defs/sha"}}},
    "archive": {"type": "object", "additionalProperties": false, "required": ["name", "version", "sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "modClosure": {"type": "object", "additionalProperties": false, "required": ["enabled_mods", "external_archives"], "properties": {"enabled_mods": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "external_archives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/archive"}}}},
    "sourceAuthorities": {"type": "object", "additionalProperties": false, "required": ["policy", "planner", "scenario", "fixture"], "properties": {"policy": {"$ref": "#/$defs/sourceArtifact"}, "planner": {"$ref": "#/$defs/sourceArtifact"}, "scenario": {"$ref": "#/$defs/sourceArtifact"}, "fixture": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/sourceArtifact"}}}},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["a03_lock", "a03_execution_proof", "a03_dossier", "a03_receipt"], "properties": {"a03_lock": {"$ref": "#/$defs/rawBinding"}, "a03_execution_proof": {"$ref": "#/$defs/recordBinding"}, "a03_dossier": {"$ref": "#/$defs/recordBinding"}, "a03_receipt": {"$ref": "#/$defs/recordBinding"}}},
    "compatModule": {"type": "object", "additionalProperties": false, "required": ["path", "canonical_sha256", "lines", "function_names", "function_projection_sha256", "parse_errors"], "properties": {"path": {"$ref": "#/$defs/path"}, "canonical_sha256": {"$ref": "#/$defs/sha"}, "lines": {"type": "integer", "minimum": 1}, "function_names": {"type": "array", "items": {"type": "string", "minLength": 1}}, "function_projection_sha256": {"$ref": "#/$defs/sha"}, "parse_errors": {"const": 0}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["path", "raw_sha256", "canonical_sha256", "digest", "command_count"], "properties": {"path": {"const": "governance/automation/mir4-command-inventory-v1.json"}, "raw_sha256": {"$ref": "#/$defs/sha"}, "canonical_sha256": {"$ref": "#/$defs/sha"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "command_count": {"type": "integer", "minimum": 1}}},
    "evolution": {"type": "object", "additionalProperties": false, "required": ["historical_receipt", "modules", "aggregate_function_projection_sha256", "facade", "reload_semantics", "command_inventory"], "properties": {"historical_receipt": {"$ref": "#/$defs/recordBinding"}, "modules": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/compatModule"}}, "aggregate_function_projection_sha256": {"$ref": "#/$defs/sha"}, "facade": {"type": "object", "additionalProperties": false, "required": ["path", "canonical_sha256", "lines", "historical_parameter_surface_sha256", "current_parameter_surface_sha256", "parameter_surface_unchanged"], "properties": {"path": {"const": "tools/commands/compatibility/Invoke-MIRCompatAudit.ps1"}, "canonical_sha256": {"$ref": "#/$defs/sha"}, "lines": {"type": "integer", "minimum": 1}, "historical_parameter_surface_sha256": {"$ref": "#/$defs/sha"}, "current_parameter_surface_sha256": {"$ref": "#/$defs/sha"}, "parameter_surface_unchanged": {"const": true}}}, "reload_semantics": {"type": "object", "additionalProperties": false, "required": ["scenario_schema", "activation", "runtime_fixtures_default", "required_reload_count_default", "max_reload_duration_seconds_default", "required_reload_log_fragments_default", "required_reload_count_minimum", "required_reload_count_maximum", "reload_duration_minimum", "reload_duration_maximum", "default_behavior_unchanged"], "properties": {"scenario_schema": {"const": 2}, "activation": {"const": "explicit-manual-scenario-opt-in-only"}, "runtime_fixtures_default": {"const": []}, "required_reload_count_default": {"const": 0}, "max_reload_duration_seconds_default": {"const": 0}, "required_reload_log_fragments_default": {"const": []}, "required_reload_count_minimum": {"const": 0}, "required_reload_count_maximum": {"const": 2}, "reload_duration_minimum": {"const": 1}, "reload_duration_maximum": {"const": 3600}, "default_behavior_unchanged": {"const": true}}}, "command_inventory": {"$ref": "#/$defs/inventory"}}},
    "controlledWitness": {"type": "object", "additionalProperties": false, "required": ["test", "harness", "result", "log", "status", "scope", "assertions", "configured", "additive", "required", "reduce", "skip", "default"], "properties": {"test": {"$ref": "#/$defs/rawBinding"}, "harness": {"$ref": "#/$defs/rawBinding"}, "result": {"$ref": "#/$defs/rawBinding"}, "log": {"$ref": "#/$defs/rawBinding"}, "status": {"const": "passed"}, "scope": {"const": "controlled-modules-not-real-k2-qualification"}, "assertions": {"const": 33}, "configured": {"const": true}, "additive": {"const": true}, "required": {"const": true}, "reduce": {"const": true}, "skip": {"const": true}, "default": {"const": true}}},
    "patchEligibility": {"type": "object", "additionalProperties": false, "required": ["classification", "reason", "k2_request", "delivery_rule", "a03_candidate", "runtime_proof"], "properties": {"classification": {"const": "not-eligible-for-4.1.x-patch"}, "reason": {"const": "No independent reproduction binds the reported defect to the published 4.1 package, and A04 introduces no package-visible correction: the immutable 4.2 development candidate already contains shipped F210 K2SciencePhasePolicyV1 and passes exact final-emission, progression, and two-reload proof. Retain K2-01 in the 4.2 feature train."}, "k2_request": {"$ref": "#/$defs/sourceArtifact"}, "delivery_rule": {"$ref": "#/$defs/sourceArtifact"}, "a03_candidate": {"$ref": "#/$defs/recordBinding"}, "runtime_proof": {"$ref": "#/$defs/recordBinding"}}},
    "authorityFlags": {"type": "object", "additionalProperties": false, "required": ["player_mutation_authorized", "prototype_write_authorized", "public_support_authorized", "release_authority", "signing_authority", "publication_authority"], "properties": {"player_mutation_authorized": {"const": false}, "prototype_write_authorized": {"const": false}, "public_support_authorized": {"const": false}, "release_authority": {"const": false}, "signing_authority": {"const": false}, "publication_authority": {"const": false}}}
  }
}