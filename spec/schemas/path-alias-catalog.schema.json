{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/more-infinite-research/schemas/path-alias-catalog.schema.json",
  "title": "PathAliasCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "aliases"],
  "properties": {
    "schema": {"const": 1},
    "authority": {"const": "mir-repository-path-aliases-v1"},
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "mode", "introduced"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[^\\\\]+$",
            "description": "A directory prefix when ending in '/', otherwise an exact file alias."
          },
          "to": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
          "mode": {"enum": ["historical-read-only", "read-only", "local-read-only"]},
          "introduced": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
        }
      }
    }
  }
}
