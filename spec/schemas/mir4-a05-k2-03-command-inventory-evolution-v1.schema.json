{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"mir4-a05-k2-03-command-inventory-evolution-v1.schema.json",
  "title":"MIR4 A05 K2-03 command inventory evolution V1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","kind","recorded_at","task","status","predecessor","current","transition","authority_flags","record_sha256"],
  "properties":{
    "schema":{"const":1},
    "kind":{"const":"MIR4A05K203CommandInventoryEvolutionV1"},
    "recorded_at":{"type":"string","pattern":"^20[0-9]{2}-[0-9]{2}-[0-9]{2}T"},
    "task":{"const":"A05/K2-03"},
    "status":{"const":"append-only-successor-passed"},
    "predecessor":{"type":"object","additionalProperties":false,"required":["a04_closure","inventory"],"properties":{"a04_closure":{"$ref":"#/$defs/recordBinding"},"inventory":{"$ref":"#/$defs/inventory"}}},
    "current":{"$ref":"#/$defs/inventory"},
    "transition":{"type":"object","additionalProperties":false,"required":["classification","added_implementation_files","reconstructed_predecessor_sha256","public_command_count_unchanged","non_added_summary_counts_unchanged","transition_gates_remain_closed"],"properties":{"classification":{"const":"append-only-one-canonical-internal-writer"},"added_implementation_files":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/implementation"}},"reconstructed_predecessor_sha256":{"$ref":"#/$defs/sha"},"public_command_count_unchanged":{"const":true},"non_added_summary_counts_unchanged":{"const":true},"transition_gates_remain_closed":{"const":true}}},
    "authority_flags":{"type":"object","additionalProperties":false,"required":["public_command_authority","player_mutation_authorized","release_authority","signing_authority","publication_authority"],"properties":{"public_command_authority":{"const":false},"player_mutation_authorized":{"const":false},"release_authority":{"const":false},"signing_authority":{"const":false},"publication_authority":{"const":false}}},
    "record_sha256":{"$ref":"#/$defs/sha"}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[A-F0-9]{64}$"},
    "path":{"type":"string","pattern":"^[A-Za-z0-9._/-]+$"},
    "recordBinding":{"type":"object","additionalProperties":false,"required":["path","raw_sha256","record_sha256"],"properties":{"path":{"$ref":"#/$defs/path"},"raw_sha256":{"$ref":"#/$defs/sha"},"record_sha256":{"$ref":"#/$defs/sha"}}},
    "inventory":{"type":"object","additionalProperties":false,"required":["path","raw_sha256","canonical_sha256","digest","command_count","canonical_internal_count"],"properties":{"path":{"const":"governance/automation/mir4-command-inventory-v1.json"},"raw_sha256":{"$ref":"#/$defs/sha"},"canonical_sha256":{"$ref":"#/$defs/sha"},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"command_count":{"const":85},"canonical_internal_count":{"enum":[378,379]}}},
    "implementation":{"type":"object","additionalProperties":false,"required":["path","classification","sha256","hash_mode","lines","package_visible"],"properties":{"path":{"const":"tools/commands/mir4/Write-MIR4A05K203ImersiteClosure.ps1"},"classification":{"const":"canonical-internal"},"sha256":{"$ref":"#/$defs/sha"},"hash_mode":{"const":"canonical-text-v1"},"lines":{"type":"integer","minimum":1},"package_visible":{"const":false}}}
  }
}