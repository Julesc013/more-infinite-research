{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.example/schemas/mir3-mod-interaction-matrix.schema.json",
  "x-mir-canonical-path": "spec/schemas/mir3-mod-interaction-matrix.schema.json",
  "title": "MIR 3 terminal Mod Portal interaction matrix",
  "type": "object",
  "required": ["schema", "kind", "status", "recorded_at", "policy", "rows", "rule"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR3-Mod-Interaction-MatrixV1"},
    "status": {"const": "tier-a-overlap-classified-qualification-pending"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "policy": {"const": ".mir/mod-interaction-policy.json"},
    "rows": {"type": "array", "minItems": 16, "maxItems": 16, "uniqueItems": true, "items": {"type": "object", "required": ["id", "mods", "shared_surfaces", "classification", "required_campaign"], "properties": {"id": {"type": "string"}, "mods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "shared_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "classification": {"type": "string"}, "required_campaign": {"type": "string"}}, "additionalProperties": false}},
    "rule": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
