{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/more-infinite-research/schemas/repository-path-catalog.schema.json",
  "title": "RepoPathCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "paths"],
  "properties": {
    "schema": {"const": 1},
    "authority": {"const": "mir-repository-paths-v1"},
    "paths": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:\\.|[a-z0-9.][a-z0-9./-]*)$"
      }
    }
  }
}
