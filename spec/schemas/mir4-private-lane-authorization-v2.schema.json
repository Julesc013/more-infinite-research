{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-private-lane-authorization-v2.schema.json",
  "title": "MIR 4 private local-playtest lane authorization V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "authority_family", "status", "canonicalization", "approved_by", "package_visible", "semantic_authority", "semantic_difference_authorized", "release_admission_authorized", "public_identity_authorized", "public_output_authorized", "signing_or_sealing_authorized", "publication_authorized", "wildcard_targets_authorized", "gate_waivers_authorized", "output_root", "supersedes", "imports", "authorized_targets", "allowed_operations", "allowed_statuses", "forbidden_operations", "private_transfer", "expiry", "rollback", "hard_boundary", "record_sha256"],
  "properties": {
