    "approved_by": { "const": "explicit-maintainer-bounded-authorization-2026-08-17" },
    "package_visible": { "const": false },
    "semantic_authority": { "const": false },
    "semantic_difference_authorized": { "const": false },
    "release_admission_authorized": { "const": false },
    "public_identity_authorized": { "const": false },
    "public_output_authorized": { "const": false },
    "signing_or_sealing_authorized": { "const": false },
    "publication_authorized": { "const": false },
    "wildcard_targets_authorized": { "const": false },
    "gate_waivers_authorized": { "const": false },
    "output_root": { "const": "build/mir4/local-playtest-shadow" },
    "supersedes": {
      "const": {
        "path": ".mir/releases/waves/mir4-r0/MIR4-Local-Playtest-Shadow-AuthorizationV1.json",
