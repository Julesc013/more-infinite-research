        "approved_correction_composite": { "allOf": [{ "$ref": "#/$defs/recordImport" }, { "properties": { "path": { "const": ".mir/releases/waves/mir4-r0/MIR4-Approved-Bootstrap-Correction-CompositeV2.json" }, "record_sha256": { "const": "ECD4C0A3C3207ACA7E121FD83D6F09CC172D4A601BA90FED659559FE1BC0851A" } } }] }
      }
