{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-release-workflow-contract-v1.schema.json",
  "type": "object",
  "required": ["schema", "kind", "primary_inputs", "ad_hoc_archive_hash_input_forbidden", "target_matrix", "phase_engine", "phases", "current_gate"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4ReleaseWorkflowContractV1"},
    "primary_inputs": {
      "type": "array",
      "minItems": 8,
      "allOf": [
        {"contains": {"const": "source_release_record"}},
        {"contains": {"const": "candidate_id"}},
        {"contains": {"const": "source_commit"}},
        {"contains": {"const": "source_tree"}},
        {"contains": {"const": "target_distribution_record_set"}},
        {"contains": {"const": "release_plan_digest"}},
        {"contains": {"const": "proof_root"}},
        {"contains": {"const": "seal_root"}}
      ]
    },
    "ad_hoc_archive_hash_input_forbidden": {"const": true},
    "target_matrix": {
      "type": "object",
      "required": ["mandatory", "conditional", "target_receipt_required", "family_readiness_is_target_receipt_fold"],
      "properties": {
        "mandatory": {"const": ["F210", "F200"]},
        "conditional": {"const": ["F110", "F100"]},
        "target_receipt_required": {"const": true},
        "family_readiness_is_target_receipt_fold": {"const": true}
      }
    },
    "phase_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "implementation", "kernel_implemented", "event_sourcing_implemented", "idempotency_and_resume_tested", "production_capable", "production_authorized"],
      "properties": {
        "contract": {"const": ".mir/releases/waves/mir4-r0/MIR4-Release-Phase-Engine-ContractV1.json"},
        "implementation": {"const": "tools/lib/mir4/ReleasePhaseEngine.ps1"},
        "kernel_implemented": {"const": true},
        "event_sourcing_implemented": {"const": true},
        "idempotency_and_resume_tested": {"const": true},
        "production_capable": {"const": false},
        "production_authorized": {"const": false}
      }
    },
    "phases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "workflow", "production_transition", "maturity"],
        "properties": {
          "id": {"enum": ["source-freeze", "target-build", "target-qualification", "preview-assets", "independent-verification", "release-seal", "promotion", "target-publication", "public-readback", "restore-drill"]},
          "workflow": {"pattern": "^\\.github/workflows/mir4-[a-z-]+\\.yml$"},
          "production_transition": {"type": "boolean"},
          "maturity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workflow_registered",
              "workflow_fail_closed",
              "workflow_executor_implemented",
              "workflow_dry_run_passed",
              "workflow_production_rehearsal_passed",
              "workflow_production_authorized"
            ],
            "properties": {
              "workflow_registered": {"const": true},
              "workflow_fail_closed": {"const": true},
              "workflow_executor_implemented": {"type": "boolean"},
              "workflow_dry_run_passed": {"type": "boolean"},
              "workflow_production_rehearsal_passed": {"type": "boolean"},
              "workflow_production_authorized": {"const": false}
            }
          }
        }
      }
    },
    "current_gate": {
      "type": "object",
      "required": ["state", "source_freeze_authorized", "candidate_allocation_authorized", "production_signing_authorized", "promotion_authorized", "publication_authorized", "fail_closed"],
      "properties": {
        "state": {"const": "DEV-READINESS-AUTHORIZED-RELEASE-BLOCKED"},
        "source_freeze_authorized": {"const": false},
        "candidate_allocation_authorized": {"const": false},
        "production_signing_authorized": {"const": false},
        "promotion_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "fail_closed": {"const": true}
      }
    }
  }
}
