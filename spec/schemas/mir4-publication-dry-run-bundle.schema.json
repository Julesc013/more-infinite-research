{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.example/schemas/mir4-publication-dry-run-bundle.schema.json",
  "x-mir-canonical-path": "spec/schemas/mir4-publication-dry-run-bundle.schema.json",
  "title": "MIR4PublicationDryRunBundleV1",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "canonicalization",
    "mode",
    "mutating",
    "network_required",
    "apply_allowed",
    "publication_authority",
    "seal",
    "source_identity",
    "distribution_identity",
    "identity_authorities",
    "candidate",
    "release",
    "channel_requests",
    "rollback",
    "readback_verification",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4PublicationDryRunBundleV1"},
    "canonicalization": {"const": "MIR4BootstrapCanonicalJsonV1"},
    "mode": {"const": "dry-run"},
    "mutating": {"const": false},
    "network_required": {"const": false},
    "apply_allowed": {"const": false},
    "publication_authority": {"const": false},
    "seal": {"$ref": "#/$defs/sealBinding"},
    "source_identity": {
      "type": "object",
      "required": ["version", "proposed_tag"],
      "properties": {
        "version": {"type": "string", "pattern": "^4\\.[0-9]+\\.[0-9]+$"},
        "proposed_tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"}
      },
      "additionalProperties": false
    },
    "distribution_identity": {
      "type": "object",
      "required": ["target_id", "version", "proposed_tag"],
      "properties": {
        "target_id": {"$ref": "#/$defs/target"},
        "version": {"$ref": "#/$defs/distributionVersion"},
        "proposed_tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"}
      },
      "additionalProperties": false
    },
    "identity_authorities": {"$ref": "#/$defs/identityAuthorities"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "release": {
      "type": "object",
      "required": ["title", "asset_name", "asset_sha256"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "asset_name": {"$ref": "#/$defs/archiveName"},
        "asset_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "channel_requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["channel", "operation", "asset_name", "expected_sha256", "mutation_allowed"],
        "properties": {
          "channel": {"enum": ["github", "mod-portal"]},
          "operation": {"const": "describe-request-only"},
          "asset_name": {"$ref": "#/$defs/archiveName"},
          "expected_sha256": {"$ref": "#/$defs/sha256"},
          "mutation_allowed": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "rollback": {
      "type": "object",
      "required": ["partial_publication_policy", "mutation_count"],
      "properties": {
        "partial_publication_policy": {"const": "not-applicable-no-mutation"},
        "mutation_count": {"const": 0}
      },
      "additionalProperties": false
    },
    "readback_verification": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "operation", "subject", "expected"],
        "properties": {
          "id": {"enum": ["candidate-sha256", "candidate-byte-count"]},
          "operation": {"enum": ["sha256", "byte-count"]},
          "subject": {"$ref": "#/$defs/archiveName"},
          "expected": {
            "oneOf": [
              {"$ref": "#/$defs/sha256"},
              {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "sealBinding": {
      "type": "object",
      "required": ["kind", "record_sha256", "file_sha256"],
      "properties": {
        "kind": {"const": "MIR4OfflineSealV1"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "identityAuthorities": {
      "type": "object",
      "required": ["target_registry", "version_authority"],
      "properties": {
        "target_registry": {"$ref": "#/$defs/targetRegistryAuthority"},
        "version_authority": {"$ref": "#/$defs/versionAuthority"}
      },
      "additionalProperties": false
    },
    "targetRegistryAuthority": {
      "type": "object",
      "required": ["kind", "status", "path", "file_sha256"],
      "properties": {
        "kind": {"const": "MIR4-Target-RegistryV2"},
        "status": {"const": "accepted-pre-publication-current"},
        "path": {"const": ".mir/releases/waves/mir4-r0/MIR4-Target-RegistryV2.json"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "versionAuthority": {
      "type": "object",
      "required": ["kind", "status", "path", "file_sha256"],
      "properties": {
        "kind": {"const": "MIR4-Versioning-and-Distribution-Identity-ADRv2"},
        "status": {"const": "accepted-pre-publication-current"},
        "path": {"const": ".mir/releases/waves/mir4-r0/MIR4-Versioning-and-Distribution-Identity-ADRv2.json"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "target": {"enum": ["factorio-2.1", "factorio-2.0", "factorio-1.1", "factorio-1.0"]},
    "distributionVersion": {"type": "string", "pattern": "^4\\.[0-9]+\\.[0-9]{5}$"},
    "archiveName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.zip$"},
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "target_id", "distribution_version", "archive_name", "archive_sha256", "bytes"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "target_id": {"$ref": "#/$defs/target"},
        "distribution_version": {"$ref": "#/$defs/distributionVersion"},
        "archive_name": {"$ref": "#/$defs/archiveName"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
