{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://julesc013.github.io/more-infinite-research/schemas/mir4/control/t10-authority-evolution-receipt-v1.schema.json",
  "title":"MIR 4 T10 authority evolution receipt",
  "type":"object","additionalProperties":false,
  "required":["schema","kind","recorded_at","programme_id","turn","predecessor_receipt","evolved_bindings","current_authorities","conformance","player_package_source_sha256","transition_gate","status"],
  "properties":{
    "schema":{"const":1},"kind":{"const":"MIR4T10AuthorityEvolutionReceiptV1"},"recorded_at":{"type":"string","format":"date-time"},
    "programme_id":{"const":"M4C10-WHOLE-4X-IN-4.0"},"turn":{"const":"T10"},
    "predecessor_receipt":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"const":".mir/releases/waves/mir4-r0/MIR4-T09-Authority-Evolution-ReceiptV1.json"},"sha256":{"$ref":"#/$defs/sha256"}}},
    "evolved_bindings":{
      "type":"array","minItems":13,"maxItems":13,
      "items":{"type":"object","additionalProperties":false,"required":["path","previous_sha256","current_sha256","reason","scope","package_visible","release_authority"],"properties":{
        "path":{"enum":[".mir/releases/waves/mir4-r0/MIR4-Pre-Freeze-Execution-ProgrammeV1.json","tools/lib/mir4/PreFreezeRelease.ps1","tools/lib/mir4/PlatformPreview.ps1",".mir/assurance.json","spec/schemas/mir4-pre-freeze-execution-programme-v1.schema.json","tools/commands/release/Test-MIR4R0Bootstrap.ps1","validation/tests/mir4/Test-MIR4ReleaseReadinessReconciliation.ps1",".mir/releases/waves/mir4-r0/dashboard.json",".mir/releases/waves/mir4-r0/queue.json","tools/mir.ps1","validation/tests.yml",".mir/docs.yml","mir.lock"]},
        "previous_sha256":{"$ref":"#/$defs/sha256"},"current_sha256":{"$ref":"#/$defs/sha256"},"reason":{"type":"string","minLength":1},
        "scope":{"const":"package-excluded-control-plane"},"package_visible":{"const":false},"release_authority":{"const":false}
      }}
    },
    "current_authorities":{"type":"array","minItems":32,"items":{"type":"object","additionalProperties":false,"required":["path","sha256","hash_mode","role"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"},"hash_mode":{"const":"canonical-text-v1"},"role":{"type":"string","minLength":1}}}},
    "conformance":{"type":"object","additionalProperties":false,"required":["reference_locks","target_diff_changes","permutation_digest_stable","privacy_negative_passed","diagnostic_redaction_passed","original_evidence_items","retained_evidence_items","transitive_closure_preserved","reproducer_signature_preserved","support_writer_unified","schemas_passed","cli_passed","platform_conformance_passed","package_visible","player_mutation_authorized","prototype_write_authorized","public_support_authorized","release_authority"],"properties":{
      "reference_locks":{"const":2},"target_diff_changes":{"const":3},"permutation_digest_stable":{"const":true},"privacy_negative_passed":{"const":true},"diagnostic_redaction_passed":{"const":true},
      "original_evidence_items":{"const":3},"retained_evidence_items":{"const":2},"transitive_closure_preserved":{"const":true},"reproducer_signature_preserved":{"const":true},
      "support_writer_unified":{"const":true},"schemas_passed":{"const":true},"cli_passed":{"const":true},"platform_conformance_passed":{"const":true},
      "package_visible":{"const":false},"player_mutation_authorized":{"const":false},"prototype_write_authorized":{"const":false},"public_support_authorized":{"const":false},"release_authority":{"const":false}
    }},
    "player_package_source_sha256":{"const":"9EFA2BBF5D399CCB6CE78BC907C5051D48E2CDB3DE652BA423FAF95FCE67A24C"},
    "transition_gate":{"type":"object","additionalProperties":false,"required":["source_freeze","candidate_allocation","production_signing","promotion_to_main","tagging","publication"],"properties":{"source_freeze":{"const":false},"candidate_allocation":{"const":false},"production_signing":{"const":false},"promotion_to_main":{"const":false},"tagging":{"const":false},"publication":{"const":false}}},
    "status":{"const":"T10-ENVIRONMENT-EVIDENCE-PASSED-PRODUCTION-UNAUTHORIZED"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"}}
}
