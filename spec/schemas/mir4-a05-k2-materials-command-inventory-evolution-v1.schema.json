    "currentInventory":{"type":"object","additionalProperties":false,"required":["path","raw_sha256","canonical_sha256","digest","command_count","canonical_internal_count"],"properties":{"path":{"const":"governance/automation/mir4-command-inventory-v1.json"},"raw_sha256":{"$ref":"#/$defs/sha"},"canonical_sha256":{"$ref":"#/$defs/sha"},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"command_count":{"const":85},"canonical_internal_count":{"const":380}}},
