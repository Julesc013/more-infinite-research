{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.invalid/schemas/mir4-whole-platform-programme-v1.schema.json",
  "title": "MIR 4 Whole Platform Programme V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "status", "programme_id", "source_version", "package_visible", "publication_authorized", "purpose", "target_key_contract", "maturity_classes", "areas", "ecosystem_order", "technology_acceptance_contract", "rules"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4WholePlatformProgrammeV1"},
    "status": {"const": "accepted-private-4.0-consolidation"},
    "programme_id": {"const": "M4C10-WHOLE-4X-IN-4.0"},
    "source_version": {"const": "4.0.0"},
    "package_visible": {"const": false},
    "publication_authorized": {"const": false},
    "purpose": {"type": "string", "minLength": 1},
    "target_key_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_display_pattern", "canonical_examples", "legacy_machine_pattern", "legacy_input_policy", "canonical_output_policy", "historical_evidence_policy"],
      "properties": {
        "canonical_display_pattern": {"const": "^F[0-9]{3}$"},
        "canonical_examples": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^F[0-9]{3}$"}},
        "legacy_machine_pattern": {"const": "^f[0-9]{3}$"},
        "legacy_input_policy": {"type": "string", "minLength": 1},
        "canonical_output_policy": {"type": "string", "minLength": 1},
        "historical_evidence_policy": {"type": "string", "minLength": 1}
      }
    },
    "maturity_classes": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"enum": ["stable", "preview", "shadow", "experimental", "omitted-by-target", "blocked-with-evidence", "mixed"]}},
    "areas": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["former_slot", "id", "release_destination", "maturity", "completion_state", "authorities", "implementations", "verification", "cutover", "blockers"],
        "properties": {
          "former_slot": {"enum": ["4.0", "4.1", "4.2", "4.3", "4.4", "4.5", "4.6", "4.7", "4.8", "4.9", "4.10", "4.11", "4.12", "4.13", "4.14", "4.15", "4.16", "4.17"]},
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "release_destination": {"const": "4.0.0"},
          "maturity": {"enum": ["stable", "preview", "shadow", "experimental", "omitted-by-target", "blocked-with-evidence", "mixed"]},
          "completion_state": {"type": "string", "minLength": 1},
          "authorities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "implementations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "verification": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "cutover": {"type": "string", "minLength": 1},
          "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "ecosystem_order": {"type": "array", "minItems": 11, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}},
    "technology_acceptance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "required_records", "required_transition", "blanket_pack_acceptance", "compatibility_claim_transfer", "maintainer_decision_required"],
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "required_records": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_transition": {"type": "string", "minLength": 1},
        "blanket_pack_acceptance": {"const": false},
        "compatibility_claim_transfer": {"const": false},
        "maintainer_decision_required": {"const": true}
      }
    },
    "rules": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
