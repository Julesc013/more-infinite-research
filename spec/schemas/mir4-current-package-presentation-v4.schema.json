{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.more-infinite-research.invalid/mir4-current-package-presentation-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "status", "recorded_at", "predecessor", "factorio_one_convergence", "package_authority", "source_manifest", "package_source", "presentation", "target_content_identities", "authority_invariants", "transition_gate", "record_sha256"],
  "properties": {
    "schema": {"const": 1}, "kind": {"const": "MIR4CurrentPackagePresentationV4"}, "status": {"const": "accepted-current-factorio-one-source-convergence-package-presentation"}, "recorded_at": {"type": "string", "format": "date-time"},
    "predecessor": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"path": {"const": "spec/distribution/mir4-current-package-presentation-v3.json"}, "kind": {"const": "MIR4CurrentPackagePresentationV3"}}}]},
    "factorio_one_convergence": {"type": "object", "additionalProperties": false, "required": ["authority", "receipt", "factorio_two_executable_content_proof"], "properties": {"authority": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"const": "governance/repository/factorio-one-source-convergence-v1.json"}}}]}, "receipt": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"path": {"const": "assurance/repository/factorio-one-source-convergence-v1.json"}, "kind": {"const": "MIR4FactorioOneSourceConvergenceReceiptV1"}}}]}, "factorio_two_executable_content_proof": {"type": "object", "additionalProperties": false, "required": ["kind", "status", "baseline_revision", "record_sha256"], "properties": {"kind": {"const": "MIR4FactorioTwoExecutableContentPreservationProofV1"}, "status": {"const": "passed-exact-pinned-predecessor-executable-content-preservation"}, "baseline_revision": {"const": "297aa5cc902da96847165a4f9caa1048608839fb"}, "record_sha256": {"$ref": "#/$defs/sha256"}}}}},
    "package_authority": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"path": {"const": "targets/package-authority.json"}, "kind": {"const": "MIR4CanonicalPackageAuthorityV2"}}}]},
    "source_manifest": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "state", "record_sha256"], "properties": {"path": {"const": "source/package-source.json"}, "kind": {"const": "MIR4ComposablePackageSourceV2"}, "state": {"const": "canonical-composable-package-source"}, "record_sha256": {"$ref": "#/$defs/sha256"}}},
    "package_source": {"type": "object", "additionalProperties": false, "required": ["fingerprint_sha256", "materializer_abi", "roots", "sole_writer", "legacy_root_state"], "properties": {"fingerprint_sha256": {"$ref": "#/$defs/sha256"}, "materializer_abi": {"const": "mir4-target-materializer/1"}, "roots": {"const": ["source", "targets"]}, "sole_writer": {"const": "tools/mir/application/package/TargetMaterializer.ps1"}, "legacy_root_state": {"const": "retired-historical-read-only"}}},
    "presentation": {"type": "object", "additionalProperties": false, "required": ["repository_readme_package_excluded", "target_readmes_manifest_bound"], "properties": {"repository_readme_package_excluded": {"const": true}, "target_readmes_manifest_bound": {"const": true}}},
    "target_content_identities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/targetIdentity"}, {"properties": {"target": {"const": "f210"}, "relation": {"const": "presentation-only-content-change-executable-preserved"}, "executable_content_preserved": {"const": true}, "exact_engine_proof_required": {"const": false}}}]},
        {"allOf": [{"$ref": "#/$defs/targetIdentity"}, {"properties": {"target": {"const": "f200"}, "relation": {"const": "presentation-only-content-change-executable-preserved"}, "executable_content_preserved": {"const": true}, "exact_engine_proof_required": {"const": false}}}]},
        {"allOf": [{"$ref": "#/$defs/targetIdentity"}, {"properties": {"target": {"const": "f110"}, "relation": {"const": "changed-semantic-content-exact-engine-proof-required"}, "executable_content_preserved": {"const": false}, "exact_engine_proof_required": {"const": true}}}]},
        {"allOf": [{"$ref": "#/$defs/targetIdentity"}, {"properties": {"target": {"const": "f100"}, "relation": {"const": "changed-semantic-content-exact-engine-proof-required"}, "executable_content_preserved": {"const": false}, "exact_engine_proof_required": {"const": true}}}]}
      ],
      "items": false
    },
    "authority_invariants": {"type": "object", "additionalProperties": false, "required": ["v3_receipt_immutable", "factorio_two_presentation_content_changed", "factorio_two_executable_content_preserved", "factorio_one_semantic_content_changed", "factorio_one_exact_engine_proof_required", "candidate_allocation_authorized", "signing_or_sealing_authorized", "promotion_authorized", "publication_authorized", "public_support_authorized"], "properties": {"v3_receipt_immutable": {"const": true}, "factorio_two_presentation_content_changed": {"const": true}, "factorio_two_executable_content_preserved": {"const": true}, "factorio_one_semantic_content_changed": {"const": true}, "factorio_one_exact_engine_proof_required": {"const": true}, "candidate_allocation_authorized": {"const": false}, "signing_or_sealing_authorized": {"const": false}, "promotion_authorized": {"const": false}, "publication_authorized": {"const": false}, "public_support_authorized": {"const": false}}},
    "transition_gate": {"$ref": "#/$defs/gates"}, "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "record": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "record_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "record_sha256": {"$ref": "#/$defs/sha256"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "targetIdentity": {"type": "object", "additionalProperties": false, "required": ["target", "content_sha256", "entry_count", "predecessor_content_sha256", "predecessor_entry_count", "relation", "deterministic_archive_bytes", "executable_content_preserved", "exact_engine_proof_required"], "properties": {"target": {"enum": ["f210", "f200", "f110", "f100"]}, "content_sha256": {"$ref": "#/$defs/sha256"}, "entry_count": {"type": "integer", "minimum": 1}, "predecessor_content_sha256": {"$ref": "#/$defs/sha256"}, "predecessor_entry_count": {"type": "integer", "minimum": 1}, "relation": {"enum": ["presentation-only-content-change-executable-preserved", "changed-semantic-content-exact-engine-proof-required"]}, "deterministic_archive_bytes": {"const": true}, "executable_content_preserved": {"type": "boolean"}, "exact_engine_proof_required": {"type": "boolean"}}},
    "gates": {"type": "object", "additionalProperties": false, "required": ["development_merge", "private_build", "qualification", "technical_seal", "main_promotion", "version_allocation", "tagging", "signing", "sealing", "publication"], "properties": {"development_merge": {"const": true}, "private_build": {"const": false}, "qualification": {"const": false}, "technical_seal": {"const": false}, "main_promotion": {"const": false}, "version_allocation": {"const": false}, "tagging": {"const": false}, "signing": {"const": false}, "sealing": {"const": false}, "publication": {"const": false}}}
  }
}
