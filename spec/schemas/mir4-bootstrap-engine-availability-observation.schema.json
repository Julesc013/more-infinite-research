{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.example/schemas/mir4-bootstrap-engine-availability-observation.schema.json",
  "x-mir-canonical-path": "spec/schemas/mir4-bootstrap-engine-availability-observation.schema.json",
  "title": "MIR 4 bootstrap exact-engine executable availability observation",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "status",
    "observed_at",
    "package_visible",
    "semantic_authority",
    "public_output_authorized",
    "construction_authority",
    "observation_scope",
    "lock_authority",
    "targets",
    "hard_boundary",
    "record_sha256"
  ],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4BootstrapEngineAvailabilityObservationV1"},
    "status": {"const": "three-exact-lock-matches-one-f210-hash-mismatch"},
    "observed_at": {"type": "string", "format": "date-time"},
    "package_visible": {"const": false},
    "semantic_authority": {"const": false},
    "public_output_authorized": {"const": false},
    "construction_authority": {"const": false},
    "observation_scope": {"const": "read-only-local-executable-metadata-and-sha256"},
    "lock_authority": {"$ref": "#/$defs/recordBinding"},
    "targets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/targetObservation"}], "properties": {"target_key": {"const": "f210"}}},
        {"allOf": [{"$ref": "#/$defs/targetObservation"}], "properties": {"target_key": {"const": "f200"}}},
        {"allOf": [{"$ref": "#/$defs/targetObservation"}], "properties": {"target_key": {"const": "f110"}}},
        {"allOf": [{"$ref": "#/$defs/targetObservation"}], "properties": {"target_key": {"const": "f100"}}}
      ],
      "items": false
    },
    "hard_boundary": {
      "const": "This dated, non-authoritative observation records executable metadata and hashes only. It does not prove an official data or module closure, qualify a candidate, admit a blocked target, authorize package construction, seal MIR 3 EOL, allocate a public identity, or authorize publication."
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$",
      "description": "SHA-256 of MIR4BootstrapCanonicalJsonV1 with record_sha256 omitted."
    }
  },
  "$defs": {
    "recordBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": ".mir/releases/waves/mir4-r0/MIR4-Bootstrap-Local-Candidate-PlanV1.json"
        },
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "engineIdentity": {
      "type": "object",
      "required": ["version", "build", "platform", "architecture", "executable_sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "build": {"type": "integer", "minimum": 1},
        "platform": {"const": "windows"},
        "architecture": {"const": "x86_64"},
        "executable_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "version_match",
        "build_match",
        "platform_match",
        "architecture_match",
        "executable_sha256_match",
        "exact_lock_match"
      ],
      "properties": {
        "version_match": {"const": true},
        "build_match": {"const": true},
        "platform_match": {"const": true},
        "architecture_match": {"const": true},
        "executable_sha256_match": {"type": "boolean"},
        "exact_lock_match": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "targetObservation": {
      "type": "object",
      "required": [
        "target_key",
        "target_id",
        "factorio_line",
        "lock_label",
        "support_envelope",
        "required_engine",
        "observed_engine",
        "comparison",
        "lock_state",
        "official_data_module_closure"
      ],
      "properties": {
        "target_key": {"enum": ["f210", "f200", "f110", "f100"]},
        "target_id": {"enum": ["factorio-2.1", "factorio-2.0", "factorio-1.1", "factorio-1.0"]},
        "factorio_line": {"enum": ["2.1", "2.0", "1.1", "1.0"]},
        "lock_label": {"enum": ["2.1.13", "2.0.77", "1.1.110", "1.0.0-only"]},
        "support_envelope": {"enum": ["line-compatible", "exact-only"]},
        "required_engine": {"$ref": "#/$defs/engineIdentity"},
        "observed_engine": {"$ref": "#/$defs/engineIdentity"},
        "comparison": {"$ref": "#/$defs/comparison"},
        "lock_state": {"enum": ["exact-lock-match", "hash-mismatch"]},
        "official_data_module_closure": {"const": "not-captured-by-this-observation"}
      },
      "allOf": [
        {
          "if": {"properties": {"target_key": {"const": "f210"}}, "required": ["target_key"]},
          "then": {
            "properties": {
              "target_id": {"const": "factorio-2.1"},
              "factorio_line": {"const": "2.1"},
              "lock_label": {"const": "2.1.13"},
              "support_envelope": {"const": "line-compatible"},
              "required_engine": {
                "properties": {
                  "version": {"const": "2.1.13"},
                  "build": {"const": 87164},
                  "executable_sha256": {"const": "CA89D178A82D705BD570F46CE8CCF83E50503D3C5AFDECCD77A6061FBC985084"}
                }
              },
              "observed_engine": {
                "properties": {
                  "version": {"const": "2.1.13"},
                  "build": {"const": 87164},
                  "executable_sha256": {"const": "B90CA5940D49799280614A9945DDFC1AB06E2A8BD6BBD874E542FE7167465485"}
                }
              },
              "comparison": {
                "properties": {
                  "executable_sha256_match": {"const": false},
                  "exact_lock_match": {"const": false}
                }
              },
              "lock_state": {"const": "hash-mismatch"}
            }
          }
        },
        {
          "if": {"properties": {"target_key": {"const": "f200"}}, "required": ["target_key"]},
          "then": {
            "properties": {
              "target_id": {"const": "factorio-2.0"},
              "factorio_line": {"const": "2.0"},
              "lock_label": {"const": "2.0.77"},
              "support_envelope": {"const": "line-compatible"},
              "required_engine": {
                "properties": {
                  "version": {"const": "2.0.77"},
                  "build": {"const": 84539},
                  "executable_sha256": {"const": "D3BCFCA4DBEE407D472013B745CE2445D34AF6F021AACC5753EE0DAC54B56B0B"}
                }
              },
              "observed_engine": {
                "properties": {
                  "version": {"const": "2.0.77"},
                  "build": {"const": 84539},
                  "executable_sha256": {"const": "D3BCFCA4DBEE407D472013B745CE2445D34AF6F021AACC5753EE0DAC54B56B0B"}
                }
              },
              "comparison": {
                "properties": {
                  "executable_sha256_match": {"const": true},
                  "exact_lock_match": {"const": true}
                }
              },
              "lock_state": {"const": "exact-lock-match"}
            }
          }
        },
        {
          "if": {"properties": {"target_key": {"const": "f110"}}, "required": ["target_key"]},
          "then": {
            "properties": {
              "target_id": {"const": "factorio-1.1"},
              "factorio_line": {"const": "1.1"},
              "lock_label": {"const": "1.1.110"},
              "support_envelope": {"const": "line-compatible"},
              "required_engine": {
                "properties": {
                  "version": {"const": "1.1.110"},
                  "build": {"const": 62357},
                  "executable_sha256": {"const": "B7B4B834FCA2E32AFA9D3476EB42CC09B02F1205BE97F688DC6FC6ACE7BA8FE1"}
                }
              },
              "observed_engine": {
                "properties": {
                  "version": {"const": "1.1.110"},
                  "build": {"const": 62357},
                  "executable_sha256": {"const": "B7B4B834FCA2E32AFA9D3476EB42CC09B02F1205BE97F688DC6FC6ACE7BA8FE1"}
                }
              },
              "comparison": {
                "properties": {
                  "executable_sha256_match": {"const": true},
                  "exact_lock_match": {"const": true}
                }
              },
              "lock_state": {"const": "exact-lock-match"}
            }
          }
        },
        {
          "if": {"properties": {"target_key": {"const": "f100"}}, "required": ["target_key"]},
          "then": {
            "properties": {
              "target_id": {"const": "factorio-1.0"},
              "factorio_line": {"const": "1.0"},
              "lock_label": {"const": "1.0.0-only"},
              "support_envelope": {"const": "exact-only"},
              "required_engine": {
                "properties": {
                  "version": {"const": "1.0.0"},
                  "build": {"const": 54889},
                  "executable_sha256": {"const": "99F1CE207A04296EF7D797E4A98AA98DDE4F02EE653C9DF736AC33A676FD4F70"}
                }
              },
              "observed_engine": {
                "properties": {
                  "version": {"const": "1.0.0"},
                  "build": {"const": 54889},
                  "executable_sha256": {"const": "99F1CE207A04296EF7D797E4A98AA98DDE4F02EE653C9DF736AC33A676FD4F70"}
                }
              },
              "comparison": {
                "properties": {
                  "executable_sha256_match": {"const": true},
                  "exact_lock_match": {"const": true}
                }
              },
              "lock_state": {"const": "exact-lock-match"}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
