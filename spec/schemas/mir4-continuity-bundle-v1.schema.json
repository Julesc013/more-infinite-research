    "feature_inventory": {"type":"object"},
    "runtime_state_schemas": {"type":"object"},
    "aliases_tombstones": {"type":"object"},
    "migration_watermark": {"type":"object"},
    "package_roots": {"type":"array","minItems":17,"maxItems":17},
    "proof_roots": {"type":"object"},
    "redaction_manifest": {"type":"object"},
    "package_visible": {"const":false},
    "runtime_mutation_authorized": {"const":false},
    "public_release_proof": {"const":false},
