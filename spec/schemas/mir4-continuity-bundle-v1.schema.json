  "required": ["schema","kind","programme_id","source_identity","authority","maturity","target_count","targets","module_extension_closure","feature_inventory","runtime_state_schemas","aliases_tombstones","migration_watermark","package_roots","proof_roots","redaction_manifest","package_visible","runtime_mutation_authorized","public_release_proof","digest"],
