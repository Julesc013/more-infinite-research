{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.more-infinite-research.invalid/targets/mir4-target-overlay-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "kind", "target", "family", "materializer_abi", "base_layers", "operations", "invariants", "record_sha256"],
  "properties": {"schema": {"const": 1}, "kind": {"const": "MIR4TargetOverlayV1"}, "target": {"enum": ["f210", "f200", "f110", "f100"]}, "family": {"enum": ["modern", "legacy"]}, "materializer_abi": {"const": "mir4-target-materializer/1"}, "base_layers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}, "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}, "invariants": {"type": "object", "additionalProperties": false, "required": ["all_target_differences_explicit", "no_full_target_source_copy", "independent_target_proof_required"], "properties": {"all_target_differences_explicit": {"const": true}, "no_full_target_source_copy": {"const": true}, "independent_target_proof_required": {"const": true}}}, "record_sha256": {"$ref": "#/$defs/sha256"}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "operation": {"type": "object", "additionalProperties": false, "required": ["path", "operation", "semantic_class", "source_path", "transform", "reason", "capability_disposition", "expected_bytes", "expected_sha256", "proof_obligations"], "properties": {"path": {"type": "string", "minLength": 1}, "operation": {"enum": ["add", "replace", "omit", "generate"]}, "semantic_class": {"enum": ["generated-metadata", "target-overlay", "target-replacement", "target-omission", "target-compatibility-shim", "migration", "package-documentation", "common-asset-locale"]}, "source_path": {"type": ["string", "null"]}, "transform": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 1}, "capability_disposition": {"enum": ["included-for-target", "omitted-by-target-profile"]}, "expected_bytes": {"type": ["integer", "null"], "minimum": 0}, "expected_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "proof_obligations": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}}}}}
}
