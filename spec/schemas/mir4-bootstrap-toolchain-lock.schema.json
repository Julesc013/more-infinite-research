{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-bootstrap-toolchain-lock.schema.json",
  "title": "MIR 4 bootstrap exact PowerShell and .NET toolchain lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "canonicalization", "powershell_version", "dotnet_runtime_version", "os_platform", "os_version", "process_architecture", "executable", "execution_culture", "file_count", "total_bytes", "files", "content_root_sha256", "record_sha256"],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "MIR4BootstrapToolchainLockV1" },
    "canonicalization": { "const": "MIR4BootstrapCanonicalJsonV1" },
    "powershell_version": { "type": "string", "minLength": 1 },
    "dotnet_runtime_version": { "type": "string", "minLength": 1 },
    "os_platform": { "type": "string", "minLength": 1 },
    "os_version": { "type": "string", "minLength": 1 },
    "process_architecture": { "enum": ["X86", "X64", "Arm", "Arm64", "S390x", "Wasm"] },
    "executable": { "const": "pwsh.exe" },
    "execution_culture": { "const": "InvariantCulture" },
    "file_count": { "type": "integer", "minimum": 1 },
    "total_bytes": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "content_root_sha256": { "$ref": "#/$defs/sha256" },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" } }
}
