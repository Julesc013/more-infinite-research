{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.example/schemas/mir3-terminal-qualification-record.schema.json",
  "x-mir-canonical-path": "spec/schemas/mir3-terminal-qualification-record.schema.json",
  "title": "Mir3TerminalQualificationRecordV1",
  "type": "object",
  "required": ["schema", "kind", "recorded_at", "release", "target", "support_tier", "candidate_id", "candidate_commit", "source_tree", "archive_sha256", "content_sha256", "required_checks", "results", "manual_review", "status"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "Mir3TerminalQualificationRecordV1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.9$"},
    "target": {"type": "string", "minLength": 1},
    "support_tier": {"enum": ["current", "maintained", "lts", "historical", "finite"]},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "archive_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "required_checks": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "results": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"const": "passed"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    },
    "manual_review": {
      "type": "object",
      "required": ["required", "status", "candidate_hash_bound"],
      "properties": {
        "required": {"const": true},
        "status": {"const": "pending-maintainer-approval"},
        "candidate_hash_bound": {"const": true}
      },
      "additionalProperties": true
    },
    "status": {"const": "passed-automated-awaiting-human-review"}
  },
  "additionalProperties": true
}
