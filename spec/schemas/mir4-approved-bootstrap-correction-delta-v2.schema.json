{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-approved-bootstrap-correction-delta-v2.schema.json",
  "title": "MIR 4 approved bootstrap correction composite V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "authority_family", "status", "canonicalization", "approved_by", "package_visible", "public_output_authorized", "imports", "authority_scope", "findings", "target_key", "correction_commit", "predecessor", "base_source", "integration_source", "evidence_sources", "canonical_patch", "deltas", "semantic_effects", "forbidden_side_effects", "target_dispositions", "proof_obligations", "expiry", "supersession", "rollback", "record_sha256"],
  "properties": {
    "schema": {"const": 2},
    "kind": {"const": "MIR4ApprovedBootstrapCorrectionDeltaV2"},
    "authority_family": {"const": "MIRApprovedDeltaV1"},
    "status": {"const": "approved-local-bootstrap-correction-composite-only"},
    "canonicalization": {"const": "MIR4BootstrapCanonicalJsonV1"},
    "approved_by": {"const": "explicit-maintainer-bounded-authorization-2026-08-17"},
    "package_visible": {"const": false},
    "public_output_authorized": {"const": false},
    "imports": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/import"}},
    "authority_scope": {"const": {"construction_authorized": true, "exact_difference_classification_authorized": true, "release_admission_authorized": false, "signing_or_sealing_authorized": false, "publication_authorized": false, "transitive_target_inheritance_authorized": false}},
    "findings": {"const": ["MIR3-TERM-0033", "MIR3-TERM-0032"]},
    "target_key": {"const": "f210"},
    "correction_commit": {"$ref": "#/$defs/sha1"},
    "predecessor": {"$ref": "#/$defs/predecessor"},
    "base_source": {"$ref": "#/$defs/source"},
    "integration_source": {"$ref": "#/$defs/source"},
    "evidence_sources": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["role", "commit", "tree"], "properties": {"role": {"type": "string", "minLength": 1}, "commit": {"$ref": "#/$defs/sha1"}, "tree": {"$ref": "#/$defs/sha1"}}}},
    "canonical_patch": {"type": "object", "additionalProperties": false, "required": ["algorithm", "format", "sha256", "bytes"], "properties": {"algorithm": {"const": "SHA-256"}, "format": {"const": "git-diff-no-ext-diff-no-color-full-index-utf8-lf-v1"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}}},
    "deltas": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/delta"}},
    "semantic_effects": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["paths", "targets", "effect"], "properties": {"paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "targets": {"type": "array", "minItems": 1, "items": {"enum": ["f210", "f200", "f110", "f100"]}, "uniqueItems": true}, "effect": {"type": "string", "minLength": 1}}}},
    "forbidden_side_effects": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "target_dispositions": {"type": "object", "additionalProperties": false, "required": ["f210", "f200", "f110", "f100"], "properties": {"f210": {"type": "string", "minLength": 1}, "f200": {"type": "string", "minLength": 1}, "f110": {"type": "string", "minLength": 1}, "f100": {"type": "string", "minLength": 1}}},
    "proof_obligations": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "expiry": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "supersession": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"$ref": "#/$defs/sha1"}, "tree": {"$ref": "#/$defs/sha1"}}},
    "import": {"type": "object", "additionalProperties": false, "required": ["path", "text_sha256", "record_sha256"], "properties": {"path": {"const": ".mir/releases/waves/mir4-r0/MIR4-Approved-Bootstrap-Correction-MIR3-TERM-0033V1.json"}, "text_sha256": {"$ref": "#/$defs/sha256"}, "record_sha256": {"$ref": "#/$defs/sha256"}}},
    "predecessor": {"type": "object", "additionalProperties": false, "required": ["release", "archive_sha256", "content_sha256"], "properties": {"release": {"const": "3.2.10"}, "archive_sha256": {"$ref": "#/$defs/sha256"}, "content_sha256": {"$ref": "#/$defs/sha256"}}},
    "delta": {"type": "object", "additionalProperties": false, "required": ["path", "before_blob", "after_blob", "before_sha256", "after_sha256", "before_bytes", "after_bytes"], "properties": {"path": {"type": "string", "pattern": "^prototypes/mir/.+\\.lua$"}, "before_blob": {"$ref": "#/$defs/sha1"}, "after_blob": {"$ref": "#/$defs/sha1"}, "before_sha256": {"$ref": "#/$defs/sha256"}, "after_sha256": {"$ref": "#/$defs/sha256"}, "before_bytes": {"type": "integer", "minimum": 1}, "after_bytes": {"type": "integer", "minimum": 1}}}
  }
}
