{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.example/schemas/mir3-terminal-experiment-receipt.schema.json",
  "x-mir-canonical-path": "spec/schemas/mir3-terminal-experiment-receipt.schema.json",
  "title": "MIR 3 terminal experiment receipt",
  "type": "object",
  "required": ["schema", "kind", "finding", "authority_class", "experiment", "package", "engine", "observation", "integration", "canonical_port", "evidence", "retention"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR3TerminalExperimentReceiptV1"},
    "finding": {"type": "string", "pattern": "^MIR3-TERM-[0-9]{4}$"},
    "authority_class": {"const": "reproduced-experiment"},
    "experiment": {"$ref": "#/$defs/experiment"},
    "package": {"$ref": "#/$defs/package"},
    "engine": {"$ref": "#/$defs/engine"},
    "observation": {"$ref": "#/$defs/observation"},
    "integration": {"$ref": "#/$defs/integration"},
    "canonical_port": {"$ref": "#/$defs/canonicalPort"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "retention": {"$ref": "#/$defs/retention"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "purpose"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "purpose": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "required": ["branch", "commit", "merge_base", "reference_dev_commit", "dev_ahead", "experiment_ahead"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/commit"},
        "merge_base": {"$ref": "#/$defs/commit"},
        "reference_dev_commit": {"$ref": "#/$defs/commit"},
        "dev_ahead": {"type": "integer", "minimum": 0},
        "experiment_ahead": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": ["release", "archive_sha256", "content_sha256", "bytes"],
      "properties": {
        "release": {"const": "2.5.5"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "required": ["factorio_version", "binary_sha256"],
      "properties": {
        "factorio_version": {"const": "2.0.77"},
        "binary_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["reproduced_failure", "successful_control", "useful_behaviour", "nonportable_implementation"],
      "properties": {
        "reproduced_failure": {"type": "string", "minLength": 1},
        "successful_control": {"type": "string", "minLength": 1},
        "useful_behaviour": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "nonportable_implementation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "integration": {
      "type": "object",
      "required": ["merge_allowed", "cherry_pick_allowed", "reason"],
      "properties": {
        "merge_allowed": {"const": false},
        "cherry_pick_allowed": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "canonicalPort": {
      "type": "object",
      "required": ["required", "implementation_owner", "regression_owner", "entrypoint_role", "final_evidence_status"],
      "properties": {
        "required": {"const": true},
        "implementation_owner": {"const": "tools/lib/validation/PerformanceCampaign.ps1"},
        "regression_owner": {"const": "validation/tests/release/Test-MIRPerformanceBudgets.ps1"},
        "entrypoint_role": {"const": "scripts/Measure-MIRPerformanceRegression.ps1 remains a thin compatibility/orchestration entrypoint"},
        "final_evidence_status": {"const": "diagnostic-only-until-repeated-under-current-canonical-implementation"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["archived_artifacts", "raw_process_log_status"],
      "properties": {
        "archived_artifacts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/artifact"}},
        "raw_process_log_status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": ["active_branch_required_until_finding_closed", "archive_after_mir3_closure"],
      "properties": {
        "active_branch_required_until_finding_closed": {"const": true},
        "archive_after_mir3_closure": {"const": "retain-commit-in-git-bundle-or-archive-tag"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
