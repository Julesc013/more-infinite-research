{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.invalid/mir4-process-ir-v1.schema.json",
  "title": "MIR 4 ProcessIR parity result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "programme_id", "source_identity", "authority", "maturity", "scope", "exact_target_status", "fixture_results", "bilateral_gate", "risk_parity", "package_visible", "public_release_proof", "player_mutation_authorized", "evidence_refs", "passed", "digest"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4ProcessIRParityResultV1"},
    "programme_id": {"const": "M4C02-09-24H"},
    "source_identity": {"type": "object", "required": ["commit", "tree", "programme_id"]},
    "authority": {"type": "string"},
    "maturity": {"const": "developer-preview"},
    "scope": {"const": "synthetic-fixture-parity-only"},
    "exact_target_status": {"const": "BLOCKED-EXACT-TARGET-PROCESSIR-SNAPSHOT"},
    "exact_target_reason": {"type": "string", "minLength": 1},
    "fixture_results": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "bilateral_gate": {"type": "object", "required": ["known_safe_admissible", "known_unsafe_rejected", "reject_everything", "passed"]},
    "risk_parity": {"type": "object", "required": ["copied_not_reclassified", "all_fixture_fingerprints_preserved", "passed"]},
    "package_visible": {"const": false},
    "public_release_proof": {"const": false},
    "player_mutation_authorized": {"const": false},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "passed": {"type": "boolean"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
