      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_plan", "target_profiles", "terminal_predecessor_refresh", "terminal_import_contract", "terminal_import", "bootstrap_root_set", "terminal_import_composite"],
      "properties": {
        "candidate_plan": { "allOf": [{ "$ref": "#/$defs/recordImport" }, { "properties": { "path": { "const": ".mir/releases/waves/mir4-r0/MIR4-Bootstrap-Local-Candidate-PlanV3.json" }, "record_sha256": { "const": "7C32E6D71E2A5CB7BF9A385529398CB9EF0E67B54F82C41570EA758A30B1AAA4" } } }] },
        "target_profiles": { "allOf": [{ "$ref": "#/$defs/fileImport" }, { "properties": { "path": { "const": ".mir/targets.json" } } }] },
        "terminal_predecessor_refresh": { "allOf": [{ "$ref": "#/$defs/fileImport" }, { "properties": { "path": { "const": ".mir/releases/waves/mir4-r0/MIR4-Terminal-Predecessor-RefreshV3.json" } } }] },
        "terminal_import_contract": { "allOf": [{ "$ref": "#/$defs/fileImport" }, { "properties": { "path": { "const": ".mir/releases/waves/mir4-r0/MIR4-Terminal-Import-ContractV2.json" } } }] },
        "terminal_import": { "allOf": [{ "$ref": "#/$defs/recordImport" }, { "properties": { "path": { "const": ".mir/releases/waves/mir4-r0/terminal-baseline-import.json" }, "record_sha256": { "const": "0EC45588F021ED7ED08424D01A98ABE29FABEEBCF717BE0908F8B66C8D4BA9C7" } } }] },
        "bootstrap_root_set": { "allOf": [{ "$ref": "#/$defs/recordImport" }, { "properties": { "path": { "const": ".mir/releases/waves/mir4-r0/bootstrap-root-set.json" }, "record_sha256": { "const": "CA9B4A96EE7A83F36FF96CD5D28253159951390F0F2A80DA50C0D4F0B57D8317" } } }] },
        "terminal_import_composite": { "$ref": "#/$defs/fileImport" }
      }
    },
    "authorized_targets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/target" }, { "$ref": "#/$defs/f200" }] },
        { "allOf": [{ "$ref": "#/$defs/target" }, { "$ref": "#/$defs/f110" }] },
        { "allOf": [{ "$ref": "#/$defs/target" }, { "$ref": "#/$defs/f100" }] }
      ],
      "items": false
    },
    "allowed_operations": { "const": ["construct-deterministic-local-artifact", "check-local-artifact", "run-local-smoke", "run-local-predecessor-upgrade", "export-candidate-bound-evidence", "controlled-private-transfer"] },
    "allowed_statuses": { "const": ["built-unqualified-local-playtest-candidate", "locally-smoke-qualified-playtest-candidate", "locally-upgrade-qualified-playtest-candidate"] },
    "forbidden_operations": { "const": ["public-identity-allocation", "git-tag", "dist-write", "upload", "publication", "production-seal", "public-release-or-beta-claim", "broad-support-claim", "wildcard-target", "generic-gate-waiver", "package-visible-difference-outside-existing-equivalence"] },
    "private_transfer": { "const": { "permitted": true, "custody": "maintainer-controlled-private-machines-only", "public_or_uncontrolled_transfer": false, "numeric_public_version_requires_private_custody": true } },
    "expiry": { "const": ["formal-target-admission-supersedes", "bound-target-source-changes", "bound-plan-or-profile-changes", "candidate-abandoned"] },
    "rollback": { "const": "Delete only ignored build/mir4/local-playtest-shadow artifacts and their exported local evidence; do not alter release authority, dist, tags, seals, or public systems." },
    "hard_boundary": { "type": "string", "minLength": 1 },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
