{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir4-private-lane-authorization-v3.schema.json",
  "title": "MIR 4 private local-playtest lane authorization V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "authority_family", "status", "canonicalization", "approved_by", "package_visible", "semantic_authority", "semantic_difference_authorized", "release_admission_authorized", "public_identity_authorized", "public_output_authorized", "signing_or_sealing_authorized", "publication_authorized", "wildcard_targets_authorized", "gate_waivers_authorized", "output_root", "supersedes", "imports", "authorized_targets", "allowed_operations", "allowed_statuses", "forbidden_operations", "private_transfer", "expiry", "rollback", "hard_boundary", "record_sha256"],
  "properties": {
    "schema": { "const": 3 },
    "kind": { "const": "MIR4PrivateLaneAuthorizationV3" },
    "authority_family": { "const": "MIRLocalArtifactLaneAuthorizationV1" },
    "status": { "const": "authorized-private-local-playtest-shadow" },
    "canonicalization": { "const": "MIR4BootstrapCanonicalJsonV1" },
    "approved_by": { "const": "explicit-maintainer-bounded-authorization-2026-08-18" },
    "package_visible": { "const": false },
    "semantic_authority": { "const": false },
    "semantic_difference_authorized": { "const": false },
    "release_admission_authorized": { "const": false },
    "public_identity_authorized": { "const": false },
    "public_output_authorized": { "const": false },
    "signing_or_sealing_authorized": { "const": false },
    "publication_authorized": { "const": false },
    "wildcard_targets_authorized": { "const": false },
    "gate_waivers_authorized": { "const": false },
    "output_root": { "const": "build/mir4/local-playtest-shadow" },
    "supersedes": {
      "const": {
        "path": ".mir/releases/waves/mir4-r0/MIR4-Private-Lane-AuthorizationV2.json",
        "record_sha256": "AF1A9AD0A98284BF96489382EB8A0E416E7093B29DB113E49C511E6D0918EF2D",
        "disposition": "historical-dot10-predecessor-authorization"
      }
    },
