    "gitSha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "fileImport": { "type": "object", "additionalProperties": false, "required": ["path", "file_sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "file_sha256": { "$ref": "#/$defs/sha256" } } },
    "recordImport": { "type": "object", "additionalProperties": false, "required": ["path", "file_sha256", "record_sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "file_sha256": { "$ref": "#/$defs/sha256" }, "record_sha256": { "$ref": "#/$defs/sha256" } } },
    "target": {
      "type": "object",
