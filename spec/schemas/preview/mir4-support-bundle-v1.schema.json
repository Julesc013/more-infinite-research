    "minimized":{"type":"boolean"},"source_bundle_digest":{"type":["string","null"]},"minimization":{"type":"object"},"maturity":{"const":"developer-preview"},"synthetic":{"type":"boolean"},
    "claim_eligible":{"const":false},"arbitrary_code":{"const":false},"executable_content":{"const":false},"network_access_authorized":{"const":false},
    "package_visible":{"const":false},"player_mutation_authorized":{"const":false},"prototype_write_authorized":{"const":false},"public_support_authorized":{"const":false},"release_authority":{"const":false},
    "canonicalization":{"const":"mir-canonical-json/1"},"digest":{"$ref":"#/$defs/digest"}
