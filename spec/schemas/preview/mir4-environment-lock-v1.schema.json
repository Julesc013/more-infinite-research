{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://julesc013.github.io/more-infinite-research/schemas/mir4/v1/environment-lock-v1.schema.json",
  "title":"MIR 4 EnvironmentLockV1 developer preview",
  "type":"object","additionalProperties":false,
  "required":["schema","kind","maturity","capture","target","engine","mir","mods","startup_settings","extensions","contracts","canonicalization","portable","privacy_safe","package_visible","player_mutation_authorized","prototype_write_authorized","public_support_authorized","release_authority","digest"],
  "properties":{
    "schema":{"const":1},"kind":{"const":"MIR4EnvironmentLockV1"},"maturity":{"const":"developer-preview"},"capture":{"enum":["authority-projected","observed"]},
    "target":{"pattern":"^f[0-9]{3}$"},"engine":{"$ref":"#/$defs/engine"},"mir":{"$ref":"#/$defs/mir"},
    "mods":{"type":"array","maxItems":512,"items":{"$ref":"#/$defs/mod"}},
    "startup_settings":{"type":"array","maxItems":2048,"items":{"type":"object"}},
    "extensions":{"type":"array","maxItems":256,"items":{"type":"object"}},
    "contracts":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "canonicalization":{"const":"mir-canonical-json/1"},"portable":{"const":true},"privacy_safe":{"const":true},
    "package_visible":{"const":false},"player_mutation_authorized":{"const":false},"prototype_write_authorized":{"const":false},"public_support_authorized":{"const":false},"release_authority":{"const":false},
    "digest":{"$ref":"#/$defs/digest"}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "engine":{"type":"object","additionalProperties":false,"required":["version","executable_sha256"],"properties":{"version":{"type":"string","minLength":3},"executable_sha256":{"$ref":"#/$defs/digest"}}},
    "mir":{"type":"object","additionalProperties":false,"required":["version","package_sha256","source_commit","source_tree"],"properties":{"version":{"pattern":"^4\\.0\\.[0-9]{5}$"},"package_sha256":{"$ref":"#/$defs/digest"},"source_commit":{"pattern":"^[0-9a-f]{40}$"},"source_tree":{"pattern":"^[0-9a-f]{40}$"}}},
    "mod":{"type":"object","additionalProperties":false,"required":["name","version","sha256"],"properties":{"name":{"pattern":"^[a-z0-9][a-z0-9_-]{0,99}$"},"version":{"type":"string","minLength":3},"sha256":{"$ref":"#/$defs/digest"}}}
  }
}
