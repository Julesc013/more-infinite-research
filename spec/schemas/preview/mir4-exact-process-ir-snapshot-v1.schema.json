{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.moreinfiniteresearch.net/mir4/exact-process-ir-snapshot/1/schema.json",
  "title": "MIR 4 exact target-bound ProcessIR snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "work_package", "capture_id", "target", "scenario_id", "source_identity", "environment_lock", "environment_lock_digest", "evidence_refs", "observer", "transport", "process_ir", "observations", "classification_counts", "explicit_unavailable_not_zero", "terminal_fact_authority_preserved", "authoritative", "maturity", "package_visible", "public_release_proof", "player_mutation_authorized", "prototype_write_authorized", "planner_or_emitter_admission_authorized", "public_support_authorized", "digest"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4ExactProcessIRSnapshotV1"},
    "work_package": {"const": "T12"},
    "capture_id": {"type": "string", "pattern": "^f(?:200|210)-[a-z0-9-]+$"},
    "target": {"enum": ["f210", "f200"]},
    "scenario_id": {"type": "string", "minLength": 1},
    "source_identity": {"type": "object"},
    "environment_lock": {"type": "object"},
    "environment_lock_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_refs": {"type": "array", "minItems": 2, "maxItems": 2},
    "observer": {"type": "object", "required": ["digest", "header", "footer", "repetitions", "deterministic", "bounded", "truncated"]},
    "transport": {"type": "object"},
    "process_ir": {"type": "object"},
    "observations": {"type": "array", "minItems": 1, "maxItems": 128},
    "classification_counts": {"type": "object", "required": ["CERTIFIED_SAFE", "REVIEW_REQUIRED", "UNKNOWN", "UNSAFE"]},
    "explicit_unavailable_not_zero": {"const": true},
    "terminal_fact_authority_preserved": {"const": true},
    "authoritative": {"const": false},
    "maturity": {"const": "developer-preview"},
    "package_visible": {"const": false},
    "public_release_proof": {"const": false},
    "player_mutation_authorized": {"const": false},
    "prototype_write_authorized": {"const": false},
    "planner_or_emitter_admission_authorized": {"const": false},
    "public_support_authorized": {"const": false},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
