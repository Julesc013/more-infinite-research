{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/more-infinite-research/schemas/mir4/preview/release-compatibility-canary-v1.schema.json",
  "title": "MIR 4 exact release compatibility canary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "work_package", "canary_id", "name", "source_identity", "targets", "subjects", "capture_ids", "captures", "target_upgrades", "support_statement", "claim_level", "target_disposition", "limitations", "expiry_triggers", "compatibility_authorities", "diagnostics", "all_clean_loads_passed", "all_first_reloads_passed", "all_second_reloads_passed", "all_performance_within_budget", "exact_environment_only", "release_qualification_input", "public_support_claim_authorized", "release_transition_authorized", "package_visible", "digest"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4ReleaseCompatibilityCanaryV1"},
    "work_package": {"const": "T13"},
    "canary_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "source_identity": {"$ref": "#/$defs/source"},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["f210", "f200"]}},
    "subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "captures": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["capture_id", "target", "environment_lock_digest", "snapshot_digest", "capture_digest", "lifecycle_status", "processir_terminal_disposition"], "properties": {"capture_id": {"type": "string"}, "target": {"enum": ["f210", "f200"]}, "environment_lock_digest": {"$ref": "#/$defs/digest"}, "snapshot_digest": {"$ref": "#/$defs/digest"}, "capture_digest": {"$ref": "#/$defs/digest"}, "lifecycle_status": {"const": "passed"}, "processir_terminal_disposition": {"type": "string"}}}},
    "target_upgrades": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["target", "status", "engine_sha256", "baseline", "candidate", "archetypes", "matrix_sha256", "first_reload_asserted", "second_reload_asserted", "scope"], "properties": {"target": {"enum": ["f210", "f200"]}, "status": {"const": "passed"}, "engine_sha256": {"$ref": "#/$defs/digest"}, "baseline": {"type": "object"}, "candidate": {"type": "object"}, "archetypes": {"type": "array", "minItems": 1}, "matrix_sha256": {"$ref": "#/$defs/digest"}, "first_reload_asserted": {"const": true}, "second_reload_asserted": {"const": true}, "scope": {"type": "string"}}}},
    "support_statement": {"type": "string", "minLength": 20},
    "claim_level": {"const": "exact-locked-release-canary-input"},
    "target_disposition": {"const": "qualified-exact-release-canary"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expiry_triggers": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "compatibility_authorities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "diagnostics": {"type": "array"},
    "all_clean_loads_passed": {"const": true},
    "all_first_reloads_passed": {"const": true},
    "all_second_reloads_passed": {"const": true},
    "all_performance_within_budget": {"const": true},
    "exact_environment_only": {"const": true},
    "release_qualification_input": {"const": true},
    "public_support_claim_authorized": {"const": false},
    "release_transition_authorized": {"const": false},
    "package_visible": {"const": false},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "work_package"], "properties": {"commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "work_package": {"const": "T13"}}}
  }
}
