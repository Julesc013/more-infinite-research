{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/more-infinite-research/schemas/mir4/v1/f210-mod-data-snapshot.schema.json",
  "title": "MIR 4 F210 mod-data discovery snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","kind","target","factorio_line","environment_lock_digest","host","records"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4F210ModDataSnapshotV1"},
    "target": {"const": "f210"},
    "factorio_line": {"const": "2.1"},
    "environment_lock_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "host": {
      "type":"object","additionalProperties":false,"required":["present","id","version"],
      "properties": {
        "present":{"type":"boolean"},
        "id":{"type":["string","null"],"minLength":1,"maxLength":128},
        "version":{"type":["string","null"],"minLength":1,"maxLength":64}
      }
    },
    "records": {
      "type":"array","maxItems":64,
      "items": {
        "type":"object","additionalProperties":false,"required":["name","data_type","data"],
        "properties": {
          "name":{"type":"string","minLength":1,"maxLength":200},
          "data_type":{"type":"string","minLength":1,"maxLength":200},
          "data":{"type":"object","maxProperties":32}
        }
      }
    }
  }
}
