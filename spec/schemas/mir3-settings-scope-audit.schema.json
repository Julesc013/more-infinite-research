{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.example/schemas/mir3-settings-scope-audit.schema.json",
  "x-mir-canonical-path": "spec/schemas/mir3-settings-scope-audit.schema.json",
  "title": "MIR 3 terminal settings scope audit",
  "type": "object",
  "required": ["schema", "kind", "status", "recorded_at", "scope", "source_authorities", "configuration_domains", "setting_families", "stage_read_validation", "profile_contract", "decision"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR3-Settings-Scope-AuditV1"},
    "status": {"const": "complete-no-scope-migrations"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "scope": {"const": "terminal-dot9-current-source-and-all-nine-projections"},
    "source_authorities": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "configuration_domains": {
      "type": "object",
      "required": ["compile", "map", "player", "policy"],
      "properties": {"compile": {"type": "string"}, "map": {"type": "string"}, "player": {"type": "string"}, "policy": {"type": "string"}},
      "additionalProperties": false
    },
    "setting_families": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "members", "scope", "phase", "mutability", "impact_domains", "owner", "migration", "profile_namespace", "target_requirements", "restart_required", "invalidation_closure"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "scope": {"const": "startup"},
          "phase": {"type": "string", "minLength": 1},
          "mutability": {"const": "restart-required"},
          "impact_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "owner": {"type": "string", "minLength": 1},
          "migration": {"type": "string", "minLength": 1},
          "profile_namespace": {"const": "compile"},
          "target_requirements": {"type": "string", "minLength": 1},
          "restart_required": {"const": true},
          "invalidation_closure": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "stage_read_validation": {
      "type": "object",
      "required": ["startup_reads_outside_permitted_stages", "runtime_global_settings_registered", "runtime_per_user_settings_registered", "released_setting_type_changes", "new_dot9_runtime_setting_admitted"],
      "properties": {
        "startup_reads_outside_permitted_stages": {"const": 0},
        "runtime_global_settings_registered": {"const": 0},
        "runtime_per_user_settings_registered": {"const": 0},
        "released_setting_type_changes": {"const": 0},
        "new_dot9_runtime_setting_admitted": {"const": false}
      },
      "additionalProperties": false
    },
    "profile_contract": {
      "type": "object",
      "required": ["current_codec", "schema_change_admitted", "unknown_ids_preserved_and_ignored_when_unsupported", "mir4_required_namespaces"],
      "properties": {
        "current_codec": {"const": "MIRSET1"},
        "schema_change_admitted": {"const": false},
        "unknown_ids_preserved_and_ignored_when_unsupported": {"const": true},
        "mir4_required_namespaces": {"const": ["compile", "map", "player", "policy"]}
      },
      "additionalProperties": false
    },
    "decision": {"const": "retain-all-existing-generation-cap-module-recycling-compiler-and-profile-controls-as-startup"}
  },
  "additionalProperties": false
}
