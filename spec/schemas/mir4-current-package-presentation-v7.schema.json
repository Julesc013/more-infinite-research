{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.more-infinite-research.invalid/mir4-current-package-presentation-v7.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "status", "recorded_at", "predecessor", "package_authority", "source_manifest", "source_succession", "package_source", "target_compositions", "target_content_identities", "progression_baseline", "localization", "qualification_obligations", "authority_invariants", "transition_gate", "record_sha256"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4CurrentPackagePresentationV7"},
    "status": {"const": "accepted-development-package-source-v3-presentation-exact-engine-qualification-required"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "predecessor": {"$ref": "#/$defs/predecessor"},
    "package_authority": {"$ref": "#/$defs/recordBinding"},
    "source_manifest": {"allOf": [{"$ref": "#/$defs/recordBinding"}, {"properties": {"path": {"const": "source/package-source.json"}, "kind": {"const": "MIR4ComposablePackageSourceV3"}}}]},
    "source_succession": {"$ref": "#/$defs/sourceSuccession"},
    "package_source": {"$ref": "#/$defs/packageSource"},
    "target_compositions": {"$ref": "#/$defs/compositions"},
    "target_content_identities": {"$ref": "#/$defs/contentIdentities"},
    "progression_baseline": {"$ref": "#/$defs/progressionBaseline"},
    "localization": {"$ref": "#/$defs/localization"},
    "qualification_obligations": {"const": ["schema-3-maximum-level-policy-fail-closed-validation", "per-force-cap-ownership-and-reset-merge-reused-index-continuity", "v2-to-v3-save-migration", "browser-refresh-after-force-reset", "f210-and-f200-exact-engine-replay", "f110-and-f100-capability-omission-nonclaim", "browser-localization-governed-locale-package-materialization", "current-development-effects-and-science-exact-package-requalification", "recipe-route-feasibility-all-target-load-and-behavior-qualification"]},
    "authority_invariants": {"$ref": "#/$defs/invariants"},
    "transition_gate": {"$ref": "#/$defs/gates"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "predecessor": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "record_sha256", "immutable_historical_receipt"], "properties": {"path": {"const": "spec/distribution/mir4-current-package-presentation-v6.json"}, "kind": {"const": "MIR4CurrentPackagePresentationV6"}, "record_sha256": {"$ref": "#/$defs/sha256"}, "immutable_historical_receipt": {"const": true}}},
    "recordBinding": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "record_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "record_sha256": {"$ref": "#/$defs/sha256"}}},
    "sourceSuccession": {"type": "object", "additionalProperties": false, "required": ["predecessor_kind", "predecessor_record_sha256", "current_kind", "current_record_sha256", "migrated_binding_count", "introduced_binding_count", "introduced_ids", "provenance_exclusive", "acyclic", "fixed_point_verified"], "properties": {"predecessor_kind": {"const": "MIR4ComposablePackageSourceV2"}, "predecessor_record_sha256": {"$ref": "#/$defs/sha256"}, "current_kind": {"const": "MIR4ComposablePackageSourceV3"}, "current_record_sha256": {"$ref": "#/$defs/sha256"}, "migrated_binding_count": {"const": 359}, "introduced_binding_count": {"const": 1}, "introduced_ids": {"const": ["MIR42-SCIENCE-ROUTE-FEASIBILITY"]}, "provenance_exclusive": {"const": true}, "acyclic": {"const": true}, "fixed_point_verified": {"const": true}}},
    "packageSource": {"type": "object", "additionalProperties": false, "required": ["fingerprint_sha256", "materializer_abi", "roots", "sole_writer", "legacy_root_state"], "properties": {"fingerprint_sha256": {"$ref": "#/$defs/sha256"}, "materializer_abi": {"const": "mir4-target-materializer/1"}, "roots": {"const": ["source", "targets"]}, "sole_writer": {"const": "tools/mir/application/package/TargetMaterializer.ps1"}, "legacy_root_state": {"const": "retired-historical-read-only"}}},
    "composition": {"type": "object", "additionalProperties": false, "required": ["target", "path", "record_sha256"], "properties": {"target": {"enum": ["f210", "f200", "f110", "f100"]}, "path": {"type": "string"}, "record_sha256": {"$ref": "#/$defs/sha256"}}},
    "compositions": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"allOf": [{"$ref": "#/$defs/composition"}, {"properties": {"target": {"const": "f210"}, "path": {"const": "targets/f210/composition.json"}}}]}, {"allOf": [{"$ref": "#/$defs/composition"}, {"properties": {"target": {"const": "f200"}, "path": {"const": "targets/f200/composition.json"}}}]}, {"allOf": [{"$ref": "#/$defs/composition"}, {"properties": {"target": {"const": "f110"}, "path": {"const": "targets/f110/composition.json"}}}]}, {"allOf": [{"$ref": "#/$defs/composition"}, {"properties": {"target": {"const": "f100"}, "path": {"const": "targets/f100/composition.json"}}}]}], "items": false},
    "contentIdentity": {"type": "object", "additionalProperties": false, "required": ["target", "content_sha256", "entry_count", "predecessor_content_sha256", "predecessor_entry_count", "relation", "progression_capability_state", "deterministic_archive_bytes", "exact_engine_qualification_required"], "properties": {"target": {"enum": ["f210", "f200", "f110", "f100"]}, "content_sha256": {"$ref": "#/$defs/sha256"}, "entry_count": {"type": "integer", "minimum": 1}, "predecessor_content_sha256": {"$ref": "#/$defs/sha256"}, "predecessor_entry_count": {"type": "integer", "minimum": 1}, "relation": {"const": "current-development-content-changed-exact-engine-qualification-required"}, "progression_capability_state": {"enum": ["applied", "omitted-nonclaim"]}, "deterministic_archive_bytes": {"const": true}, "exact_engine_qualification_required": {"const": true}}},
    "contentIdentities": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/contentIdentity"}},
    "progression": {"type": "object", "additionalProperties": false, "required": ["target", "relation", "capability_state"], "properties": {"target": {"enum": ["f210", "f200", "f110", "f100"]}, "relation": {"enum": ["progression-semantic-content-changed-exact-engine-qualification-required", "progression-capability-omitted-nonclaim-exact-engine-qualification-required"]}, "capability_state": {"enum": ["applied", "omitted-nonclaim"]}}},
    "progressionBaseline": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/progression"}},
    "localeCoverage": {"type": "object", "additionalProperties": false, "required": ["target", "locale_count"], "properties": {"target": {"enum": ["f210", "f200", "f110", "f100"]}, "locale_count": {"type": "integer", "minimum": 1}}},
    "localization": {"type": "object", "additionalProperties": false, "required": ["policy_path", "policy_sha256", "source_locale", "source_root", "generated_file_name", "browser_section", "browser_discovery_key_count", "governed_locale_count", "all_governed_locales_complete", "package_visible_locale_coverage_bound", "target_locale_coverage"], "properties": {"policy_path": {"const": ".mir/locales/manifest.json"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "source_locale": {"const": "en"}, "source_root": {"const": "source/locale"}, "generated_file_name": {"const": "more-infinite-research.cfg"}, "browser_section": {"const": "mir-browser"}, "browser_discovery_key_count": {"const": 29}, "governed_locale_count": {"const": 50}, "all_governed_locales_complete": {"const": true}, "package_visible_locale_coverage_bound": {"const": true}, "target_locale_coverage": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/localeCoverage"}}}},
    "invariants": {"type": "object", "additionalProperties": false, "required": ["v6_predecessor_immutable", "package_source_v3_provenance_complete", "all_governed_locales_complete", "package_visible_locale_coverage_bound", "current_package_contract_bound", "f210_f200_progression_capability_applied", "f110_f100_progression_capability_omitted_nonclaim", "exact_engine_qualification_required", "candidate_allocation_authorized", "signing_or_sealing_authorized", "promotion_authorized", "publication_authorized", "public_support_authorized"], "properties": {"v6_predecessor_immutable": {"const": true}, "package_source_v3_provenance_complete": {"const": true}, "all_governed_locales_complete": {"const": true}, "package_visible_locale_coverage_bound": {"const": true}, "current_package_contract_bound": {"const": true}, "f210_f200_progression_capability_applied": {"const": true}, "f110_f100_progression_capability_omitted_nonclaim": {"const": true}, "exact_engine_qualification_required": {"const": true}, "candidate_allocation_authorized": {"const": false}, "signing_or_sealing_authorized": {"const": false}, "promotion_authorized": {"const": false}, "publication_authorized": {"const": false}, "public_support_authorized": {"const": false}}},
    "gates": {"type": "object", "additionalProperties": false, "required": ["development_merge", "private_build", "qualification", "technical_seal", "main_promotion", "version_allocation", "tagging", "signing", "sealing", "publication"], "properties": {"development_merge": {"const": true}, "private_build": {"const": false}, "qualification": {"const": false}, "technical_seal": {"const": false}, "main_promotion": {"const": false}, "version_allocation": {"const": false}, "tagging": {"const": false}, "signing": {"const": false}, "sealing": {"const": false}, "publication": {"const": false}}}
  }
}
