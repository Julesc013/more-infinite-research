      "latest_lane": {"type": "object", "additionalProperties": false, "required": ["id", "selection", "channel"], "properties": {"id": {"const": "stable-latest"}, "selection": {"const": "latest-official-stable-2.1.x"}, "channel": {"const": "stable"}}},
