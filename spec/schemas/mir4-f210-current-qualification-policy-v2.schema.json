      "execution_binding": {"const": "exact-version-build-file-version-binary-sha256-steam-build-id-manifest-sha256-api-prototype-data-and-mod-closure"}, "drift": {"const": "invalidate-prior-execution-and-rerun-affected-build-and-qualification"}, "engine_admission": {"const": "pending-exact-engine-api-prototype-data-and-official-mod-capsule"}
    }},
