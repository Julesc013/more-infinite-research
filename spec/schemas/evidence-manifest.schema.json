{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-mir-canonical-path": "spec/schemas/evidence-manifest.schema.json",
  "$id": "https://more-infinite-research.invalid/verification/evidence-manifest.schema.json",
  "title": "MIR immutable execution evidence manifest",
  "type": "object",
  "required": ["schema", "authority", "context_digest", "plan_id", "producer", "objects", "task_results", "status"],
  "properties": {
    "schema": {"const": 1},
    "authority": {"const": "mir-control-plane-v5-execution-manifest"},
    "context_digest": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "plan_id": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "producer": {"type": "object"},
    "objects": {"type": "array", "items": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "uniqueItems": true},
    "task_results": {"type": "array", "items": {"type": "object"}},
    "status": {"enum": ["passed", "failed", "incomplete"]}
  },
  "additionalProperties": false
}
