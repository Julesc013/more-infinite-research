{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.invalid/schemas/mir4-successor-host-result-v1.schema.json",
  "title": "MIR 4 Synthetic Successor Host Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema", "programme_id", "wave", "maturity", "source_identity", "input_authorities", "host", "module_index", "extension_closure", "external_target_provider", "continuity_import", "extension_transport", "proof_replay", "package_reconstruction", "succession_witness", "blockers", "status", "package_visible", "public_release_proof", "semantic_authority", "target_policy_authority", "runtime_state_mutation_authorized", "migration_execution_authorized", "source_freeze_authorized", "production_signing_or_sealing_authorized", "publication_authorized", "record_sha256"],
  "properties": {
    "kind": {"const": "MIR4SuccessorHostResultV1"},
    "schema": {"const": 1},
    "programme_id": {"const": "M4C02-09-24H"},
    "wave": {"const": "W09"},
    "maturity": {"const": "developer-preview-shadow"},
    "source_identity": {"$ref": "#/$defs/sourceIdentity"},
    "input_authorities": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/input"}},
    "host": {"type": "object"},
    "module_index": {"type": "object"},
    "extension_closure": {"type": "object"},
    "external_target_provider": {"type": "object"},
    "continuity_import": {"type": "object"},
    "extension_transport": {"type": "object"},
    "proof_replay": {"type": "object"},
    "package_reconstruction": {"type": "object"},
    "succession_witness": {"$ref": "#/$defs/witness"},
    "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"const": "partial-with-bounded-blockers"},
    "package_visible": {"const": false},
    "public_release_proof": {"const": false},
    "semantic_authority": {"const": false},
    "target_policy_authority": {"const": false},
    "runtime_state_mutation_authorized": {"const": false},
    "migration_execution_authorized": {"const": false},
    "source_freeze_authorized": {"const": false},
    "production_signing_or_sealing_authorized": {"const": false},
    "publication_authorized": {"const": false},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "sourceIdentity": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "programme_id", "source_version", "package_source_sha256"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "programme_id": {"const": "M4C02-09-24H"}, "source_version": {"const": "4.0.0"}, "package_source_sha256": {"$ref": "#/$defs/sha256"}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "witness": {"type": "object", "additionalProperties": false, "required": ["kind", "schema", "published_predecessor", "current_mir4", "introducing_commit", "changed_package_roots", "evidence_disposition", "append_only", "prior_release_evidence_mutated", "digest"], "properties": {"kind": {"const": "MIR4PackageSuccessionWitnessV1"}, "schema": {"const": 1}, "published_predecessor": {"type": "object"}, "current_mir4": {"type": "object"}, "introducing_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "changed_package_roots": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"type": "string"}}, "evidence_disposition": {"type": "object"}, "append_only": {"const": true}, "prior_release_evidence_mutated": {"const": false}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
  }
}
