{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mir.example/schemas/mir4-target-registry-v2.schema.json",
  "x-mir-canonical-path": "spec/schemas/mir4-target-registry-v2.schema.json",
  "title": "MIR 4 direct distribution target registry V2",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "status",
    "recorded_at",
    "package_visible",
    "authority_id",
    "imports",
    "semantic_reads",
    "semantic_writes",
    "target_dispositions",
    "digest_classes",
    "migration",
    "rollback",
    "parity_test",
    "sunset_condition",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "kind": {
      "const": "MIR4-Target-RegistryV2"
    },
    "status": {
      "const": "accepted-pre-publication-current"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "package_visible": {
      "const": false
    },
    "authority_id": {
      "const": "MIR4-target-registry-v2"
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "semantic_reads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "semantic_writes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "target_dispositions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "digest_classes": {
      "type": "object",
      "required": [
        "semantic",
        "authority",
        "qualification"
      ],
      "properties": {
        "semantic": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "required": [
        "from",
        "to",
        "state"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rollback": {
      "type": "object",
      "required": [
        "strategy",
        "permitted_until"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "permitted_until": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "parity_test": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sunset_condition": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "code_name",
        "code_type",
        "code_width",
        "target_count",
        "v1_disposition",
        "targets"
      ],
      "properties": {
        "code_name": {
          "const": "distribution_target_code"
        },
        "code_type": {
          "const": "three-digit-decimal-string"
        },
        "code_width": {
          "const": 3
        },
        "target_count": {
          "const": 17
        },
        "v1_disposition": {
          "const": "historical-evidence-only-non-executable"
        },
        "targets": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": {
            "type": "object",
            "required": [
              "id",
              "factorio",
              "distribution_target_code",
              "support_tier",
              "disposition",
              "release_blocking",
              "mir3_predecessor"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^factorio-(?:2\\.[01]|1\\.[01]|0\\.(?:1[0-8]|[6-9]))$"
              },
              "factorio": {
                "type": "string",
                "pattern": "^(?:2\\.[01]|1\\.[01]|0\\.(?:1[0-8]|[6-9]))$"
              },
              "distribution_target_code": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              },
              "support_tier": {
                "enum": [
                  "current",
                  "maintained",
                  "lts",
                  "historical",
                  "museum"
                ]
              },
              "disposition": {
                "enum": [
                  "bootstrap-mandatory",
                  "bootstrap-conditional",
                  "deferred-bridge",
                  "deferred-evolved",
                  "deferred-museum"
                ]
              },
              "release_blocking": {
                "type": "boolean"
              },
              "mir3_predecessor": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(?:3\\.2\\.10|2\\.5\\.9|1\\.[3-9]\\.9)$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
