{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://more-infinite-research.invalid/schemas/mir430-named-startup-stress-profile-v1.schema.json",
  "title": "MIR 4.3.0 pinned available startup selection, not native qualification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","kind","id","target","status","engine","mods","archive_pins","builtin_pins","claim_scope"],
  "properties": {
    "schema": {"const":1},
    "kind": {"const":"MIR430NamedStartupStressProfileV1"},
    "id": {"enum":["f200-galore-space-age","f200-bob-angel","f200-omni-bob-angel-46"]},
    "target": {"const":"f200"},
    "status": {"const":"acquired-exact-selection-not-native-qualified"},
    "engine": {"type":"object","additionalProperties":false,"required":["version","sha256"],"properties":{"version":{"const":"2.0.77"},"sha256":{"$ref":"#/$defs/sha256"}}},
    "mods": {"type":"array","minItems":1,"maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["name","version","enabled"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","pattern":"^[0-9]+[.][0-9]+[.][0-9]+$"},"enabled":{"const":true}}}},
    "archive_pins": {"type":"array","maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["name","version","filename","bytes","sha256"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"filename":{"type":"string","pattern":"^[A-Za-z0-9._-]+[.]zip$"},"bytes":{"type":"integer","minimum":1},"sha256":{"$ref":"#/$defs/sha256"}}}},
    "builtin_pins": {"type":"array","maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["name","version","info_sha256"],"properties":{"name":{"enum":["base","space-age","quality","elevated-rails"]},"version":{"const":"2.0.77"},"info_sha256":{"$ref":"#/$defs/sha256"}}}},
    "claim_scope": {"const":"specified-available-inputs-not-reporter-313-mod-environment"}
  },
  "$defs": {"sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"}}
}
