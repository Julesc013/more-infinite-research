{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.more-infinite-research.invalid/distribution/mir4-shadow-source-model-proof-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "status", "baseline_record_sha256", "algorithm", "future_authorities", "layers", "bindings", "target_overlays", "classification_counts", "declaration_order_probe_sha256", "invariants", "transition_gate", "record_sha256"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "MIR4ShadowSourceModelProofV1"},
    "status": {"const": "passed-semantic-shadow-model-no-editable-source-no-cutover"},
    "baseline_record_sha256": {"const": "A9CFA8C4F8E799BD1B543EB8F2EC7DACF136730A098CC71D8206A9F83AB6AB8A"},
    "algorithm": {"const": "semantic-common-family-target-overlay-and-omission-model-v1"},
    "future_authorities": {"type": "object", "additionalProperties": false, "required": ["canonical_mod_source", "target_registry", "target_support_policy", "target_overlays", "target_materializer"], "properties": {"canonical_mod_source": {"const": "src/mod"}, "target_registry": {"const": "targets/registry.json"}, "target_support_policy": {"const": "targets/support-policy.json"}, "target_overlays": {"const": "targets/<target>/overlay.json"}, "target_materializer": {"const": "tools/mir/application/package/TargetMaterializer.ps1"}}},
    "layers": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["id", "source_target", "target_scope", "entry_count"], "properties": {"id": {"pattern": "^(?:common|families[.](?:modern|legacy)|targets[.]f(?:210|200|110|100))$"}, "source_target": {"enum": ["f210", "f200", "f110", "f100"]}, "target_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["f210", "f200", "f110", "f100"]}}, "entry_count": {"type": "integer", "minimum": 1}}}},
    "bindings": {"type": "array", "minItems": 406, "maxItems": 406, "items": {"$ref": "#/$defs/binding"}},
    "target_overlays": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["target", "family", "authority", "base_layers", "operation_counts", "operations"], "properties": {"target": {"enum": ["f210", "f200", "f110", "f100"]}, "family": {"enum": ["modern", "legacy"]}, "authority": {"pattern": "^targets/f(?:210|200|110|100)/overlay[.]json$"}, "base_layers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}, "operation_counts": {"type": "object", "additionalProperties": false, "required": ["add", "replace", "omit", "generate"], "properties": {"add": {"type": "integer", "minimum": 0}, "replace": {"const": 0}, "omit": {"type": "integer", "minimum": 0}, "generate": {"type": "integer", "minimum": 0}}}, "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}}}},
    "classification_counts": {"type": "object", "additionalProperties": false, "required": ["common-semantic-source", "common-asset-locale", "generated-metadata", "generated-lifecycle-entrypoint", "target-overlay", "target-replacement", "target-omission", "target-compatibility-shim", "migration", "package-documentation"], "properties": {"common-semantic-source": {"type": "integer", "minimum": 1}, "common-asset-locale": {"type": "integer", "minimum": 1}, "generated-metadata": {"const": 4}, "generated-lifecycle-entrypoint": {"const": 5}, "target-overlay": {"type": "integer", "minimum": 1}, "target-replacement": {"type": "integer", "minimum": 1}, "target-omission": {"type": "integer", "minimum": 1}, "target-compatibility-shim": {"type": "integer", "minimum": 1}, "migration": {"const": 2}, "package-documentation": {"const": 8}}},
    "declaration_order_probe_sha256": {"$ref": "#/$defs/sha256"},
    "invariants": {"type": "object", "additionalProperties": false, "required": ["all_paths_classified", "no_path_collision", "no_unowned_path", "declaration_order_independent", "no_target_policy_in_common_domain_code", "historical_archives_are_comparison_fixtures_only", "package_source_unchanged", "current_writer_unchanged", "runtime_replay_required_before_cutover"], "properties": {"all_paths_classified": {"const": true}, "no_path_collision": {"const": true}, "no_unowned_path": {"const": true}, "declaration_order_independent": {"const": true}, "no_target_policy_in_common_domain_code": {"const": true}, "historical_archives_are_comparison_fixtures_only": {"const": true}, "package_source_unchanged": {"const": true}, "current_writer_unchanged": {"const": true}, "runtime_replay_required_before_cutover": {"const": true}}},
    "transition_gate": {"$ref": "#/$defs/falseTransitions"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "semanticClass": {"enum": ["common-semantic-source", "common-asset-locale", "generated-metadata", "generated-lifecycle-entrypoint", "target-overlay", "target-replacement", "target-omission", "target-compatibility-shim", "migration", "package-documentation"]},
    "binding": {"type": "object", "additionalProperties": false, "required": ["layer", "target_scope", "path", "semantic_class", "historical_comparison_authority", "future_editable_authority", "materialization", "bytes", "sha256", "proof_obligations"], "properties": {"layer": {"type": "string"}, "target_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["f210", "f200", "f110", "f100"]}}, "path": {"type": "string", "minLength": 1}, "semantic_class": {"$ref": "#/$defs/semanticClass"}, "historical_comparison_authority": {"type": "string", "pattern": "^archive:f(?:210|200|110|100):"}, "future_editable_authority": {"type": "string", "minLength": 1}, "materialization": {"enum": ["copy-exact-bytes", "decode-base64-v1", "generate"]}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}, "proof_obligations": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["path", "operation", "semantic_class", "source_authority", "reason", "capability_disposition", "expected_sha256", "proof_obligations"], "properties": {"path": {"type": "string", "minLength": 1}, "operation": {"enum": ["add", "replace", "omit", "generate"]}, "semantic_class": {"$ref": "#/$defs/semanticClass"}, "source_authority": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "capability_disposition": {"enum": ["included-for-target", "omitted-by-target-profile"]}, "expected_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "proof_obligations": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}}}},
    "falseTransitions": {"type": "object", "additionalProperties": false, "required": ["source_move", "editable_source", "package_cutover", "old_writer_retirement", "tagging", "signing", "sealing", "publication"], "properties": {"source_move": {"const": false}, "editable_source": {"const": false}, "package_cutover": {"const": false}, "old_writer_retirement": {"const": false}, "tagging": {"const": false}, "signing": {"const": false}, "sealing": {"const": false}, "publication": {"const": false}}}
  }
}
