-- This template is rendered only by the private historical playtest
-- materializer.  The target identity is fixed in the package because these
-- engines do not expose one uniform runtime active-mods API.

local function normalize_line(version)
  if version == nil then return nil end
  local line = tostring(version):match("^(%d+%.%d+)")
  if line == "@@FACTORIO_LINE@@" then return line end
  error("MIR historical target profile requires base @@FACTORIO_LINE@@, got " .. tostring(version) .. ".", 3)
end

local function current_factorio_line()
  if type(mods) == "table" then return normalize_line(mods.base) end
  return "@@FACTORIO_LINE@@"
end

