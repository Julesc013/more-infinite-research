flowchart TB
  accTitle: Factorio startup: all mods, ordered rounds
  accDescr: Every round runs across active mods in dependency order. A dependent extension can run after MIR final-fixes; data API operations therefore happen when called.
  subgraph group_A["GAME STARTUP"]
    a["Engine + ordered active mod bytes"]:::data
    s["settings.lua → settings-updates.lua<br/>→ settings-final-fixes.lua<br/>ALL MODS in each round"]:::engine
    v["Setting prototypes finalized<br/>Configured startup values loaded"]:::engine
    d["data.lua<br/>ALL MODS"]:::engine
    u["data-updates.lua<br/>ALL MODS"]:::engine
    f["data-final-fixes.lua<br/>ALL MODS"]:::engine
    g["MIR or caller invokes Generator<br/>Only at its declared suitable round"]:::generator
    n["Validate prototypes and assets<br/>Discard startup Lua state → menu"]:::engine
  end
  subgraph group_B["AFTER THE MENU"]
    m["Create or load a save"]:::engine
    c["Parse control.lua and run<br/>applicable save lifecycle hooks"]:::process
    r["Gameplay events and native simulation"]:::engine
  end
  a --> s
  s --> v
  v --> d
  d --> u
  u --> f
  d -.->|"as needed"| g
  u -.->|"as needed"| g
  f -.->|"as needed"| g
  f --> n
  n --> m
  m --> c
  c --> r
