%% Generated from the diagram catalogue; design, not an execution trace.
flowchart TB
  accTitle: The whole mod: three engine lifetimes
  accDescr: Settings define configuration; data-stage code creates native prototypes; runtime handles only non-native behavior, caps and presentation. There is no runtime Generator.
  subgraph group_SET["SETTINGS STAGE"]
    s1["Lightweight identity and defaults"]:::data
    s2["Declare native setting prototypes"]:::process
    s3["Factorio reads configured values"]:::engine
  end
  subgraph group_DATA["PROTOTYPE STAGE"]
    d1["Authored research + known compatibility"]:::data
    d2["Resolve effective startup values"]:::process
    d3["GENERATOR<br/>Build owned tables; local preflight"]:::generator
    d4["Optional overrides<br/>Caps / modules / recycling"]:::optional
    d5["Native prototypes<br/>Factorio validates final result"]:::engine
    patch["Known native-owner patch<br/>Exact preconditions; preserve other fields"]:::process
    api["External data API<br/>Immediate bounded call"]:::api
  end
  subgraph group_RUN["SAVE / RUNTIME STAGE"]
    r1["Native research and effects<br/>Managed by Factorio"]:::engine
    r2["Save migrations and cap/state rules"]:::process
    r3["Scripted effects<br/>Relevant events / fixed tick work"]:::optional
    r4["Research Library + read-only API<br/>Requested views and queries"]:::api
  end
  s1 --> s2
  s2 --> s3
  s3 -->|"startup values"| d2
  d1 --> d2
  d2 --> d3
  d3 -->|"new research"| d5
  d4 --> d5
  d5 -->|"native prototypes only"| r1
  r1 -->|"load / configuration hooks"| r2
  r2 -->|"initialize or reconcile"| r3
  r1 -->|"native state"| r4
  r3 -.->|"bounded observations"| r4
  d2 -->|"enabled override values"| d4
  d1 -->|"approved owner path"| patch
  patch -->|"declared fields only"| d5
  api -->|"native-shaped family"| d3
