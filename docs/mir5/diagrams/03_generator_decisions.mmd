flowchart TB
  accTitle: Generator: decide, build, preflight, publish
  accDescr: Released identities never enter a generic skip branch. The data stage cannot ask whether a particular save researched them; continuity policy must already be authored. This depicts creation; named native-owner patches are a separate checked path.
  subgraph group_IN["AUTHORED INPUT"]
    a["Selected family + effective values<br/>+ current relevant prototypes"]:::data
    b{"Applicable and enabled?"}:::decision
    h{"Released identity obligation?"}:::decision
    p["Use accepted preserve/disable policy<br/>No save inspection in data stage"]:::data
  end
  subgraph group_GEN["LOCAL FAMILY CONSTRUCTION"]
    c["Build detached native tables<br/>Existing cost/effect semantics"]:::generator
    l["Local name map<br/>Includes family forward references"]:::process
    v{"All consumed values, references,<br/>IDs and local cycles valid?"}:::decision
    w["Publish the preflighted new family once"]:::generator
  end
  subgraph group_OUT["EXPLICIT OUTCOME"]
    o["Omit NEW optional contribution<br/>Expected absence reason"]:::optional
    u["No accepted continuity policy<br/>Block affected upgrade claim"]:::error
    e["Contract error before MIR writes<br/>No swallow-and-continue"]:::error
    f["Factorio final validation<br/>Later mods may still change prototypes"]:::engine
  end
