%% Generated from the diagram catalogue; design, not an execution trace.
flowchart TB
  accTitle: Verification: cheap first, exact native evidence later
  accDescr: Select affected tests from real consumed inputs. A cached result retains its original identity; changed or uncertain shared inputs widen coverage. Product cases are still not run.
  subgraph group_A["CHANGE CONTRACT"]
    c["Observable outcome + permitted files<br/>Independent expected behavior"]:::data
    i["Affected input/dependency selection<br/>Uncertainty widens coverage"]:::process
  end
  subgraph group_T["CHECK LADDER"]
    t0["0 — syntax, imports, IDs, package, links"]:::process
    t1["1 — pure behavior / ownership<br/>properties / targeted mutations"]:::process
    t2["2 — native affected research<br/>actual physical effect"]:::engine
    t3["3 — saves / combined mods / API<br/>real clients and lifecycle"]:::engine
    t4["4 — frozen full-product candidate<br/>performance and stress"]:::engine
  end
  subgraph group_R["RESULT"]
    f["Failure: retain reproducer<br/>Fix implementation or review contract<br/>Never silently lower oracle"]:::error
    p["Exact scoped evidence<br/>Not universal perfection"]:::success
  end
  c --> i
  i --> t0
  t0 -->|"when affected"| t1
  t1 -->|"gameplay change"| t2
  t2 -->|"continuity / interoperability"| t3
  t3 -->|"coherent release candidate"| t4
  t0 -.->|"fail"| f
  t1 -.->|"fail"| f
  t2 -.->|"fail"| f
  t3 -.->|"fail"| f
  t4 -.->|"fail"| f
  t4 -->|"required scope passes"| p
  classDef process fill:#FFFFFF,stroke:#52657D,color:#182B45,stroke-width:1.3px
  classDef data fill:#EEF4FD,stroke:#5B7CA7,color:#17365A,stroke-width:1.3px
  classDef engine fill:#EAF3FC,stroke:#3974A9,color:#163F64,stroke-width:1.3px
  classDef generator fill:#E1F3EE,stroke:#16856F,color:#0C5649,stroke-width:1.3px
  classDef optional fill:#FFF4DF,stroke:#B2822B,color:#73541B,stroke-width:1.3px
  classDef api fill:#F0EAFB,stroke:#8063B0,color:#4E3977,stroke-width:1.3px
  classDef error fill:#FCEEEF,stroke:#B95762,color:#7A2A37,stroke-width:1.3px
  classDef success fill:#E5F3EA,stroke:#4E8A63,color:#2D563A,stroke-width:1.3px
  classDef decision fill:#F5F1E8,stroke:#9F8965,color:#584A34,stroke-width:1.3px
